def _domain_labels(host: str) -> None:
    try:
        ascii_host = host.encode("idna").decode("ascii")
    except UnicodeError as exc:
        raise ValueError("Enter a valid domain.") from exc
    labels = ascii_host.rstrip(".").split(".")
    if (
        not ascii_host
        or len(ascii_host) > 253
        or any(
            not label
            or len(label) > 63
            or label.startswith("-")
            or label.endswith("-")
            or not all(ch.isalnum() or ch == "-" for ch in label)
            for label in labels
        )
    ):
        raise ValueError("Enter a valid domain.")


def _existing_directory(value: str) -> str:
    path = Path(value).expanduser()
    if path.is_symlink() or not path.is_dir():
        raise ValueError("Select an existing directory, not a symbolic link.")
    return str(path)


def _regular_file(value: str) -> str:
    path = Path(value).expanduser()
    if path.is_symlink() or not path.is_file():
        raise ValueError("Select an existing regular file, not a symbolic link.")
    return str(path)


def normalize_catalog_target(mode: str, target: str) -> str:
    value = target.strip()
    if mode in {"launch", "local"}:
        return ""
    if not value:
        raise ValueError("Enter a target first.")
    if value.startswith("-"):
        raise ValueError("A target cannot start with an option.")
    if mode == "url":
        return normalize_web_target("WhatWeb Fingerprint", value)
    if mode == "host":
        return normalize_web_target("Nmap Quick Scan", value)
    if mode == "domain":
        if "://" in value or "/" in value or any(ch.isspace() for ch in value):
            raise ValueError("Enter a domain, not a URL or a path.")
        _domain_labels(value)
        return value
    if mode == "identity":
        if any(ch.isspace() for ch in value):
            raise ValueError("Enter one identity, such as user@domain.example.")
        return value
    if mode == "file":
        return _regular_file(value)
    if mode == "directory":
        return _existing_directory(value)
    if mode == "two-files":
        try:
            parts = shlex.split(value)
        except ValueError as exc:
            raise ValueError(f"Invalid file quoting: {exc}") from exc
        if len(parts) != 2:
            raise ValueError("Enter the rules file and the target file.")
        return value
    raise ValueError(f"Unknown target mode: {mode}")


def build_catalog_command(specs: dict, name: str, target: str, wordlist: str = WEB_WORDLIST) -> list[str]:
    spec = specs.get(name)
    if spec is None:
        raise ValueError(f"Unknown tool: {name}")
    mode = spec["mode"]
    if spec.get("replace"):
        return list(spec["argv"])
    if mode in {"launch", "local"}:
        return [spec["command"], *spec["argv"]]
    if mode == "two-files":
        parts = shlex.split(target.strip())
        if len(parts) != 2:
            raise ValueError("Enter the rules file and the target file.")
        rules, subject = _regular_file(parts[0]), _regular_file(parts[1])
        slots = {"{rules}": rules, "{target}": subject}
        return [spec["command"], *[slots.get(part, part) for part in spec["argv"]]]
    value = normalize_catalog_target(mode, target)
    fuzz = value if "FUZZ" in value else (value + "FUZZ" if value.endswith("/") else value + "/FUZZ")
    rendered = []
    for part in spec["argv"]:
        if part == "{target}":
            rendered.append(value)
        elif part == "{fuzz}":
            rendered.append(fuzz)
        elif part == "{wordlist}":
            if not wordlist.strip():
                raise ValueError("Select a wordlist before starting this tool.")
            rendered.append(wordlist)
        else:
            rendered.append(part)
    return [spec["command"], *rendered]


def require_catalog_tool(specs: dict, name: str, wordlist: str = WEB_WORDLIST) -> None:
    spec = specs.get(name)
    if spec is None:
        raise ValueError(f"Unknown tool: {name}")
    if shutil.which(spec["command"]) is None:
        raise FileNotFoundError(f"{spec['command']} is not installed in this TraceOS image.")
    if "{wordlist}" in spec["argv"] and not Path(wordlist).is_file():
        raise FileNotFoundError(f"Bundled wordlist is missing: {wordlist}")


def action_result_matches(
    active_action_id: uuid.UUID | None,
    result: ActionResult,
) -> bool:
    """Accept a result only when it belongs to the action currently shown."""
    return active_action_id is not None and result.action_id == active_action_id


def format_basic_lookup_result(result: ActionResult) -> str:
    """Render one bounded, structured lookup result for the GUI."""
    lines = [
        f"[TraceOS] Action ID: {result.action_id}",
        f"Tool: {result.tool}",
        f"State: {result.state}",
        f"Exit code: {result.exit_code if result.exit_code is not None else 'none'}",
        f"Termination: {result.termination_reason or 'none'}",
        f"Error: {result.error_class or 'none'}",
    ]
    parsed = result.parsed_result
    if isinstance(parsed, dict):
        labels = (
            ("status", "Status"),
            ("answer_count", "Answer count"),
            ("rcode", "Rcode"),
            ("field_count", "Field count"),
            ("line_count", "Line count"),
        )
        lines.append("")
        lines.append("STRUCTURED RESULT")
        for key, label in labels:
            if key in parsed:
                lines.append(f"{label}: {parsed[key]}")

    lines.extend(
        [
            "",
            "STDOUT (bounded preview)",
            result.stdout_preview.rstrip() or "(empty)",
            f"[bytes={result.stdout_byte_count} truncated={str(result.stdout_truncated).lower()} sha256={result.stdout_sha256}]",
            "",
            "STDERR (bounded preview)",
            result.stderr_preview.rstrip() or "(empty)",
            f"[bytes={result.stderr_byte_count} truncated={str(result.stderr_truncated).lower()} sha256={result.stderr_sha256}]",
        ]
    )
    return "\n".join(lines) + "\n"


class TraceOSApp:
    def __init__(self, root: tk.Tk, welcome: bool = False, start_page: str = "dashboard") -> None:
        self.root = root
        self.root.title("TraceOS Control Centre")
        screen_w = self.root.winfo_screenwidth()
        screen_h = self.root.winfo_screenheight()
        width = min(1360, max(900, screen_w - 40))
        height = min(860, max(600, screen_h - 70))
        self.root.geometry(f"{width}x{height}")
        self.root.minsize(min(1080, width), min(720, height))
        self.root.configure(bg=BG)
        self.root.option_add("*Font", "{DejaVu Sans} 10")
        try:
            self.root.state("zoomed")
        except tk.TclError:
            pass
        self.root.after(1800, self._write_ready_marker)
        self.root.protocol("WM_DELETE_WINDOW", self.root.destroy)

        self._trace_nonce = uuid.uuid4().hex
        self._trace_attempt = 0
        self._new_case_attempt_pending = False

        # Smoke shortcuts exercise the same pages linked from the sidebar.
        self.root.bind_all("<Control-Shift-O>", self._osint_shortcut)
        self.root.bind_all("<Control-Shift-N>", self._new_case_shortcut)
        self.root.bind_all("<Control-Shift-W>", self._web_testing_shortcut)
        self.root.bind_all("<Control-Shift-I>", self._image_shortcut)
        self.root.bind_all("<Control-Shift-F1>", lambda event: self._open_page_shortcut(event, self.dashboard, "OVERVIEW_PAGE_RENDERED"))
        self.root.bind_all("<Control-Shift-F2>", lambda event: self._open_page_shortcut(event, self.cases_page, "CASES_PAGE_RENDERED"))
        self.root.bind_all("<Control-Shift-F3>", lambda event: self._open_page_shortcut(event, self.evidence, "EVIDENCE_PAGE_RENDERED"))
        self.root.bind_all("<Control-Shift-F4>", lambda event: self._open_page_shortcut(event, self.network, "NETWORK_PAGE_RENDERED"))
        self.root.bind_all("<Control-Shift-F5>", lambda event: self._open_page_shortcut(event, self.tools_home, "TOOLS_PAGE_RENDERED"))
        self.root.bind_all("<Control-Shift-F6>", lambda event: self._open_page_shortcut(event, self.ai_page, "AI_PAGE_RENDERED"))
        self.root.bind_all("<Control-Shift-F7>", lambda event: self._open_page_shortcut(event, self.settings_page, "SETTINGS_PAGE_RENDERED"))

        self.active_process: subprocess.Popen[str] | None = None
        self.active_job_token: str | None = None
        self.active_job_label: str | None = None
        self.active_job_kind: str | None = None
        self.active_job_attempt: int | None = None
        self.active_action_id: uuid.UUID | None = None
        self.active_action_cancel: threading.Event | None = None
        self.action_queue: queue.Queue[ActionResult] = queue.Queue()
        self.output_queue: queue.Queue[tuple[str, str | None]] = queue.Queue()
        self.job_output = ""
        self.output_widget: tk.Text | None = None
        self.welcome = welcome

        self.setup_styles()
        self.build_shell()

        pages = {
            "dashboard": self.dashboard,
            "evidence": self.evidence,
            "network": self.network,
            "web": self.web_testing,
            "assessment": self.assessment,
            "engagement": self.engagement,
            "osint": self.osint,
            "defence": self.defence,
            "images": self.image_osint,
            "reports": self.reports,
            "timeline": self.timeline,
            "tools": self.tools_home,
            "doctor": self.doctor_page,
        }
        pages.get(start_page, self.dashboard)()
        self._trace_diag("CONTROL_CENTRE_SESSION_READY")

    def _trace_active_window(self) -> str:
        result = capture(["xprop", "-root", "_NET_ACTIVE_WINDOW"], timeout=2)
        if not result or result.returncode != 0:
            return "unavailable"
        value = " ".join(result.stdout.strip().split())
        return value or "unavailable"

    def _trace_focus(self) -> str:
        try:
            widget = self.root.focus_get()
            if widget is None:
                return "none"
            return f"{widget.winfo_class()}:{widget}"
        except tk.TclError:
            return "unavailable"

    def _trace_diag(self, stage: str, **fields: object) -> None:
        parts = [
            f"stage={stage}",
            f"nonce={self._trace_nonce}",
            f"pid={os.getpid()}",
            f"uid={os.getuid()}",
            f"attempt={self._trace_attempt}",
        ]
        for key, value in fields.items():
            safe = " ".join(str(value).replace("\n", " ").replace("\r", " ").split())
            parts.append(f"{key}={safe}")
        line = f"[TraceOS] UI_DIAG {time.strftime('%Y-%m-%dT%H:%M:%S%z')} " + " ".join(parts)

        log_path = Path.home() / ".cache" / "traceos" / "control-centre-ui.log"
        try:
            log_path.parent.mkdir(parents=True, exist_ok=True)
            with log_path.open("a", encoding="utf-8") as handle:
                handle.write(line + "\n")
        except OSError:
            pass

        # Best-effort CI evidence channel. Failure to write to the guest serial
        # device must never break the normal GUI or user-facing interaction.
        try:
            fd = os.open("/dev/ttyS0", os.O_WRONLY | os.O_NOCTTY | os.O_NONBLOCK)
            try:
                os.write(fd, (line + "\n").encode("utf-8"))
            finally:
                os.close(fd)
        except OSError:
            pass

        print(line, file=sys.stderr, flush=True)

    def _new_case_shortcut(self, event: tk.Event) -> str:
        self._trace_attempt += 1
        self._new_case_attempt_pending = True
        try:
            widget = self.root.focus_get()
            focus_class = widget.winfo_class() if widget is not None else "none"
        except tk.TclError:
            focus_class = "unavailable"
        self._trace_diag(
            "NEW_CASE_INPUT_RECEIVED",
            keysym=getattr(event, "keysym", "unknown"),
            state=getattr(event, "state", "unknown"),
            focus_class=focus_class,
        )
        self.new_case()
        return "break"

    def _open_page_shortcut(self, _event: tk.Event, page, stage: str) -> str:
        page()
        self.root.update_idletasks()
        self._trace_diag(stage)
        return "break"

    def _image_shortcut(self, event: tk.Event) -> str:
        self._trace_attempt += 1
        self._trace_diag("IMAGE_PAGE_SHORTCUT_RECEIVED", attempt=self._trace_attempt)
        self.image_osint()
        return "break"
    def _osint_shortcut(self, event: tk.Event) -> str:
        self._trace_diag(
            "shortcut-received",
            keysym=getattr(event, "keysym", "unknown"),
            state=getattr(event, "state", "unknown"),
            focus=self._trace_focus(),
            active_window=self._trace_active_window(),
        )
        self._trace_diag("callback-entered", callback="osint")
        try:
            self.osint()
        except Exception as exc:
            self._trace_diag(
                "callback-exception",
                callback="osint",
                exc_type=type(exc).__name__,
                message=str(exc),
            )
            raise
        self._trace_diag("callback-complete", callback="osint")
        return "break"

    def _web_testing_shortcut(self, event: tk.Event) -> str:
        try:
            self.web_testing()
        except Exception as exc:
            self._trace_diag(
                "WEB_TESTING_PAGE_FAILED",
                exc_type=type(exc).__name__,
                message=str(exc),
            )
            raise
        # Flush drawing without re-entering the key handler. root.update()
        # can nest the event loop here and never reach the smoke marker.
        self.root.update_idletasks()
        self._trace_diag("WEB_TESTING_PAGE_RENDERED", page="web")
        return "break"

    def _image_osint_shortcut(self, event: tk.Event) -> str:
        self.image_osint()
        self.root.update_idletasks()
        self._trace_diag("IMAGE_OSINT_PAGE_RENDERED", page="images")
        return "break"

    def _write_ready_marker(self) -> None:
        marker = Path("/tmp/traceos-control-centre.ready")
        try:
            self.root.update_idletasks()
            marker.write_text("TRACEOS_CONTROL_CENTRE_READY\\n", encoding="utf-8")
        except OSError:
            pass

    def refresh_case_context(self) -> None:
        self.refresh_case_header()
        self._trace_diag("case-context-refreshed")

    def refresh_case_header(self) -> None:
        if not hasattr(self, "header_case"):
            return
        try:
            record = CASE_STORE.current()
        except CaseError as exc:
            self.header_case.configure(
                text=f"CASE ERROR  •  {exc}",
                fg=DANGER,
            )
            return
        if record is None:
            self.header_case.configure(
                text="NO ACTIVE CASE  •  ~/Cases IS EPHEMERAL IN AMNESIC LIVE SESSIONS",
                fg=WARN,
            )
            return
        identifier = "LEGACY" if record.legacy else record.case_id[:8]
        self.header_case.configure(
            text=f"CASE  •  {record.title}  •  {identifier}",
            fg=GOOD,
        )

    def setup_styles(self) -> None:
        style = ttk.Style(self.root)
        try:
            style.theme_use("clam")
        except tk.TclError:
            pass
        style.configure(
            "Trace.TCombobox",
            fieldbackground="#0e2a4e",
            background=CARD2,
            foreground=TEXT,
            bordercolor=BORDER,
            arrowcolor=ACCENT,
            padding=7,
        )
        style.map(
            "Trace.TCombobox",
            fieldbackground=[("readonly", "#0e2a4e")],
            foreground=[("readonly", TEXT)],
        )
        style.configure(
            "Trace.Treeview",
            background="#0e2a4e",
            fieldbackground="#0e2a4e",
            foreground=TEXT,
            rowheight=30,
            borderwidth=0,
            relief="flat",
        )
        style.map(
            "Trace.Treeview",
            background=[("selected", CARD3)],
            foreground=[("selected", ACCENT)],
        )
        style.configure(
            "Trace.Treeview.Heading",
            background=PANEL,
            foreground=MUTED,
            relief="flat",
            borderwidth=0,
            font=("Sans", 9, "bold"),
        )

    def build_shell(self) -> None:
        header = tk.Frame(self.root, bg=PANEL)
        header.pack(fill="x", side="top")

        actions = tk.Frame(header, bg=PANEL)
        actions.pack(side="right", padx=(8, 12), pady=14)
        # Pack the actions first and at their natural width. The case label used
        # to sit in the same row and shrink the last button, clipping NEW CASE
        # to "New Cas" on a 1152-wide session.
        self.small_button(actions, "NEW CASE", self.new_case, side="left", primary=True)
        self.small_button(actions, "SELECT CASE", self.select_case, side="left")
        self.small_button(actions, "REFRESH CASE", self.refresh_case_context, side="left")
        self.small_button(actions, "QUICK SHADE", self.quick_shade, side="left")

        logo_path = Path("/usr/share/traceos/traceos-logo.png")
        if logo_path.exists():
            try:
                self.logo = tk.PhotoImage(file=str(logo_path))
                if self.logo.width() > 52:
                    factor = max(1, self.logo.width() // 48)
                    self.logo = self.logo.subsample(factor)
                tk.Label(header, image=self.logo, bg=PANEL).pack(side="left", padx=(18, 10))
            except tk.TclError:
                pass

        brand = tk.Frame(header, bg=PANEL)
        brand.pack(side="left", fill="y", pady=12)
        tk.Label(
            brand, text="TRACEOS", bg=PANEL, fg=TEXT,
            font=("Sans", 21, "bold")
        ).pack(anchor="w")
        tk.Label(
            brand, text="Digital Investigation Workstation",
            bg=PANEL, fg=MUTED, font=("Sans", 9)
        ).pack(anchor="w")

        self.header_case = tk.Label(
            brand, text="LOCAL-FIRST  •  NO BUILT-IN TELEMETRY",
            bg=PANEL, fg=GOOD, font=("Sans", 8, "bold"), anchor="w"
        )
        self.header_case.pack(anchor="w", pady=(4, 0))
        self.refresh_case_header()

        body = tk.Frame(self.root, bg=BG)
        body.pack(fill="both", expand=True)

        self.sidebar = tk.Frame(body, bg=PANEL, width=220)
        self.sidebar.pack(side="left", fill="y")
        self.sidebar.pack_propagate(False)
        self._nav_buttons = {}
        nav_canvas = tk.Canvas(self.sidebar, bg=PANEL, highlightthickness=0, bd=0)
        nav_scroll = tk.Scrollbar(self.sidebar, orient="vertical", command=nav_canvas.yview)
        self.nav_host = tk.Frame(nav_canvas, bg=PANEL)
        self.nav_host.bind(
            "<Configure>",
            lambda _event: nav_canvas.configure(scrollregion=nav_canvas.bbox("all")),
        )
        nav_window = nav_canvas.create_window((0, 0), window=self.nav_host, anchor="nw")
        nav_canvas.bind(
            "<Configure>",
            lambda event: nav_canvas.itemconfigure(nav_window, width=event.width),
        )
        nav_canvas.configure(yscrollcommand=nav_scroll.set)
        nav_canvas.pack(side="left", fill="both", expand=True)
        nav_scroll.pack(side="right", fill="y")

        def _nav_scroll(event: tk.Event) -> None:
            widget = self.root.winfo_containing(event.x_root, event.y_root)
            if widget is None or not str(widget).startswith(str(self.sidebar)):
                return
            if getattr(event, "num", None) == 4:
                nav_canvas.yview_scroll(-3, "units")
            elif getattr(event, "num", None) == 5:
                nav_canvas.yview_scroll(3, "units")

        self.root.bind_all("<Button-4>", _nav_scroll)
        self.root.bind_all("<Button-5>", _nav_scroll)

        tk.Label(
            self.nav_host, text="TRACEOS", bg=PANEL, fg=ACCENT,
            font=("Sans", 8, "bold")
        ).pack(anchor="w", padx=18, pady=(20, 7))

        for label, page in [
            ("Overview", self.dashboard),
            ("Cases", self.cases_page),
            ("Investigation", self.osint),
            ("Network", self.network),
            ("Tools", self.tools_home),
            ("AI Assistant", self.ai_page),
            ("Settings", self.settings_page),
        ]:
            self.nav_button(label, page)

        tk.Label(
            self.nav_host, text="WORKSPACE", bg=PANEL, fg=MUTED,
            font=("Sans", 8, "bold")
        ).pack(anchor="w", padx=18, pady=(16, 7))

        for label, page in [
            ("Web Testing", self.web_testing),
            ("Assessment", self.assessment),
            ("Credentials", self.credentials),
            ("Engagement", self.engagement),
            ("Defence", self.defence),
            ("Image OSINT", self.image_osint),
            ("Reports", self.reports),
            ("Timeline", self.timeline),
            ("Terminal", lambda: self.open_terminal(["bash"], "TraceOS Terminal")),
            ("Trace Console", lambda: self.open_terminal([TRACE, "status"], "TraceOS Console")),
            ("Demo Lab", lambda: self.open_terminal([TRACE, "demo"], "TraceOS Demo Lab")),
        ]:
            self.nav_button(label, page)

        tk.Label(
            self.nav_host,
            text="TRACEOS 0.1.0\nLocal-first • user-invoked external actions",
            bg=PANEL, fg=MUTED, justify="left", font=("Sans", 8)
        ).pack(anchor="w", padx=18, pady=(25, 10))

        self.content = tk.Frame(body, bg=BG)
        self.content.pack(side="left", fill="both", expand=True)

        status = tk.Frame(self.root, bg=PANEL, height=30)
        status.pack(fill="x", side="bottom")
        status.pack_propagate(False)
        tk.Label(
            status,
            text="TRACEOS 0.1.0   •   LOCAL-FIRST   •   USER-INVOKED EXTERNAL ACTIONS   •   CASE DATA STAYS ON THIS MACHINE",
            bg=PANEL, fg=MUTED, font=("Sans", 8, "bold")
        ).pack(side="left", padx=18, pady=7)
        tk.Label(
            status, text="● READY", bg=PANEL, fg=GOOD,
            font=("Sans", 8, "bold")
        ).pack(side="right", padx=18, pady=7)

    def small_button(self, parent: tk.Widget, text: str, command, side: str = "left", primary: bool = False) -> None:
        bg = ACCENT if primary else CARD2
        fg = "#041016" if primary else TEXT
        tk.Button(
            parent, text=text, command=command, bg=bg, fg=fg,
            activebackground=ACCENT2 if not primary else ACCENT,
            activeforeground="#041016", relief="flat", bd=0,
            font=("Sans", 9, "bold"), padx=13, pady=7
        ).pack(side=side, padx=6, pady=0)

    def nav_button(self, text: str, command) -> None:
        button = tk.Button(
            self.nav_host, text=text, command=lambda: self._invoke_nav(text, command),
            anchor="w", bg=PANEL, fg=TEXT, activebackground=CARD2,
            activeforeground=ACCENT, relief="flat", bd=0,
            font=("Sans", 10), padx=18, pady=10
        )
        button.pack(fill="x")
        self._nav_buttons[text] = button

    def _invoke_nav(self, text: str, command) -> None:
        self.activate_nav(text)
        command()

    def activate_nav(self, text: str) -> None:
        if not hasattr(self, "_nav_buttons"):
            return
        for name, button in self._nav_buttons.items():
            selected = name == text
            button.configure(bg=CARD2 if selected else PANEL, fg=ACCENT if selected else TEXT)

    def clear(self) -> None:
        for widget in self.content.winfo_children():
            widget.destroy()
        self.output_widget = None

    def heading(self, kicker: str, title: str, subtitle: str) -> tk.Frame:
        self.clear()
        top = tk.Frame(self.content, bg=BG)
        top.pack(fill="x", padx=28, pady=(24, 8))
        tk.Label(top, text=kicker.upper(), bg=BG, fg=ACCENT, font=("Sans", 8, "bold")).pack(anchor="w")
        tk.Label(top, text=title, bg=BG, fg=TEXT, font=("Sans", 24, "bold")).pack(anchor="w", pady=(1, 0))
        tk.Label(top, text=subtitle, bg=BG, fg=MUTED, font=("Sans", 10)).pack(anchor="w", pady=(2, 0))
        return top

    def card(self, parent: tk.Widget, padx: int = 0, pady: int = 0, expand: bool = False) -> tk.Frame:
        box = tk.Frame(
            parent, bg=CARD, highlightthickness=1,
            highlightbackground=BORDER, bd=0
        )
        box.pack(fill="both" if expand else "x", expand=expand, padx=padx, pady=pady)
        return box

    def action_button(self, parent: tk.Widget, text: str, command, primary: bool = False) -> tk.Button:
        return tk.Button(
            parent, text=text, command=command,
            bg=ACCENT if primary else CARD2,
            fg="#041016" if primary else TEXT,
            activebackground=ACCENT2 if not primary else ACCENT,
            activeforeground="#041016",
            relief="flat", bd=0, font=("Sans", 9, "bold"),
            padx=13, pady=7
        )

    def set_output(self, parent: tk.Widget, height: int = 16) -> tk.Text:
        text = tk.Text(
            parent, bg="#07101c", fg=TEXT, insertbackground=ACCENT,
            selectbackground=CARD3, selectforeground=TEXT,
            relief="flat", bd=0, wrap="word", font=("Monospace", 9),
            height=height
        )
        text.pack(fill="both", expand=True, padx=14, pady=14)
        self.output_widget = text
        if self.job_output:
            text.insert("1.0", self.job_output)
        return text

    def set_text(self, widget: tk.Text, value: str) -> None:
        widget.configure(state="normal")
        widget.delete("1.0", "end")
        widget.insert("1.0", value)
        widget.configure(state="disabled")

    def open_terminal(self, args: list[str], title: str) -> None:
        try:
            subprocess.Popen(["xfce4-terminal", f"--title={title}", "--execute", *args])
        except OSError as exc:
            messagebox.showerror(title, str(exc), parent=self.root)

    def open_path(self, path: Path) -> None:
        if not path.exists():
            messagebox.showerror("TraceOS", f"Path not found:\n{path}", parent=self.root)
            return
        if shutil.which("xdg-open"):
            try:
                subprocess.Popen(["xdg-open", str(path)])
            except OSError as exc:
                messagebox.showerror("TraceOS", str(exc), parent=self.root)

    def quick_shade(self) -> None:
        try:
            subprocess.Popen(["/usr/local/bin/traceos-shade"])
        except OSError as exc:
            messagebox.showerror("TraceOS Quick Shade", str(exc), parent=self.root)

    def _action_worker(
        self,
        request,
        cancel_event: threading.Event,
    ) -> None:
        result = ActionRunner().execute(request, cancel_event=cancel_event)
        self.action_queue.put(result)

    def start_basic_lookup_action(self, tool_key: str, target: str) -> None:
        """Start a confirmed WHOIS/DNS lookup through the shared ActionRunner."""
        if self.active_action_id is not None or (self.active_process and self.active_process.poll() is None):
            messagebox.showinfo(
                "TraceOS",
                "A task is already running. Stop it before starting another.",
                parent=self.root,
            )
            return

        try:
            adapter = get_adapter(tool_key)
            normalized = adapter.validate_target(target)
        except (KeyError, ValueError) as exc:
            messagebox.showerror("OSINT", f"Invalid target: {exc}", parent=self.root)
            self._trace_diag(
                "ACTION_TARGET_VALIDATION_FAILED",
                tool=tool_key,
                reason=type(exc).__name__,
            )
            return

        if not messagebox.askyesno(
            f"Confirm {adapter.display_name} lookup",
            f"This will contact external network services for {normalized}.\n\nProceed only if you are authorized to perform this lookup against this target.",
            parent=self.root,
        ):
            self._trace_diag(
                "ACTION_AUTHORIZATION_CANCELLED",
                tool=tool_key,
                target_kind="domain_or_ip",
            )
            return

        try:
            request = create_basic_lookup_request(
                tool_key,
                normalized,
                authorization_state=CONFIRMED,
            )
        except (KeyError, ValueError) as exc:
            messagebox.showerror("OSINT", f"Unable to create action: {exc}", parent=self.root)
            self._trace_diag(
                "ACTION_REQUEST_FAILED",
                tool=tool_key,
                reason=type(exc).__name__,
            )
            return

        cancel_event = threading.Event()
        self.active_action_id = request.action_id
        self.active_action_cancel = cancel_event
        self.active_job_label = adapter.display_name
        self.active_job_kind = "action"
        self.active_job_attempt = None
        self.job_output = (
            f"[TraceOS] Action: {adapter.display_name}\n"
            f"Target: {shlex.quote(normalized)}\n"
            "Authorization: CONFIRMED\n"
            f"Action ID: {request.action_id}\n\n"
            "[TraceOS] Starting through ActionRunner...\n"
        )
        if self.output_widget:
            self.set_text(self.output_widget, self.job_output)
        self._trace_diag(
            "ACTION_STARTED",
            action_id=request.action_id,
            tool=tool_key,
            target_kind="domain_or_ip",
            state="STARTING",
        )

        threading.Thread(
            target=self._action_worker,
            args=(request, cancel_event),
            daemon=True,
            name=f"traceos-action-{str(request.action_id)[:8]}",
        ).start()
        self.root.after(50, self.poll_action_result)

    def poll_action_result(self) -> None:
        handled_current = False
        while True:
            try:
                result = self.action_queue.get_nowait()
            except queue.Empty:
                break

            if not action_result_matches(self.active_action_id, result):
                self._trace_diag(
                    "ACTION_RESULT_STALE_IGNORED",
                    action_id=result.action_id,
                    state=result.state,
                )
                continue

            handled_current = True
            self.job_output = format_basic_lookup_result(result)
            if self.output_widget and self.output_widget.winfo_exists():
                self.set_text(self.output_widget, self.job_output)
            self._trace_diag(
                "ACTION_RESULT_RENDERED",
                action_id=result.action_id,
                tool=result.tool,
                state=result.state,
                parsed="yes" if result.parsed_result is not None else "no",
                exit_code=result.exit_code if result.exit_code is not None else "none",
            )
            self.active_action_id = None
            self.active_action_cancel = None
            self.active_job_label = None
            self.active_job_kind = None
            self.active_job_attempt = None

        if not handled_current and self.active_action_id is not None:
            self.root.after(80, self.poll_action_result)


    def run_job(self, args: list[str], label: str = "TraceOS", *, kind: str | None = None, attempt: int | None = None) -> None:
        if self.active_action_id is not None:
            messagebox.showinfo("TraceOS", "A task is already running. Stop it before starting another.", parent=self.root)
            return
        if self.active_process and self.active_process.poll() is None:
            messagebox.showinfo("TraceOS", "A task is already running. Stop it before starting another.", parent=self.root)
            return
        self.active_job_label = label
        self.active_job_kind = kind
        self.active_job_attempt = attempt
        job_token = uuid.uuid4().hex
        self.active_job_token = job_token
        self.job_output = f"[TraceOS] Starting: {label}\n$ {' '.join(shlex.quote(x) for x in args)}\n\n"
        if self.output_widget:
            self.set_text(self.output_widget, self.job_output)
        try:
            process = subprocess.Popen(
                args,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
                bufsize=1,
                start_new_session=True,
            )
            self.active_process = process
            self._trace_diag(
                "TASK_STARTED",
                task=self.active_job_label or "unknown",
                kind=self.active_job_kind or "generic",
                pid=process.pid,
                attempt=self.active_job_attempt if self.active_job_attempt is not None else "none",
            )
            if self.active_job_kind == "image":
                self._trace_diag("IMAGE_CLI_STARTED", pid=process.pid, attempt=self.active_job_attempt or 0, image_attempt=self.active_job_attempt or 0)
        except OSError as exc:
            self.active_job_token = None
            self.active_process = None
            self.job_output += f"[TraceOS] Unable to start task: {exc}\n"
            if self.output_widget:
                self.set_text(self.output_widget, self.job_output)
            return

        def reader(task_process=process, token=job_token) -> None:
            if task_process.stdout:
                for line in task_process.stdout:
                    self.output_queue.put((token, line))
            self.output_queue.put((token, None))

        threading.Thread(target=reader, daemon=True).start()
        self.root.after(80, self.poll_job)

    def poll_job(self) -> None:
        finished = False
        while True:
            try:
                token, item = self.output_queue.get_nowait()
            except queue.Empty:
                break
            # Readers may finish after a later task has started. Never render
            # stale output or let an old sentinel finish the new task.
            if token != self.active_job_token:
                continue
            if item is None:
                finished = True
                continue
            self.job_output += item
            if len(self.job_output) > 50000:
                self.job_output = self.job_output[-50000:]
            if self.output_widget and self.output_widget.winfo_exists():
                self.output_widget.configure(state="normal")
                self.output_widget.delete("1.0", "end")
                self.output_widget.insert("1.0", self.job_output)
                self.output_widget.see("end")
                self.output_widget.configure(state="disabled")
        if finished and self.active_process is not None and self.active_process.poll() is None:
            # A child can close stdout before the launcher exits. Keep the
            # sentinel pending until the process is reaped so Stop still owns
            # the process handle and exit status remains accurate.
            self.output_queue.put((self.active_job_token, None))
            self.root.after(80, self.poll_job)
            return
        if finished:
            code = self.active_process.poll() if self.active_process else 0
            self.job_output += f"\n[TraceOS] Task finished with exit code {code}.\n"
            if self.output_widget and self.output_widget.winfo_exists():
                self.output_widget.insert("end", f"\n[TraceOS] Task finished with exit code {code}.\n")
            finished_kind = self.active_job_kind
            finished_attempt = self.active_job_attempt
            self._trace_diag("TASK_COMPLETED", task=self.active_job_label or "unknown", exit_code=code, attempt=finished_attempt if finished_attempt is not None else "none")
            if finished_kind == "image":
                start = self.job_output.find("{\n")
                end_marker = "\n[TraceOS] Task finished with exit code"
                end = self.job_output.find(end_marker, start)
                payload = self.job_output[start:end] if start >= 0 and end > start else ""
                parse_error = ""
                parsed = None
                if payload:
                    try:
                        parsed = json.loads(payload)
                    except (TypeError, ValueError) as exc:
                        parse_error = type(exc).__name__
                else:
                    parse_error = "no_json_payload"
                result_status = parsed.get("status", "unknown") if parsed is not None else "unknown"
                result_sha = (
                    parsed.get("sha256_after", parsed.get("sha256_before", "unknown"))
                    if parsed is not None
                    else "unknown"
                )
                result_unchanged = parsed.get("source_unchanged", "unknown") if parsed is not None else "unknown"
                result_mime = parsed.get("mime", "unknown") if parsed is not None else "unknown"
                self._trace_diag(
                    "IMAGE_CLI_COMPLETED",
                    attempt=finished_attempt if finished_attempt is not None else 0,
                    image_attempt=finished_attempt if finished_attempt is not None else 0,
                    exit_code=code,
                    output_chars=len(self.job_output),
                    json_payload="yes" if payload else "no",
                    json_parse="ok" if parsed is not None else "failed",
                    parse_error=parse_error or "none",
                    result_status=result_status,
                )
                if parsed is not None:
                    self._trace_diag(
                        "IMAGE_RESULT_RENDERED",
                        attempt=finished_attempt if finished_attempt is not None else 0,
                        image_attempt=finished_attempt if finished_attempt is not None else 0,
                        status=result_status,
                        sha256=result_sha,
                        source_unchanged=result_unchanged,
                        mime=result_mime,
                        exit_code=code,
                    )
                else:
                    self._trace_diag(
                        "IMAGE_RESULT_PARSE_FAILED",
                        attempt=finished_attempt if finished_attempt is not None else 0,
                        image_attempt=finished_attempt if finished_attempt is not None else 0,
                        exit_code=code,
                        output_chars=len(self.job_output),
                        json_payload="yes" if payload else "no",
                        parse_error=parse_error or "unknown",
                    )
            self.active_process = None
            self.active_job_token = None
            self.active_job_label = None
            self.active_job_kind = None
            self.active_job_attempt = None
            return
        # Keep polling until the matching reader sentinel arrives. The process
        # leader can exit before its reader thread has drained EOF and queued it.
        if self.active_job_token is not None:
            self.root.after(80, self.poll_job)

    def stop_job(self) -> None:
        if self.active_action_id is not None:
            if self.active_action_cancel is not None:
                self.active_action_cancel.set()
            self._trace_diag(
                "ACTION_CANCEL_REQUESTED",
                action_id=self.active_action_id,
            )
            self.job_output += "\n[TraceOS] Cancellation requested...\n"
            if self.output_widget:
                self.set_text(self.output_widget, self.job_output)
            return
        if self.active_process is not None:
            process = self.active_process
            stopped = terminate_process_group(process)
            self._trace_diag(
                "TASK_STOPPED" if stopped else "TASK_STOP_INCOMPLETE",
                task=self.active_job_label or "unknown",
                kind=self.active_job_kind or "generic",
                attempt=self.active_job_attempt if self.active_job_attempt is not None else "none",
            )
            if self.active_job_kind == "image":
                self._trace_diag("IMAGE_CLI_STOPPED", attempt=self.active_job_attempt or 0, image_attempt=self.active_job_attempt or 0)
            self.job_output += "\n[TraceOS] Task stopped by user.\n"
            if self.output_widget:
                self.set_text(self.output_widget, self.job_output)

    def _launch_card(self, parent: tk.Widget, row: int, column: int, glyph: str, title: str, blurb: str, command, accent: str = ACCENT) -> None:
        tile = tk.Frame(parent, bg=CARD, highlightthickness=1, highlightbackground=BORDER)
        tile.grid(row=row, column=column, sticky="nsew", padx=8, pady=8)
        chip = tk.Label(tile, text=glyph, bg=accent, fg="#07111c", font=("Sans", 16, "bold"), padx=12, pady=6)
        chip.pack(anchor="w", padx=16, pady=(14, 0))
        button = tk.Button(
            tile, text=title, command=command, bg=CARD, fg=TEXT,
            activebackground=CARD2, activeforeground=ACCENT,
            relief="flat", bd=0, highlightthickness=1, highlightbackground=CARD,
            highlightcolor=ACCENT, anchor="w", font=("Sans", 13, "bold"),
            padx=16, pady=2, takefocus=True,
        )
        button.pack(fill="x")
        button.bind("<FocusIn>", lambda _event, item=button: item.configure(bg=CARD2))
        button.bind("<FocusOut>", lambda _event, item=button: item.configure(bg=CARD))
        tk.Label(
            tile, text=blurb, bg=CARD, fg=MUTED, justify="left", anchor="w",
            font=("Sans", 9), wraplength=240,
        ).pack(fill="x", padx=16, pady=(0, 14))

    def tools_home(self) -> None:
