    def dashboard(self) -> None:
        self.activate_nav("Overview")
        top = self.heading(
            "OVERVIEW",
            "TraceOS Control Centre",
            "Investigation, analysis, privacy and local tools. External actions start only when you open them.",
        )
        if self.welcome:
            banner = tk.Frame(top, bg=CARD2, highlightthickness=1, highlightbackground=ACCENT)
            banner.pack(fill="x", pady=(14, 0))
            tk.Label(
                banner, text="WELCOME TO TRACEOS",
                bg=CARD2, fg=ACCENT, font=("Sans", 9, "bold")
            ).pack(anchor="w", padx=16, pady=(10, 1))
            tk.Label(
                banner, text="Start with a new case or open Demo Lab to explore safely.",
                bg=CARD2, fg=TEXT, font=("Sans", 10)
            ).pack(anchor="w", padx=16, pady=(0, 10))

        try:
            current = CASE_STORE.current()
            entries = CASE_STORE.list_cases()
            current_label = (
                f"{current.title}  •  {current.case_id[:8]}"
                if current and current.case_id
                else current.title if current else "No active case"
            )
            if current and current.legacy:
                current_label = f"{current.title}  •  LEGACY"
            count = sum(1 for entry in entries if entry.record)
            case_error = None
        except CaseError as exc:
            current_label = "Case state error"
            count = 0
            case_error = str(exc)

        status = tk.Frame(self.content, bg=BG)
        status.pack(fill="x", padx=32, pady=(4, 0))
        summary = f"Current case: {current_label}    •    Workspaces: {count}    •    {network_state()}    •    {session_state()}"
        tk.Label(status, text=summary, bg=BG, fg=ACCENT if not case_error else DANGER, font=("Sans", 10, "bold")).pack(anchor="w")
        if case_error:
            tk.Label(status, text=case_error, bg=BG, fg=DANGER, font=("Sans", 9)).pack(anchor="w")

        grid = tk.Frame(self.content, bg=BG)
        grid.pack(fill="x", padx=24, pady=8)
        for column in range(3):
            grid.grid_columnconfigure(column, weight=1, uniform="traceos-overview")
        overview = (
            ("▣", "Cases", "Manage investigation cases and the evidence vault.", self.cases_page, "#3d8bfd"),
            ("◎", "Investigation", "OSINT and analysis tools.", self.osint, "#2fce6a"),
            ("⌁", "Network", "Network and recon tools.", self.network, "#7a5cff"),
            ("⌘", "Tools", "Security and forensic tools.", self.tools_home, "#3d8bfd"),
            ("★", "AI Assistant", "Local command only. No external model is bundled.", self.ai_page, "#b06bff"),
            ("⚙", "Settings", "Appearance, privacy, network and system checks.", self.settings_page, "#f0a04b"),
        )
        for index, (glyph, title, blurb, command, accent) in enumerate(overview):
            self._launch_card(grid, index // 3, index % 3, glyph, title, blurb, command, accent)

        actions = tk.Frame(self.content, bg=BG)
        actions.pack(fill="x", padx=32, pady=(4, 16))
        for label, command in (
            ("SELECT CASE", self.select_case),
            ("ADD EVIDENCE", self.add_evidence),
            ("ANALYSE LOCALLY", self.analyse_evidence),
            ("GENERATE REPORT", self.generate_report),
        ):
            self.action_button(actions, label, command, primary=label == "SELECT CASE").pack(side="left", padx=(0, 8))

    def new_case(self) -> None:
        if not self._new_case_attempt_pending:
            self._trace_attempt += 1
        self._new_case_attempt_pending = False
        dialog = tk.Toplevel(self.root)
        dialog.title("New TraceOS Case")
        dialog.configure(bg=BG)
        dialog.transient(self.root)
        dialog.grab_set()
        dialog.resizable(True, True)
        dialog.geometry("560x390")

        tk.Label(
            dialog,
            text="NEW CASE",
            bg=BG,
            fg=ACCENT,
            font=("Sans", 16, "bold"),
        ).pack(anchor="w", padx=24, pady=(22, 3))
        tk.Label(
            dialog,
            text="Create a private case workspace and make it the active case.",
            bg=BG,
            fg=MUTED,
            font=("Sans", 9),
        ).pack(anchor="w", padx=24, pady=(0, 14))

        form = self.card(dialog, padx=18, pady=10)
        form.pack(fill="both", expand=True, padx=20, pady=(0, 12))

        tk.Label(
            form,
            text="CASE TITLE",
            bg=CARD,
            fg=MUTED,
            font=("Sans", 8, "bold"),
        ).pack(anchor="w", padx=14, pady=(10, 4))
        title_entry = tk.Entry(
            form,
            bg="#0e2a4e",
            fg=TEXT,
            insertbackground=ACCENT,
            relief="flat",
            font=("Sans", 10),
        )
        title_entry.pack(fill="x", padx=14, pady=(0, 12))

        tk.Label(
            form,
            text="DESCRIPTION",
            bg=CARD,
            fg=MUTED,
            font=("Sans", 8, "bold"),
        ).pack(anchor="w", padx=14, pady=(0, 4))
        description = tk.Text(
            form,
            height=6,
            bg="#0e2a4e",
            fg=TEXT,
            insertbackground=ACCENT,
            relief="flat",
            font=("Sans", 9),
            wrap="word",
        )
        description.pack(fill="both", expand=True, padx=14, pady=(0, 10))

        tk.Label(
            form,
            text="Authoritative metadata is stored in case.json. "
                 "In an amnesic live session, ~/Cases does not survive reboot "
                 "unless deliberately saved to persistent storage.",
            bg=CARD,
            fg=MUTED,
            font=("Sans", 8),
            wraplength=490,
            justify="left",
        ).pack(anchor="w", padx=14, pady=(0, 10))

        buttons = tk.Frame(dialog, bg=BG)
        buttons.pack(fill="x", padx=20, pady=(0, 18))

        def create() -> None:
            title_value = title_entry.get()
            description_value = description.get("1.0", "end").strip()
            self._trace_diag(
                "NEW_CASE_CREATE_CALLBACK_ENTERED",
                title_len=len(title_value),
            )
            try:
                record = CASE_STORE.create(
                    title_value,
                    description_value,
                )
                self._trace_diag(
                    "NEW_CASE_CREATED",
                    case_id=record.case_id or "legacy",
                )
                verified = CaseStore().current()
                if verified is None or verified.case_id != record.case_id:
                    raise CaseError(
                        "Independent in-process current-case state did not match the created case."
                    )
                self._trace_diag(
                    "NEW_CASE_STATE_VERIFIED",
                    case_id=record.case_id or "legacy",
                )
            except CaseCreatedButNotSelected as exc:
                self._trace_diag(
                    "NEW_CASE_FAILED",
                    exception_class=type(exc).__name__,
                    outcome="created-but-not-selected",
                )
                dialog.destroy()
                self.refresh_case_context()
                messagebox.showwarning(
                    "TraceOS",
                    f"Case created but not selected.\n\n"
                    f"Path: {exc.record.path}\n"
                    f"Case ID: {exc.record.case_id}\n\n"
                    f"Reason: {exc.cause}",
                    parent=self.root,
                )
                return
            except CaseError as exc:
                self._trace_diag(
                    "NEW_CASE_FAILED",
                    exception_class=type(exc).__name__,
                )
                messagebox.showerror(
                    "TraceOS",
                    str(exc),
                    parent=dialog,
                )
                return
            except Exception as exc:
                self._trace_diag(
                    "NEW_CASE_FAILED",
                    exception_class=type(exc).__name__,
                )
                messagebox.showerror(
                    "TraceOS",
                    "Unable to create the case.",
                    parent=dialog,
                )
                return

            dialog.destroy()
            self.refresh_case_header()
            header_text = str(self.header_case.cget("text"))
            prefix = (record.case_id or "legacy")[:8]
            if not record.case_id or prefix not in header_text:
                self._trace_diag(
                    "NEW_CASE_FAILED",
                    exception_class="HeaderMismatch",
                )
                messagebox.showerror(
                    "TraceOS",
                    "The new case was created but the case header did not update correctly.",
                    parent=self.root,
                )
                return
            self.dashboard()
            self.root.update_idletasks()
            self._trace_diag(
                "NEW_CASE_HEADER_REFRESHED",
                case_id=record.case_id,
                id_prefix=prefix,
            )

        def submit_from_title(_event: tk.Event) -> str:
            create()
            return "break"

        title_entry.bind("<Return>", submit_from_title)

        self.action_button(
            buttons,
            "CANCEL",
            dialog.destroy,
        ).pack(side="left")
        self.action_button(
            buttons,
            "CREATE CASE",
            create,
            primary=True,
        ).pack(side="right")
        title_entry.focus_set()
        self.root.update_idletasks()
        self._trace_diag(
            "NEW_CASE_DIALOG_OPENED",
            title_focus="yes" if self.root.focus_get() is title_entry else "no",
        )

    def select_case(self) -> None:
        dialog = tk.Toplevel(self.root)
        dialog.title("Select TraceOS Case")
        dialog.configure(bg=BG)
        dialog.transient(self.root)
        dialog.grab_set()
        dialog.geometry("920x520")

        tk.Label(
            dialog,
            text="SELECT CASE",
            bg=BG,
            fg=ACCENT,
            font=("Sans", 16, "bold"),
        ).pack(anchor="w", padx=24, pady=(22, 3))
        tk.Label(
            dialog,
            text="Choose an existing workspace. Corrupt or unsafe entries stay visible but cannot be activated.",
            bg=BG,
            fg=MUTED,
            font=("Sans", 9),
        ).pack(anchor="w", padx=24, pady=(0, 8))

        panel = self.card(dialog, padx=18, pady=10, expand=True)
        panel.pack(fill="both", expand=True, padx=20, pady=10)

        columns = ("title", "status", "case_id", "path")
        tree = ttk.Treeview(
            panel,
            columns=columns,
            show="headings",
            style="Trace.Treeview",
        )
        tree.heading("title", text="CASE")
        tree.heading("status", text="STATUS")
        tree.heading("case_id", text="CASE ID")
        tree.heading("path", text="PATH")
        tree.column("title", width=230, anchor="w")
        tree.column("status", width=90, anchor="center")
        tree.column("case_id", width=180, anchor="w")
        tree.column("path", width=330, anchor="w")
        tree.pack(fill="both", expand=True, padx=10, pady=10)

        entries = CASE_STORE.list_cases()
        if not entries:
            tree["height"] = 4
            tree.insert(
                "",
                "end",
                values=(
                    "No cases yet",
                    "EMPTY",
                    "",
                    "Create a new case to begin.",
                ),
            )
        else:
            for index, entry in enumerate(entries):
                record = entry.record
                tree.insert(
                    "",
                    "end",
                    iid=str(index),
                    values=(
                        record.title if record else entry.path.name,
                        entry.status,
                        (
                            record.case_id
                            if record and record.case_id
                            else "LEGACY" if record else ""
                        ),
                        str(entry.path),
                    ),
                )

        footer = tk.Frame(dialog, bg=BG)
        footer.pack(fill="x", padx=20, pady=(0, 18))

        def activate() -> None:
            selected = tree.selection()
            if not selected or not entries:
                messagebox.showinfo(
                    "TraceOS",
                    "There is no selectable case here yet.",
                    parent=dialog,
                )
                return
            entry = entries[int(selected[0])]
            if entry.error:
                messagebox.showerror(
                    "TraceOS Case",
                    f"Cannot select {entry.path.name}:\\n\\n{entry.error}",
                    parent=dialog,
                )
                return
            try:
                record = CASE_STORE.select(entry.path)
            except CaseError as exc:
                messagebox.showerror(
                    "TraceOS Case",
                    str(exc),
                    parent=dialog,
                )
                return
            dialog.destroy()
            self.refresh_case_header()
            self.dashboard()
            self._trace_diag(
                "case-selected",
                case_id=record.case_id or "legacy",
            )

        tree.bind("<Double-1>", lambda _event: activate())
        self.action_button(
            footer,
            "CLOSE",
            dialog.destroy,
        ).pack(side="left")
        self.action_button(
            footer,
            "SELECT CASE",
            activate,
            primary=True,
        ).pack(side="right")
        if entries:
            tree.selection_set("0")
            tree.focus("0")

    def add_evidence(self) -> None:
        value = filedialog.askopenfilename(parent=self.root, title="Select evidence file")
        if not value:
            return
        result = capture([TRACE, "evidence", "add", value], timeout=90)
        if result and result.returncode == 0:
            self.evidence()
        else:
            messagebox.showerror(
                "Evidence Vault", (result.stdout or result.stderr or "Unable to add evidence.").strip(),
                parent=self.root
            )

    def analyse_evidence(self) -> None:
        value = filedialog.askopenfilename(parent=self.root, title="Select file for local analysis")
        if value:
            self.network_or_output_page("Local Analysis", "Forensic output stays on this machine.", [TRACE, "analyse", value])

    def network_or_output_page(self, title: str, subtitle: str, args: list[str]) -> None:
        self.heading("TraceOS task", title, subtitle)
        panel = self.card(self.content, padx=28, pady=10, expand=True)
        self.set_output(panel, height=25)
        bar = tk.Frame(self.content, bg=BG)
        bar.pack(fill="x", padx=28, pady=(0, 18))
        self.action_button(bar, "STOP TASK", self.stop_job).pack(side="left")
        self.action_button(bar, "RUN AGAIN", lambda: self.run_job(args, title), primary=True).pack(side="right")
        self.run_job(args, title)

    def cases_page(self) -> None:
        self.activate_nav("Cases")
        self.heading(
            "CASES",
            "Investigation cases",
            "Workspaces already stored on this machine. Search only filters this list.",
        )
        try:
            entries = CASE_STORE.list_cases()
            case_error = None
        except CaseError as exc:
            entries = []
            case_error = str(exc)

        toolbar = tk.Frame(self.content, bg=BG)
        toolbar.pack(fill="x", padx=28, pady=(0, 8))
        search_var = tk.StringVar()
        search = tk.Entry(
            toolbar, textvariable=search_var, bg=CARD, fg=TEXT, insertbackground=ACCENT,
            relief="flat", font=("Sans", 10), highlightthickness=1, highlightbackground=BORDER,
        )
        search.pack(side="left", fill="x", expand=True, ipady=6, padx=(0, 8))
        self.action_button(toolbar, "NEW CASE", self.new_case, primary=True).pack(side="left")
        self.action_button(toolbar, "SELECT CASE", self.select_case).pack(side="left", padx=7)
        self.action_button(toolbar, "EVIDENCE VAULT", self.evidence).pack(side="left")

        if case_error:
            tk.Label(self.content, text=case_error, bg=BG, fg=DANGER, font=("Sans", 9)).pack(anchor="w", padx=30)

        rows = []
        for entry in entries:
            record = entry.record
            title = record.title if record else entry.path.name
            identifier = record.case_id if record and record.case_id else "LEGACY" if record else ""
            created = record.created_utc if record and record.created_utc else ""
            rows.append((title, entry.status, identifier, created or str(entry.path)))

        box = self.card(self.content, padx=28, pady=5, expand=True)
        columns = ("title", "status", "case_id", "created")
        tree = ttk.Treeview(box, columns=columns, show="headings", style="Trace.Treeview")
        for name, label, width in (
            ("title", "CASE", 280),
            ("status", "STATUS", 110),
            ("case_id", "CASE ID", 220),
            ("created", "CREATED UTC", 260),
        ):
            tree.heading(name, text=label)
            tree.column(name, width=width, anchor="w")
        tree.pack(fill="both", expand=True, padx=14, pady=14)

        def refill(*_args) -> None:
            query = search_var.get().strip().lower()
            children = tree.get_children()
            if children:
                tree.delete(*children)
            shown = 0
            for row in rows:
                if query and query not in " ".join(row).lower():
                    continue
                tree.insert("", "end", values=row)
                shown += 1
            if shown == 0:
                tree.insert("", "end", values=("No matching cases", "", "", "Create one with New Case."))

        search_var.trace_add("write", refill)
        refill()
        tk.Label(
            self.content,
            text="Selecting a case still uses the existing case store. The vault is a separate view of the active case.",
            bg=BG, fg=MUTED, font=("Sans", 8),
        ).pack(anchor="w", padx=30, pady=(0, 12))

