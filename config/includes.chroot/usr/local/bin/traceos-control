    def _build_api_assistant(self) -> None:
        import ai_client

        store = ai_client.SessionStore()
        box = self.card(self.content, padx=28, pady=8)
        tk.Label(box, text="OPTIONAL API ASSISTANT", bg=CARD, fg=ACCENT, font=("Sans", 8, "bold")).pack(anchor="w", padx=16, pady=(14, 4))
        tk.Label(
            box,
            text="A remote provider sends only the message you submit. Case files are never attached. Nothing is sent at startup. "
            + ai_client.secret_service_status(),
            bg=CARD, fg=MUTED, font=("Sans", 9), wraplength=760, justify="left",
        ).pack(anchor="w", padx=16, pady=(0, 8))
        provider = ttk.Combobox(box, state="readonly", values=tuple(ai_client.PROVIDERS), style="Trace.TCombobox")
        provider.current(0)
        provider.pack(anchor="w", padx=16, pady=4)
        model = tk.Entry(box, bg="#0e2a4e", fg=TEXT, insertbackground=ACCENT, relief="flat", font=("Sans", 10))
        model.insert(0, ai_client.PROVIDERS["openai"]["model"])
        model.pack(fill="x", padx=16, pady=4)
        endpoint = tk.Entry(box, bg="#0e2a4e", fg=TEXT, insertbackground=ACCENT, relief="flat", font=("Sans", 10))
        endpoint.pack(fill="x", padx=16, pady=4)
        key_entry = tk.Entry(box, bg="#0e2a4e", fg=TEXT, insertbackground=ACCENT, relief="flat", font=("Sans", 10), show="•")
        key_entry.pack(fill="x", padx=16, pady=4)
        status = tk.Label(box, text="No key saved for this session.", bg=CARD, fg=MUTED, font=("Sans", 9), wraplength=760, justify="left")
        status.pack(anchor="w", padx=16, pady=4)
        prompt = tk.Text(box, height=4, bg="#07101c", fg=TEXT, insertbackground=ACCENT, relief="flat", font=("Sans", 10))
        prompt.pack(fill="x", padx=16, pady=4)
        include_case = tk.BooleanVar(value=False)
        tk.Checkbutton(
            box, text="Include the active case title in this message. Leave this off unless you mean to.",
            variable=include_case, bg=CARD, fg=WARN, activebackground=CARD, activeforeground=WARN,
            selectcolor=BG2, font=("Sans", 9),
        ).pack(anchor="w", padx=12, pady=4)
        output = tk.Text(box, height=6, bg="#07101c", fg=TEXT, relief="flat", font=("Sans", 10), state="disabled")
        output.pack(fill="x", padx=16, pady=(4, 8))

        def selected() -> str:
            return provider.get() or "openai"

        def remember(where: str) -> None:
            choice = selected()
            secret = key_entry.get().strip()
            try:
                if where == "session":
                    store.put(choice, secret)
                    status.configure(text=f"Session only · {ai_client.PROVIDERS[choice]['label']} · {store.masked(choice)}", fg=GOOD)
                else:
                    ai_client.save_to_secret_service(choice, secret)
                    store.put(choice, secret)
                    status.configure(text=f"Saved in Secret Service · {store.masked(choice)}", fg=GOOD)
                key_entry.delete(0, "end")
            except Exception as exc:
                status.configure(text=str(exc), fg=DANGER)

        def forget() -> None:
            choice = selected()
            store.delete(choice)
            try:
                ai_client.delete_from_secret_service(choice)
            except Exception as exc:
                status.configure(text=f"Removed from this session. Keyring: {exc}", fg=WARN)
                return
            status.configure(text="Key removed from this session and from Secret Service if it was saved there.", fg=MUTED)

        def current_key() -> str:
            choice = selected()
            saved = store.get(choice)
            if saved:
                return saved
            try:
                saved = ai_client.load_from_secret_service(choice)
            except Exception:
                saved = ""
            if saved:
                store.put(choice, saved)
            return saved

        def test_or_send(send: bool) -> None:
            choice = selected()
            secret = current_key()
            text = "Reply with the single word pong." if not send else prompt.get("1.0", "end").strip()
            if send and include_case.get():
                text = f"Active case title: {case_name(case_path())}\n\n{text}"
            try:
                answer = ai_client.complete(choice, model.get(), secret, text, endpoint.get())
            except Exception as exc:
                answer = str(exc)
            output.configure(state="normal")
            output.delete("1.0", "end")
            output.insert("1.0", answer)
            output.configure(state="disabled")

        actions = tk.Frame(box, bg=CARD)
        actions.pack(fill="x", padx=16, pady=(0, 14))
        self.action_button(actions, "SAVE FOR SESSION", lambda: remember("session")).pack(side="left")
        self.action_button(actions, "SAVE TO KEYRING", lambda: remember("keyring")).pack(side="left", padx=6)
        self.action_button(actions, "REMOVE KEY", forget).pack(side="left", padx=6)
        self.action_button(actions, "TEST", lambda: test_or_send(False)).pack(side="left", padx=6)
        self.action_button(actions, "SEND", lambda: test_or_send(True), primary=True).pack(side="right")

        def apply_default(_event: object = None) -> None:
            model.delete(0, "end")
            model.insert(0, ai_client.PROVIDERS[selected()]["model"])

        provider.bind("<<ComboboxSelected>>", apply_default)

    def settings_page(self) -> None:
        self.activate_nav("Settings")
        self.heading(
            "SETTINGS",
            "Session and system",
            "Each control runs an existing program. Nothing here is only a picture.",
        )
        groups = (
            ("APPEARANCE", "XFCE appearance settings for the live session.", "xfce4-appearance-settings", "OPEN APPEARANCE"),
            ("WALLPAPER", "The desktop wallpaper chooser. The packaged default stays in place until you change it.", "xfdesktop-settings", "OPEN WALLPAPER"),
            ("NETWORK", f"Connection state: {network_state()}", "nm-connection-editor", "OPEN NETWORK SETTINGS"),
        )
        for title, detail, command, label in groups:
            box = self.card(self.content, padx=28, pady=6)
            tk.Label(box, text=title, bg=CARD, fg=ACCENT, font=("Sans", 8, "bold")).pack(anchor="w", padx=16, pady=(12, 2))
            tk.Label(box, text=detail, bg=CARD, fg=TEXT, font=("Sans", 10), wraplength=760, justify="left").pack(anchor="w", padx=16)
            present = shutil.which(command) is not None

            def launch(command: str = command, title: str = label) -> None:
                try:
                    subprocess.Popen([command])
                except OSError as exc:
                    messagebox.showerror(title, str(exc), parent=self.root)

            button = self.action_button(box, label if present else f"{label} UNAVAILABLE", launch)
            button.pack(anchor="w", padx=16, pady=(8, 12))
            if not present:
                button.configure(state="disabled")
        privacy = self.card(self.content, padx=28, pady=6)
        tk.Label(privacy, text="PRIVACY", bg=CARD, fg=ACCENT, font=("Sans", 8, "bold")).pack(anchor="w", padx=16, pady=(12, 2))
        tk.Label(
            privacy,
            text=f"Session: {session_state()}. Amnesic mode does not write a persistence volume.",
            bg=CARD, fg=TEXT, font=("Sans", 10), wraplength=760, justify="left",
        ).pack(anchor="w", padx=16, pady=(0, 12))
        system = self.card(self.content, padx=28, pady=6)
        tk.Label(system, text="SYSTEM", bg=CARD, fg=ACCENT, font=("Sans", 8, "bold")).pack(anchor="w", padx=16, pady=(12, 2))
        tk.Label(
            system, text="System Doctor checks the TraceOS runtime, bundled tools and branding assets.",
            bg=CARD, fg=TEXT, font=("Sans", 10),
        ).pack(anchor="w", padx=16)
        self.action_button(system, "RUN SYSTEM DOCTOR", self.doctor_page, primary=True).pack(anchor="w", padx=16, pady=(8, 12))

    def evidence(self) -> None:
        self.activate_nav("Cases")
        self.heading(
            "Case tools", "Evidence Vault",
            "Separate copies, SHA-256 integrity records and a readable audit trail."
        )
        toolbar = tk.Frame(self.content, bg=BG)
        toolbar.pack(fill="x", padx=28, pady=(0, 8))
        self.action_button(toolbar, "ADD EVIDENCE", self.add_evidence, primary=True).pack(side="left")
        self.action_button(toolbar, "ANALYSE FILE", self.analyse_evidence).pack(side="left", padx=7)
        self.action_button(
            toolbar, "VERIFY INTEGRITY",
            lambda: self.network_or_output_page(
                "Evidence Integrity",
                "Recalculate SHA-256 for every vault copy and compare with the case ledger.",
                [TRACE, "evidence", "verify"],
            )
        ).pack(side="left", padx=7)
        current = case_path()
        self.action_button(toolbar, "OPEN CASE FOLDER", lambda: self.open_path(current) if current else None).pack(side="right")

        box = self.card(self.content, padx=28, pady=5, expand=True)
        columns = ("name", "time", "size", "hash")
        tree = ttk.Treeview(box, columns=columns, show="headings", style="Trace.Treeview")
        tree.heading("name", text="VAULT COPY")
        tree.heading("time", text="UTC")
        tree.heading("size", text="SIZE")
        tree.heading("hash", text="SHA-256")
        tree.column("name", width=310)
        tree.column("time", width=175)
        tree.column("size", width=100)
        tree.column("hash", width=420)
        tree.pack(fill="both", expand=True, padx=14, pady=14)

        if current:
            manifest = current / "hashes" / "evidence.tsv"
            if manifest.exists():
                rows = manifest.read_text(encoding="utf-8").splitlines()[1:]
                for row in rows:
                    parts = row.split("	")
                    if len(parts) == 6:
                        tree.insert("", "end", values=(Path(parts[2]).name, parts[0], f"{parts[4]} B", parts[3]))
        else:
            tree.insert("", "end", values=("No current case", "", "", ""))

        tk.Label(
            self.content, text="Original source files are not modified by the case helper.",
            bg=BG, fg=MUTED, font=("Sans", 8)
        ).pack(anchor="w", padx=30, pady=(0, 12))

    def network(self) -> None:
        self.activate_nav("Network")
        self.heading(
            "Network", "Command Centre",
            "Live local status plus explicit, user-invoked Nmap scans."
        )
        top = self.card(self.content, padx=28, pady=8)
        tk.Label(top, text=f"NETWORK  {network_state()}", bg=CARD, fg=GOOD, font=("Sans", 10, "bold")).pack(
            side="left", padx=16, pady=14
        )
        self.action_button(top, "REFRESH", self.network).pack(side="right", padx=8, pady=6)
        self.action_button(top, "NETWORK SETTINGS", lambda: self.open_terminal(["nm-connection-editor"], "Network Settings")).pack(side="right", padx=8, pady=6)

        controls = self.card(self.content, padx=28, pady=8)
        tk.Label(controls, text="AUTHORIZED TARGET", bg=CARD, fg=MUTED, font=("Sans", 8, "bold")).grid(row=0, column=0, sticky="w", padx=15, pady=(14, 4))
        target = tk.Entry(controls, bg="#0e2a4e", fg=TEXT, insertbackground=ACCENT, relief="flat", font=("Monospace", 10))
        target.grid(row=1, column=0, sticky="ew", padx=15, pady=(0, 14))
        target.focus_set()
        tk.Label(controls, text="SCAN PROFILE", bg=CARD, fg=MUTED, font=("Sans", 8, "bold")).grid(row=0, column=1, sticky="w", padx=8, pady=(14, 4))
        profile = ttk.Combobox(controls, state="readonly", values=("Quick", "Standard", "Services"), style="Trace.TCombobox")
        profile.current(0)
        profile.grid(row=1, column=1, sticky="ew", padx=8, pady=(0, 14))
        controls.grid_columnconfigure(0, weight=3)
        controls.grid_columnconfigure(1, weight=1)

        authorized = tk.BooleanVar(value=False)
        consent = tk.Checkbutton(
            controls,
            text="I own this system or have explicit authorization to scan it.",
            variable=authorized,
            bg=CARD,
            fg=WARN,
            activebackground=CARD,
            activeforeground=WARN,
            selectcolor=BG2,
            font=("Sans", 9, "bold"),
        )
        consent.grid(row=2, column=0, columnspan=2, sticky="w", padx=14, pady=(0, 10))

        output_panel = self.card(self.content, padx=28, pady=8, expand=True)
        self.set_output(output_panel, height=18)

        bar = tk.Frame(self.content, bg=BG)
        bar.pack(fill="x", padx=28, pady=(0, 14))
        self.action_button(bar, "STOP", self.stop_job).pack(side="left")

        def start_scan() -> None:
            try:
                host = normalize_web_target("Nmap Quick Scan", target.get())
            except ValueError as exc:
                messagebox.showwarning("Nmap", str(exc), parent=self.root)
                return
            if not authorized.get():
                messagebox.showwarning(
                    "Authorization required",
                    "Confirm that you own this target or have explicit permission to scan it.",
                    parent=self.root,
                )
                return
            if not messagebox.askyesno(
                "Start Nmap scan?",
                f"This sends scan traffic to {host}. Continue only with authorization.",
                parent=self.root,
            ):
                return
            args = {"Quick": ["-F"], "Standard": ["-sV", "-T3"], "Services": ["-sV", "-sC", "-T3"]}[profile.get()]
            self.run_job([TRACE, "network", "nmap", *args, "--", host], "Nmap scan")

        self.action_button(bar, "RUN NMAP", start_scan, primary=True).pack(side="right")

    def image_osint(self) -> None:
        self.activate_nav("Image OSINT")
        image_attempt = self._trace_attempt
        self.heading(
            "INVESTIGATION / IMAGE", "Image OSINT",
            "Local-first image inspection. The selected source is analysed without uploading it."
        )
        warning = self.card(self.content, padx=28, pady=7)
        tk.Label(warning, text="LOCAL ANALYSIS ONLY", bg=CARD, fg=GOOD, font=("Sans", 9, "bold")).pack(anchor="w", padx=15, pady=(10, 1))
        tk.Label(
            warning,
            text="Image analysis stays on this machine. Reverse-image search is a separate, user-confirmed browser handoff.",
            bg=CARD, fg=MUTED, font=("Sans", 9)
        ).pack(anchor="w", padx=15, pady=(0, 10))

        mode_bar = tk.Frame(self.content, bg=BG)
        mode_bar.pack(fill="x", padx=28, pady=(0, 6))
        self.action_button(mode_bar, "CLI / WEB OSINT", self.osint).pack(side="left")
        self.action_button(mode_bar, "IMAGE OSINT", self.image_osint, primary=True).pack(side="left", padx=7)

        controls = self.card(self.content, padx=28, pady=7)
        tk.Label(controls, text="SELECTED SOURCE", bg=CARD, fg=MUTED, font=("Sans", 8, "bold")).grid(
            row=0, column=0, columnspan=3, sticky="w", padx=15, pady=(10, 4)
        )
        source_var = tk.StringVar(value="No image selected")
        tk.Label(
            controls, textvariable=source_var, bg="#0e2a4e", fg=TEXT,
            anchor="w", justify="left", font=("Monospace", 9)
        ).grid(row=1, column=0, columnspan=3, sticky="ew", padx=15, pady=(0, 8))
        tk.Label(controls, text="FILE PATH / KEYBOARD ACCESS", bg=CARD, fg=MUTED, font=("Sans", 8, "bold")).grid(row=2, column=0, columnspan=3, sticky="w", padx=15, pady=(0, 4))
        source_entry = tk.Entry(controls, bg="#0e2a4e", fg=TEXT, insertbackground=ACCENT, relief="flat", font=("Monospace", 9))
        source_entry.grid(row=3, column=0, columnspan=2, sticky="ew", padx=15, pady=(0, 12))

        bar = tk.Frame(self.content, bg=BG)
        bar.pack(fill="x", padx=28, pady=(0, 14))

        output_panel = self.card(self.content, padx=28, pady=7, expand=True)
        self.set_output(output_panel, height=18)

        def use_image_path() -> None:
            selected = source_entry.get().strip()
            if not selected:
                messagebox.showwarning("Image OSINT", "Enter an image path first.", parent=self.root)
                return
            path = Path(selected).expanduser()
            if path.is_symlink() or not path.is_file():
                messagebox.showwarning("Image OSINT", "Select an existing regular image file.", parent=self.root)
                return
            nonlocal image_attempt
            self._trace_attempt += 1
            image_attempt = self._trace_attempt
            source_var.set(str(path))
            self._trace_diag("IMAGE_SOURCE_SELECTED", image_attempt=image_attempt, source_kind="path-entry")
            start_button.focus_set()

        def choose_image() -> None:
            selected = filedialog.askopenfilename(
                parent=self.root,
                title="Select an image for local analysis",
                filetypes=[
                    ("Image files", "*.png *.jpg *.jpeg *.gif *.webp *.bmp *.tif *.tiff"),
                    ("All files", "*.*"),
                ],
            )
            if selected:
                nonlocal image_attempt
                self._trace_attempt += 1
                image_attempt = self._trace_attempt
                source_var.set(selected)
                source_entry.delete(0, "end")
                source_entry.insert(0, selected)
                self._trace_diag("IMAGE_SOURCE_SELECTED", image_attempt=image_attempt, source_kind="file-selected")
                start_button.focus_set()

        def handoff() -> None:
            selected = source_var.get()
            if selected == "No image selected":
                messagebox.showwarning("Image OSINT", "Choose an image first.", parent=self.root)
                return
            chosen = site.get()
            address = REVERSE_IMAGE_SITES.get(chosen)
            if not address:
                messagebox.showerror("Image OSINT", "Choose a reverse-image site first.", parent=self.root)
                return
            if not messagebox.askyesno(
                "External browser handoff",
                f"Open {chosen}? TraceOS will not upload or submit this image. You choose and submit it on that site.",
                parent=self.root,
            ):
                self._trace_diag("IMAGE_BROWSER_HANDOFF_CANCELLED")
                return
            try:
                opened = webbrowser.open(address, new=2)
                self._trace_diag("IMAGE_BROWSER_HANDOFF_OPENED", attempt=image_attempt)
            except Exception as exc:
                self._trace_diag("IMAGE_BROWSER_HANDOFF_FAILED", exc_type=type(exc).__name__)
                messagebox.showerror("Image OSINT", f"Unable to open browser: {exc}", parent=self.root)
                return
            if not opened:
                messagebox.showerror(
                    "Image OSINT",
                    "TraceOS could not open a browser. Check Firefox in System Doctor.",
                    parent=self.root,
                )

        def start_image() -> None:
            selected = source_var.get()
            if selected == "No image selected":
                messagebox.showwarning("Image OSINT", "Choose an image first.", parent=self.root)
                return
            path = Path(selected).expanduser()
            if path.is_symlink():
                messagebox.showwarning("Image OSINT", "For safety, select the actual image file rather than a symbolic link.", parent=self.root)
                return
            if not path.is_file():
                messagebox.showwarning("Image OSINT", "The selected file is no longer available.", parent=self.root)
                return
            self._trace_diag("IMAGE_ANALYSIS_START_CLICKED", image_attempt=image_attempt, source_kind="regular-file")
            self.run_job([TRACE, "image", str(path)], "Local image analysis", kind="image", attempt=image_attempt)

        def read_metadata() -> None:
            selected = source_var.get()
            if selected == "No image selected":
                messagebox.showwarning("Image OSINT", "Choose an image first.", parent=self.root)
                return
            path = Path(selected).expanduser()
            if path.is_symlink() or not path.is_file():
                messagebox.showwarning("Image OSINT", "Select an existing regular image file.", parent=self.root)
                return
            if shutil.which("exiftool") is None:
                messagebox.showerror("Image OSINT", "exiftool is not installed in this TraceOS image.", parent=self.root)
                return
            self.run_job(["exiftool", "-json", "-groupNames", str(path)], "ExifTool metadata")

        self.action_button(bar, "CHOOSE IMAGE", choose_image).pack(side="left")
        site = ttk.Combobox(
            bar,
            state="readonly",
            values=tuple(REVERSE_IMAGE_SITES),
            width=22,
        )
        site.current(0)
        site.pack(side="left", padx=(8, 0))
        self.action_button(controls, "USE PATH", use_image_path).grid(row=3, column=2, sticky="e", padx=15, pady=(0, 12))

        def handle_image_return(_event: tk.Event) -> str:
            if source_var.get() == "No image selected":
                use_image_path()
            else:
                start_image()
            return "break"

        source_entry.bind("<Return>", handle_image_return)
        self.action_button(bar, "READ METADATA", read_metadata).pack(side="left", padx=7)
        self.action_button(bar, "REVERSE-IMAGE SITE", handoff).pack(side="left", padx=7)
        self.action_button(bar, "STOP", self.stop_job).pack(side="left", padx=7)
        start_button = self.action_button(bar, "START LOCAL ANALYSIS", start_image, primary=True)
        start_button.pack(side="right")
        start_button.bind("<Return>", lambda _event: (start_image(), "break")[1])
        start_button.bind("<space>", lambda _event: (start_image(), "break")[1])

        # Flush drawing without nesting the Tk event loop from this callback.
        self.root.update_idletasks()
        source_entry.focus_set()
        self._trace_diag("image-osint-page-rendered", page="image")
    def osint(self) -> None:
        self.activate_nav("Investigation")
        self.heading(
            "INVESTIGATION", "Investigation Centre",
            "Local-first investigation tools. Nothing runs until you press Start."
        )
        warning = self.card(self.content, padx=28, pady=7)
        tk.Label(
            warning, text="EXTERNAL ACTIONS ARE USER-INVOKED",
            bg=CARD, fg=WARN, font=("Sans", 9, "bold")
        ).pack(anchor="w", padx=15, pady=(10, 1))
        tk.Label(
            warning,
            text="Missing commands are marked unavailable. Searches only start after you press Start.",
            bg=CARD, fg=MUTED, font=("Sans", 9)
        ).pack(anchor="w", padx=15, pady=(0, 10))

        controls = self.card(self.content, padx=28, pady=7)
        tk.Label(controls, text="TOOL", bg=CARD, fg=MUTED, font=("Sans", 8, "bold")).grid(row=0, column=0, sticky="w", padx=15, pady=(10, 4))
        tool_labels = [
            name if shutil.which(command) else f"{name} (not installed)"
            for name, command in OSINT_TOOL_COMMANDS.items()
        ]
        tool = ttk.Combobox(
            controls,
            state="readonly",
            values=tuple(tool_labels),
            style="Trace.TCombobox",
        )
        tool.current(0)
        tool.grid(row=1, column=0, sticky="ew", padx=15, pady=(0, 12))
        tk.Label(controls, text="TARGET / ARGUMENTS", bg=CARD, fg=MUTED, font=("Sans", 8, "bold")).grid(row=0, column=1, sticky="w", padx=8, pady=(10, 4))
        target = tk.Entry(controls, bg="#0e2a4e", fg=TEXT, insertbackground=ACCENT, relief="flat", font=("Monospace", 10))
        target.grid(row=1, column=1, sticky="ew", padx=8, pady=(0, 12))
        tk.Label(controls, text="EXTRA OPTIONS", bg=CARD, fg=MUTED, font=("Sans", 8, "bold")).grid(row=0, column=2, sticky="w", padx=8, pady=(10, 4))
        extra = tk.Entry(controls, bg="#0e2a4e", fg=TEXT, insertbackground=ACCENT, relief="flat", font=("Monospace", 10))
        extra.grid(row=1, column=2, sticky="ew", padx=8, pady=(0, 12))
        controls.grid_columnconfigure(0, weight=1)
        controls.grid_columnconfigure(1, weight=3)
        controls.grid_columnconfigure(2, weight=2)

        mode_bar = tk.Frame(self.content, bg=BG)
        mode_bar.pack(fill="x", padx=28, pady=(0, 6))
        self.action_button(mode_bar, "IMAGE OSINT", self.image_osint, primary=True).pack(side="left")
        tk.Label(
            mode_bar,
            text="CURRENT MODE  •  PERSONAL / WEB CLI WORKBENCH",
            bg=BG, fg=MUTED, font=("Sans", 8, "bold")
        ).pack(side="left", padx=12)

        hint = tk.Label(
            self.content,
            text="Username: Sherlock/Maigret/Blackbird • Email: Holehe/h8mail/Blackbird • Phone: PhoneInfoga • GHunt needs one local login before an email search • Domain: theHarvester/Subfinder/dnsrecon/dnstwist • Cloud: Cloud Enum takes one company or domain keyword • WHOIS/DNS: domain or IP",
            bg=BG, fg=MUTED, font=("Sans", 8)
        )
        hint.pack(anchor="w", padx=30, pady=(0, 4))

        output_panel = self.card(self.content, padx=28, pady=7, expand=True)
        self.set_output(output_panel, height=17)

        bar = tk.Frame(self.content, bg=BG)
        bar.pack(fill="x", padx=28, pady=(0, 14))
        self.action_button(
            bar, "OPEN CLI WORKBENCH",
            lambda: self.open_terminal([TRACE, "osint"], "TraceOS Investigation Workbench")
        ).pack(side="left")
        self.action_button(bar, "STOP", self.stop_job).pack(side="left", padx=7)

        def start_osint() -> None:
            selected = tool.get()
            name = selected.removesuffix(" (not installed)")
            try:
                args = build_osint_command(name, target.get(), extra.get())
                require_osint_tool(args[0])
            except ValueError as exc:
                messagebox.showwarning(
                    "OSINT",
                    f"Invalid arguments: {exc}",
                    parent=self.root,
                )
                return
            except FileNotFoundError as exc:
                messagebox.showerror(
                    "OSINT",
                    f"Tool unavailable: {exc}",
                    parent=self.root,
                )
                return

            value = target.get().strip()
            if name in {"WHOIS", "DNS"}:
                lookup_tool = "whois" if name == "WHOIS" else "dns"
                if extra.get().strip():
                    messagebox.showwarning(
                        "OSINT",
                        f"Extra options are not supported for {name} in the controlled Action mode.",
                        parent=self.root,
                    )
                    self._trace_diag("ACTION_EXTRA_OPTIONS_REJECTED", tool=name)
                    return
                self.start_basic_lookup_action(lookup_tool, value)
                return

            if not shutil.which(args[0]):
                messagebox.showerror(
                    "OSINT",
                    f"{name} is unavailable in this TraceOS image.",
                    parent=self.root,
                )
                self._trace_diag("OSINT_TOOL_UNAVAILABLE", tool=name, command=args[0])
                return

            if name == "GHunt":
                creds = Path.home() / ".malfrats" / "ghunt"
                if not creds.exists():
                    messagebox.showinfo(
                        "GHunt",
                        "GHunt cannot search until you complete one local login. A terminal will open for that. The login stays on this machine.",
                        parent=self.root,
                    )
                    self.open_terminal(["ghunt", "login"], "TraceOS GHunt login")
                    return

            self.run_job(args, f"{name} investigation")

        self.action_button(bar, "START LOOKUP", start_osint, primary=True).pack(side="right")
        self.root.update_idletasks()
        self._trace_diag("osint-page-rendered", page="osint")


    def _tool_catalogue_page(self, specs: dict, kicker: str, title: str, subtitle: str, warning: str) -> None:
        self.heading(kicker, title, subtitle)
        notice = self.card(self.content, padx=28, pady=7)
        tk.Label(
            notice, text="NOTHING RUNS UNTIL YOU CONFIRM",
            bg=CARD, fg=WARN, font=("Sans", 9, "bold")
        ).pack(anchor="w", padx=15, pady=(10, 1))
        tk.Label(
            notice, text=warning, bg=CARD, fg=MUTED, wraplength=820,
            justify="left", font=("Sans", 9)
        ).pack(anchor="w", padx=15, pady=(0, 10))

        controls = self.card(self.content, padx=22, pady=8)
        tk.Label(controls, text="TOOL", bg=CARD, fg=MUTED, font=("Sans", 8, "bold")).grid(
            row=0, column=0, sticky="w", padx=12, pady=(10, 4)
        )
        labels = [
            name if shutil.which(spec["command"]) else f"{name} (not installed)"
            for name, spec in specs.items()
        ]
        tool = ttk.Combobox(controls, state="readonly", values=tuple(labels), style="Trace.TCombobox")
        tool.current(0)
        tool.grid(row=1, column=0, sticky="ew", padx=12, pady=(0, 10))
        target_label = tk.Label(
            controls, text="AUTHORIZED TARGET", bg=CARD, fg=MUTED, font=("Sans", 8, "bold")
        )
        target_label.grid(row=0, column=1, sticky="w", padx=8, pady=(10, 4))
        target = tk.Entry(
            controls, bg="#0e2a4e", fg=TEXT, insertbackground=ACCENT,
            relief="flat", font=("Monospace", 10)
        )
        target.grid(row=1, column=1, sticky="ew", padx=8, pady=(0, 10))
        controls.grid_columnconfigure(0, weight=2)
        controls.grid_columnconfigure(1, weight=4)

        def browse_target() -> None:
            _name, spec = selected_spec()
            mode = spec["mode"]
            if mode == "directory":
                selected = filedialog.askdirectory(
                    parent=self.root, title="Select local folder", mustexist=True
                )
                if not selected:
                    return
                chosen = selected
            elif mode == "file":
                selected = filedialog.askopenfilename(
                    parent=self.root, title="Select local file"
                )
                if not selected:
                    return
                chosen = selected
            elif mode == "two-files":
                rules = filedialog.askopenfilename(
                    parent=self.root, title="Select rules file"
                )
                if not rules:
                    return
                subject = filedialog.askopenfilename(
                    parent=self.root, title="Select target file"
                )
                if not subject:
                    return
                chosen = f"{shlex.quote(rules)} {shlex.quote(subject)}"
            else:
                return
            target.configure(state="normal")
            target.delete(0, "end")
            target.insert(0, chosen)

        browse = self.action_button(controls, "BROWSE", browse_target)
        browse.grid(row=1, column=2, sticky="e", padx=(0, 12), pady=(0, 10))

        def selected_spec():
            name = tool.get().removesuffix(" (not installed)")
            return name, specs[name]

        def refresh_target(_event=None) -> None:
            _name, spec = selected_spec()
            target.configure(state="normal")
            target.delete(0, "end")
            if spec["mode"] in {"launch", "local"}:
                target.configure(state="disabled")
                target_label.configure(text="NO TARGET PRESELECTED")
            elif spec["mode"] == "two-files":
                target.configure(state="normal")
                target_label.configure(text="RULES FILE AND TARGET FILE")
            elif spec["mode"] == "file":
                target.configure(state="normal")
                target_label.configure(text="LOCAL FILE")
            elif spec["mode"] == "directory":
                target.configure(state="normal")
                target_label.configure(text="LOCAL FOLDER")
            elif spec["mode"] == "identity":
                target.configure(state="normal")
                target_label.configure(text="IDENTITY")
            else:
                target.configure(state="normal")
                target_label.configure(text="AUTHORIZED TARGET")
            if spec["mode"] in {"file", "directory", "two-files"}:
                browse.configure(state="normal")
            else:
                browse.configure(state="disabled")

        tool.bind("<<ComboboxSelected>>", refresh_target)
        refresh_target()
        authorized = tk.BooleanVar(value=False)
        tk.Checkbutton(
            controls,
            text="I own this system or have explicit authorization to use this tool.",
            variable=authorized,
            bg=CARD, fg=WARN, activebackground=CARD, activeforeground=WARN,
            selectcolor=BG2, font=("Sans", 9, "bold"),
        ).grid(row=2, column=0, columnspan=2, sticky="w", padx=12, pady=(0, 10))

        output_panel = self.card(self.content, padx=22, pady=8, expand=True)
        self.set_output(output_panel, height=16)
        bar = tk.Frame(self.content, bg=BG)
        bar.pack(fill="x", padx=28, pady=(0, 14))
        self.action_button(bar, "STOP TASK", self.stop_job).pack(side="left")

        def start_catalogue() -> None:
            name, spec = selected_spec()
            try:
                require_catalog_tool(specs, name)
                args = build_catalog_command(specs, name, target.get())
            except (ValueError, FileNotFoundError) as exc:
                messagebox.showerror(title, str(exc), parent=self.root)
                return
            if not authorized.get():
                messagebox.showwarning(
                    "Authorization required",
                    "Confirm authorization before this tool starts.",
                    parent=self.root,
                )
                return
            shown = " ".join(shlex.quote(part) for part in args)
            if spec["mode"] == "launch":
                prompt = f"{name} will open without a target, scan, capture, or exploit selected.\n\n{shown}"
            else:
                prompt = f"{name} will run only this command.\n\n{shown}\n\nContinue only if this is authorized."
            if not messagebox.askyesno("Confirm authorized action", prompt, parent=self.root):
                return
            if spec["ui"] == "gui":
                try:
                    subprocess.Popen(args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
                except OSError as exc:
                    messagebox.showerror(title, str(exc), parent=self.root)
                return
            if spec["ui"] == "terminal":
                self.open_terminal(args, f"TraceOS {name}")
                return
            self.run_job(args, name)

        self.action_button(bar, "START", start_catalogue, primary=True).pack(side="right")

    def engagement(self) -> None:
        self.activate_nav("Engagement")
        from engagement import PLAYBOOKS, build_playbook

        self.heading(
            "RED / BLUE / PURPLE",
            "Engagement",
            "A full scoped exercise. Red checks attack only the target you enter. Blue checks this machine. Purple records what should have been detected.",
        )
        notice = self.card(self.content, padx=28, pady=7)
        tk.Label(
            notice, text="NO DENIAL-OF-SERVICE TOOLING",
            bg=CARD, fg=WARN, font=("Sans", 9, "bold")
        ).pack(anchor="w", padx=15, pady=(10, 1))
        tk.Label(
            notice,
            text="Masscan is capped at 1000 packets per second. Password cracking uses the wordlists already stored in /usr/share/traceos/wordlists, starting with rockyou.txt, and does not download one. Nuclei excludes denial-of-service tags. Select a case first so the exercise is written to the purple ledger.",
            bg=CARD, fg=MUTED, wraplength=820, justify="left", font=("Sans", 9)
        ).pack(anchor="w", padx=15, pady=(0, 10))

        controls = self.card(self.content, padx=22, pady=8)
        labels = [f"{spec['team']}  {spec['title']}" for spec in PLAYBOOKS.values()]
        ids = list(PLAYBOOKS)
        tk.Label(controls, text="ENGAGEMENT", bg=CARD, fg=MUTED, font=("Sans", 8, "bold")).grid(
            row=0, column=0, sticky="w", padx=12, pady=(10, 4)
        )
        choice = ttk.Combobox(controls, state="readonly", values=tuple(labels), style="Trace.TCombobox")
        choice.current(0)
        choice.grid(row=1, column=0, sticky="ew", padx=12, pady=(0, 10))
        target_label = tk.Label(controls, text="AUTHORIZED TARGET", bg=CARD, fg=MUTED, font=("Sans", 8, "bold"))
        target_label.grid(row=0, column=1, sticky="w", padx=8, pady=(10, 4))
        target = tk.Entry(controls, bg="#0e2a4e", fg=TEXT, insertbackground=ACCENT, relief="flat", font=("Monospace", 10))
        target.grid(row=1, column=1, sticky="ew", padx=8, pady=(0, 10))
        service_label = tk.Label(controls, text="SERVICE", bg=CARD, fg=MUTED, font=("Sans", 8, "bold"))
        service_label.grid(row=2, column=0, sticky="w", padx=12, pady=(0, 4))
        service = ttk.Combobox(
            controls, state="readonly",
            values=("ssh", "ftp", "smb", "rdp", "http-get", "https-get", "ldap2", "mssql"),
            style="Trace.TCombobox",
        )
        service.current(0)
        service.grid(row=3, column=0, sticky="ew", padx=12, pady=(0, 10))
        users_label = tk.Label(controls, text="USERS FILE", bg=CARD, fg=MUTED, font=("Sans", 8, "bold"))
        users_label.grid(row=2, column=1, sticky="w", padx=8, pady=(0, 4))
        users = tk.Entry(controls, bg="#0e2a4e", fg=TEXT, insertbackground=ACCENT, relief="flat", font=("Monospace", 10))
        users.grid(row=3, column=1, sticky="ew", padx=8, pady=(0, 10))
        passwords_label = tk.Label(controls, text="PASSWORDS FILE", bg=CARD, fg=MUTED, font=("Sans", 8, "bold"))
        passwords_label.grid(row=4, column=0, sticky="w", padx=12, pady=(0, 4))
        passwords = tk.Entry(controls, bg="#0e2a4e", fg=TEXT, insertbackground=ACCENT, relief="flat", font=("Monospace", 10))
        passwords.grid(row=5, column=0, columnspan=2, sticky="ew", padx=12, pady=(0, 10))
        controls.grid_columnconfigure(0, weight=2)
        controls.grid_columnconfigure(1, weight=4)
        detail = tk.Label(self.content, text="", bg=BG, fg=MUTED, justify="left", font=("Sans", 8), wraplength=860)
        detail.pack(anchor="w", padx=30, pady=(0, 6))

        def selected_id() -> str:
            return ids[labels.index(choice.get())]

        def refresh_detail(_event=None) -> None:
            spec = PLAYBOOKS[selected_id()]
            names = ", ".join(step["name"] for step in spec["steps"])
            detail.configure(
                text=f"{spec['technique']}  •  {spec['expected']}\nSteps: {names}"
            )
            local = spec["mode"] == "local"
            files = spec["mode"] in {"auth", "crack"}
            target.configure(state="disabled" if local or spec["mode"] == "crack" else "normal")
            service.configure(state="normal" if spec["mode"] == "crack" else ("readonly" if files else "disabled"))
            users.configure(state="normal" if files else "disabled")
            passwords.configure(state="normal" if files else "disabled")
            if spec["mode"] == "person":
                target_label.configure(text="USERNAME")
            elif spec["mode"] == "email":
                target_label.configure(text="EMAIL")
            elif spec["mode"] == "phone":
                target_label.configure(text="PHONE NUMBER")
            elif local or spec["mode"] == "crack":
                target_label.configure(text="NO NETWORK TARGET")
            else:
                target_label.configure(text="AUTHORIZED TARGET")
            if spec["mode"] == "crack":
                service_label.configure(text="HASHCAT MODE")
                users_label.configure(text="HASH FILE")
                passwords_label.configure(text="WORDLIST")
                if not passwords.get().strip():
                    passwords.insert(0, "/usr/share/traceos/wordlists/rockyou.txt")
            else:
                service_label.configure(text="SERVICE")
                users_label.configure(text="USERS FILE")
                passwords_label.configure(text="PASSWORDS FILE")

        choice.bind("<<ComboboxSelected>>", refresh_detail)
        refresh_detail()
        authorized = tk.BooleanVar(value=False)
        tk.Checkbutton(
            controls,
            text="I own this target or have written authorization for this engagement.",
            variable=authorized, bg=CARD, fg=WARN, activebackground=CARD,
            activeforeground=WARN, selectcolor=BG2, font=("Sans", 9, "bold"),
        ).grid(row=6, column=0, columnspan=2, sticky="w", padx=12, pady=(0, 10))
        output_panel = self.card(self.content, padx=22, pady=8, expand=True)
        self.set_output(output_panel, height=12)
        bar = tk.Frame(self.content, bg=BG)
        bar.pack(fill="x", padx=28, pady=(0, 14))
        self.action_button(bar, "STOP TASK", self.stop_job).pack(side="left")

        def start_engagement() -> None:
            playbook_id = selected_id()
            if playbook_id == "purple-canary":
                steps = []
                title = "Purple detection canary"
            else:
                try:
                    steps = build_playbook(
                        playbook_id,
                        target.get(),
                        users.get(),
                        passwords.get(),
                        service.get() or "ssh",
                    )
                except ValueError as exc:
                    messagebox.showerror("Engagement", str(exc), parent=self.root)
                    return
                title = steps[0]["title"]
            shown = format_engagement_preview(playbook_id, steps)
            if not authorized.get():
                messagebox.showwarning(
                    "Authorization required",
                    "Confirm written authorization before this engagement starts.",
                    parent=self.root,
                )
                return
            if not messagebox.askyesno(
                "Confirm engagement",
                f"{title} will run these commands and record a purple exercise.\n\n{shown}",
                parent=self.root,
            ):
                return
            env = os.environ.copy()
            env["TRACEOS_ENGAGE_AUTHORIZED"] = "1"
            args = [
                sys.executable,
                "/usr/local/bin/traceos-engage",
                "canary" if playbook_id == "purple-canary" else "run",
                *([] if playbook_id == "purple-canary" else [
                    playbook_id,
                    target.get().strip(),
                    service.get() or "ssh",
                    users.get().strip(),
                    passwords.get().strip(),
                ]),
            ]
            if self.active_action_id is not None or (
                self.active_process and self.active_process.poll() is None
            ):
                messagebox.showinfo("TraceOS", "A task is already running. Stop it before starting another.", parent=self.root)
                return
            job_token = uuid.uuid4().hex
            self.active_job_token = job_token
            self.active_job_label = title
            self.active_job_kind = "engagement"
            self.active_job_attempt = None
            self.job_output = f"[TraceOS] Starting engagement: {title}\n\n"
            if self.output_widget:
                self.set_text(self.output_widget, self.job_output)
            try:
                process = subprocess.Popen(
                    args,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.STDOUT,
                    text=True,
                    bufsize=1,
                    env=env,
                    start_new_session=True,
                )
                self.active_process = process
            except OSError as exc:
                self.active_job_token = None
                self.active_process = None
                messagebox.showerror("Engagement", str(exc), parent=self.root)
                return
            threading.Thread(
                target=self._read_active_output,
                args=(process, job_token),
                daemon=True,
            ).start()
            self.root.after(80, self.poll_job)

        self.action_button(bar, "RUN ENGAGEMENT", start_engagement, primary=True).pack(side="right")

    def _read_active_output(self, process, token: str) -> None:
        if process.stdout:
            for line in process.stdout:
                self.output_queue.put((token, line))
        self.output_queue.put((token, None))

    def assessment(self) -> None:
        self.activate_nav("Assessment")
        self._tool_catalogue_page(
            ASSESSMENT_TOOL_SPECS,
            "AUTHORIZED ASSESSMENT",
            "Assessment",
