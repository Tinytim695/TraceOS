#!/usr/bin/env python3
"""TraceOS Control Centre: a polished local-first investigation cockpit."""
from __future__ import annotations

import json
import os
import queue
import shlex
import shutil
import subprocess
import sys
import time
import threading
import tkinter as tk
import uuid
import webbrowser
from pathlib import Path
from tkinter import filedialog, messagebox, ttk

from traceos_case import CaseCreatedButNotSelected, CaseError, CaseStore

TRACE = "/usr/local/bin/traceos"
SESSION = "/usr/local/bin/traceos-session"

BG = "#050811"
BG2 = "#07101c"
PANEL = "#091321"
CARD = "#0d1928"
CARD2 = "#102238"
CARD3 = "#142b45"
TEXT = "#eaf6ff"
MUTED = "#7895b5"
ACCENT = "#72f1e8"
ACCENT2 = "#50b8ff"
PURPLE = "#9c7bff"
GOOD = "#72e6a7"
WARN = "#f0c674"
DANGER = "#ff7b85"
BORDER = "#1b3550"


def capture(args: list[str], timeout: int = 8) -> subprocess.CompletedProcess[str] | None:
    try:
        return subprocess.run(args, capture_output=True, text=True, check=False, timeout=timeout)
    except (OSError, subprocess.SubprocessError):
        return None


CASE_STORE = CaseStore()

def case_path() -> Path | None:
    try:
        record = CASE_STORE.current()
    except CaseError:
        return None
    return record.path if record else None


def case_name(path: Path | None) -> str:
    if not path:
        return "No active case"
    try:
        return CASE_STORE.read(path).title
    except CaseError:
        return path.name


def network_state() -> str:
    result = capture(["nmcli", "-t", "-f", "STATE", "general"])
    if result and result.stdout.strip():
        return result.stdout.strip().splitlines()[0].upper()
    return "UNKNOWN"


def session_state() -> str:
    result = capture([SESSION, "mode"])
    if result and result.returncode == 0 and result.stdout.strip():
        return result.stdout.strip().upper()
    return "UNKNOWN"


class TraceOSApp:
    def __init__(self, root: tk.Tk, welcome: bool = False, start_page: str = "dashboard") -> None:
        self.root = root
        self.root.title("TraceOS Control Centre")
        screen_w = self.root.winfo_screenwidth()
        screen_h = self.root.winfo_screenheight()
        width = min(1360, max(900, screen_w - 40))
        height = min(860, max(600, screen_h - 70))
        self.root.geometry(f"{width}x{height}")
        self.root.minsize(min(1080, width), min(720, height))
        self.root.configure(bg=BG)
        self.root.option_add("*Font", "{DejaVu Sans} 10")
        try:
            self.root.state("zoomed")
        except tk.TclError:
            pass
        self.root.after(1800, self._write_ready_marker)
        self.root.protocol("WM_DELETE_WINDOW", self.root.destroy)

        self._trace_nonce = uuid.uuid4().hex
        self._trace_attempt = 0
        self._new_case_attempt_pending = False

        # User-facing smoke-test shortcut: open the same OSINT page as the sidebar button.
        # Tk keysyms are case-sensitive here; Ctrl+Shift+O produces keysym ``O``.
        self.root.bind_all("<Control-Shift-O>", self._osint_shortcut)
        self.root.bind_all("<Control-Shift-N>", self._new_case_shortcut)
        self.root.bind_all("<Control-Shift-I>", self._image_shortcut)

        self.active_process: subprocess.Popen[str] | None = None
        self.active_job_label: str | None = None
        self.active_job_kind: str | None = None
        self.active_job_attempt: int | None = None
        self.output_queue: queue.Queue[str | None] = queue.Queue()
        self.job_output = ""
        self.output_widget: tk.Text | None = None
        self.welcome = welcome

        self.setup_styles()
        self.build_shell()

        pages = {
            "dashboard": self.dashboard,
            "evidence": self.evidence,
            "network": self.network,
            "osint": self.osint,
            "reports": self.reports,
            "timeline": self.timeline,
            "doctor": self.doctor_page,
        }
        pages.get(start_page, self.dashboard)()
        self._trace_diag("CONTROL_CENTRE_SESSION_READY")

    def _trace_active_window(self) -> str:
        result = capture(["xprop", "-root", "_NET_ACTIVE_WINDOW"], timeout=2)
        if not result or result.returncode != 0:
            return "unavailable"
        value = " ".join(result.stdout.strip().split())
        return value or "unavailable"

    def _trace_focus(self) -> str:
        try:
            widget = self.root.focus_get()
            if widget is None:
                return "none"
            return f"{widget.winfo_class()}:{widget}"
        except tk.TclError:
            return "unavailable"

    def _trace_diag(self, stage: str, **fields: object) -> None:
        parts = [
            f"stage={stage}",
            f"nonce={self._trace_nonce}",
            f"pid={os.getpid()}",
            f"uid={os.getuid()}",
            f"attempt={self._trace_attempt}",
        ]
        for key, value in fields.items():
            safe = " ".join(str(value).replace("\n", " ").replace("\r", " ").split())
            parts.append(f"{key}={safe}")
        line = f"[TraceOS] UI_DIAG {time.strftime('%Y-%m-%dT%H:%M:%S%z')} " + " ".join(parts)

        log_path = Path.home() / ".cache" / "traceos" / "control-centre-ui.log"
        try:
            log_path.parent.mkdir(parents=True, exist_ok=True)
            with log_path.open("a", encoding="utf-8") as handle:
                handle.write(line + "\n")
        except OSError:
            pass

        # Best-effort CI evidence channel. Failure to write to the guest serial
        # device must never break the normal GUI or user-facing interaction.
        try:
            fd = os.open("/dev/ttyS0", os.O_WRONLY | os.O_NOCTTY | os.O_NONBLOCK)
            try:
                os.write(fd, (line + "\n").encode("utf-8"))
            finally:
                os.close(fd)
        except OSError:
            pass

        print(line, file=sys.stderr, flush=True)

    def _new_case_shortcut(self, event: tk.Event) -> str:
        self._trace_attempt += 1
        self._new_case_attempt_pending = True
        try:
            widget = self.root.focus_get()
            focus_class = widget.winfo_class() if widget is not None else "none"
        except tk.TclError:
            focus_class = "unavailable"
        self._trace_diag(
            "NEW_CASE_INPUT_RECEIVED",
            keysym=getattr(event, "keysym", "unknown"),
            state=getattr(event, "state", "unknown"),
            focus_class=focus_class,
        )
        self.new_case()
        return "break"

    def _image_shortcut(self, event: tk.Event) -> str:
        self._trace_attempt += 1
        self._trace_diag("IMAGE_PAGE_SHORTCUT_RECEIVED", attempt=self._trace_attempt)
        self.image_osint()
        return "break"
    def _osint_shortcut(self, event: tk.Event) -> str:
        self._trace_diag(
            "shortcut-received",
            keysym=getattr(event, "keysym", "unknown"),
            state=getattr(event, "state", "unknown"),
            focus=self._trace_focus(),
            active_window=self._trace_active_window(),
        )
        self._trace_diag("callback-entered", callback="osint")
        try:
            self.osint()
        except Exception as exc:
            self._trace_diag(
                "callback-exception",
                callback="osint",
                exc_type=type(exc).__name__,
                message=str(exc),
            )
            raise
        self._trace_diag("callback-complete", callback="osint")
        return "break"

    def _write_ready_marker(self) -> None:
        marker = Path("/tmp/traceos-control-centre.ready")
        try:
            self.root.update_idletasks()
            marker.write_text("TRACEOS_CONTROL_CENTRE_READY\\n", encoding="utf-8")
        except OSError:
            pass

    def refresh_case_context(self) -> None:
        self.refresh_case_header()
        self._trace_diag("case-context-refreshed")

    def refresh_case_header(self) -> None:
        if not hasattr(self, "header_case"):
            return
        try:
            record = CASE_STORE.current()
        except CaseError as exc:
            self.header_case.configure(
                text=f"CASE ERROR  •  {exc}",
                fg=DANGER,
            )
            return
        if record is None:
            self.header_case.configure(
                text="NO ACTIVE CASE  •  ~/Cases IS EPHEMERAL IN AMNESIC LIVE SESSIONS",
                fg=WARN,
            )
            return
        identifier = "LEGACY" if record.legacy else record.case_id[:8]
        self.header_case.configure(
            text=f"CASE  •  {record.title}  •  {identifier}",
            fg=GOOD,
        )

    def setup_styles(self) -> None:
        style = ttk.Style(self.root)
        try:
            style.theme_use("clam")
        except tk.TclError:
            pass
        style.configure(
            "Trace.TCombobox",
            fieldbackground="#08111d",
            background=CARD2,
            foreground=TEXT,
            bordercolor=BORDER,
            arrowcolor=ACCENT,
            padding=7,
        )
        style.map(
            "Trace.TCombobox",
            fieldbackground=[("readonly", "#08111d")],
            foreground=[("readonly", TEXT)],
        )
        style.configure(
            "Trace.Treeview",
            background="#08111d",
            fieldbackground="#08111d",
            foreground=TEXT,
            rowheight=30,
            borderwidth=0,
            relief="flat",
        )
        style.map(
            "Trace.Treeview",
            background=[("selected", CARD3)],
            foreground=[("selected", ACCENT)],
        )
        style.configure(
            "Trace.Treeview.Heading",
            background=PANEL,
            foreground=MUTED,
            relief="flat",
            borderwidth=0,
            font=("Sans", 9, "bold"),
        )

    def build_shell(self) -> None:
        header = tk.Frame(self.root, bg=PANEL, height=82)
        header.pack(fill="x", side="top")
        header.pack_propagate(False)

        logo_path = Path("/usr/share/traceos/traceos-logo.png")
        if logo_path.exists():
            try:
                self.logo = tk.PhotoImage(file=str(logo_path))
                if self.logo.width() > 52:
                    factor = max(1, self.logo.width() // 48)
                    self.logo = self.logo.subsample(factor)
                tk.Label(header, image=self.logo, bg=PANEL).pack(side="left", padx=(18, 10))
            except tk.TclError:
                pass

        brand = tk.Frame(header, bg=PANEL)
        brand.pack(side="left", fill="y", pady=12)
        tk.Label(
            brand, text="TRACEOS", bg=PANEL, fg=TEXT,
            font=("Sans", 21, "bold")
        ).pack(anchor="w")
        tk.Label(
            brand, text="Digital Investigation Workstation",
            bg=PANEL, fg=MUTED, font=("Sans", 9)
        ).pack(anchor="w")

        self.header_case = tk.Label(
            header, text="LOCAL-FIRST  •  NO BUILT-IN TELEMETRY",
            bg=PANEL, fg=GOOD, font=("Sans", 8, "bold")
        )
        self.header_case.pack(side="left", padx=28)

        self.small_button(header, "QUICK SHADE", self.quick_shade, side="right")
        self.small_button(header, "REFRESH CASE", self.refresh_case_context, side="right")
        self.small_button(header, "SELECT CASE", self.select_case, side="right")
        self.small_button(header, "NEW CASE", self.new_case, side="right", primary=True)
        self.refresh_case_header()

        body = tk.Frame(self.root, bg=BG)
        body.pack(fill="both", expand=True)

        self.sidebar = tk.Frame(body, bg=PANEL, width=220)
        self.sidebar.pack(side="left", fill="y")
        self.sidebar.pack_propagate(False)

        tk.Label(
            self.sidebar, text="WORKSPACE", bg=PANEL, fg=MUTED,
            font=("Sans", 8, "bold")
        ).pack(anchor="w", padx=18, pady=(20, 7))

        for label, page in [
            ("◉  Dashboard", self.dashboard),
            ("▣  Evidence Vault", self.evidence),
            ("⌁  Network", self.network),
            ("◎  Investigation Centre", self.osint),
            ("▤  Reports", self.reports),
            ("▥  Timeline", self.timeline),
        ]:
            self.nav_button(label, page)

        tk.Label(
            self.sidebar, text="SYSTEM", bg=PANEL, fg=MUTED,
            font=("Sans", 8, "bold")
        ).pack(anchor="w", padx=18, pady=(19, 7))

        for label, action in [
            ("⌘  Terminal", lambda: self.open_terminal(["bash"], "TraceOS Terminal")),
            ("▸  Trace Console", lambda: self.open_terminal([TRACE, "status"], "TraceOS Console")),
            ("★  Trace AI", lambda: self.open_terminal([TRACE, "ai"], "Trace AI")),
            ("◇  Demo Lab", lambda: self.open_terminal([TRACE, "demo"], "TraceOS Demo Lab")),
            ("⚙  System Doctor", self.doctor_page),
        ]:
            self.nav_button(label, action)

        tk.Label(
            self.sidebar,
            text="TRACEOS 0.1.0\nLocal-first • user-invoked external actions",
            bg=PANEL, fg=MUTED, justify="left", font=("Sans", 8)
        ).pack(anchor="w", padx=18, pady=(25, 10))

        self.content = tk.Frame(body, bg=BG)
        self.content.pack(side="left", fill="both", expand=True)

        status = tk.Frame(self.root, bg="#06111d", height=30)
        status.pack(fill="x", side="bottom")
        status.pack_propagate(False)
        tk.Label(
            status,
            text="TRACEOS 0.1.0   •   LOCAL-FIRST   •   USER-INVOKED EXTERNAL ACTIONS   •   CASE DATA STAYS ON THIS MACHINE",
            bg="#06111d", fg=MUTED, font=("Sans", 8, "bold")
        ).pack(side="left", padx=18, pady=7)
        tk.Label(
            status, text="● READY", bg="#06111d", fg=GOOD,
            font=("Sans", 8, "bold")
        ).pack(side="right", padx=18, pady=7)

    def small_button(self, parent: tk.Widget, text: str, command, side: str = "left", primary: bool = False) -> None:
        bg = ACCENT if primary else CARD2
        fg = "#041016" if primary else TEXT
        tk.Button(
            parent, text=text, command=command, bg=bg, fg=fg,
            activebackground=ACCENT2 if not primary else ACCENT,
            activeforeground="#041016", relief="flat", bd=0,
            font=("Sans", 9, "bold"), padx=13, pady=7
        ).pack(side=side, padx=7, pady=17)

    def nav_button(self, text: str, command) -> None:
        tk.Button(
            self.sidebar, text=text, command=command, anchor="w",
            bg=PANEL, fg=TEXT, activebackground=CARD2,
            activeforeground=ACCENT, relief="flat", bd=0,
            font=("Sans", 10), padx=18, pady=10
        ).pack(fill="x")

    def clear(self) -> None:
        for widget in self.content.winfo_children():
            widget.destroy()
        self.output_widget = None

    def heading(self, kicker: str, title: str, subtitle: str) -> tk.Frame:
        self.clear()
        top = tk.Frame(self.content, bg=BG)
        top.pack(fill="x", padx=28, pady=(24, 8))
        tk.Label(top, text=kicker.upper(), bg=BG, fg=ACCENT, font=("Sans", 8, "bold")).pack(anchor="w")
        tk.Label(top, text=title, bg=BG, fg=TEXT, font=("Sans", 24, "bold")).pack(anchor="w", pady=(1, 0))
        tk.Label(top, text=subtitle, bg=BG, fg=MUTED, font=("Sans", 10)).pack(anchor="w", pady=(2, 0))
        return top

    def card(self, parent: tk.Widget, padx: int = 0, pady: int = 0, expand: bool = False) -> tk.Frame:
        box = tk.Frame(
            parent, bg=CARD, highlightthickness=1,
            highlightbackground=BORDER, bd=0
        )
        box.pack(fill="both" if expand else "x", expand=expand, padx=padx, pady=pady)
        return box

    def action_button(self, parent: tk.Widget, text: str, command, primary: bool = False) -> tk.Button:
        return tk.Button(
            parent, text=text, command=command,
            bg=ACCENT if primary else CARD2,
            fg="#041016" if primary else TEXT,
            activebackground=ACCENT2 if not primary else ACCENT,
            activeforeground="#041016",
            relief="flat", bd=0, font=("Sans", 9, "bold"),
            padx=13, pady=7
        )

    def set_output(self, parent: tk.Widget, height: int = 16) -> tk.Text:
        text = tk.Text(
            parent, bg="#07101c", fg=TEXT, insertbackground=ACCENT,
            selectbackground=CARD3, selectforeground=TEXT,
            relief="flat", bd=0, wrap="word", font=("Monospace", 9),
            height=height
        )
        text.pack(fill="both", expand=True, padx=14, pady=14)
        self.output_widget = text
        if self.job_output:
            text.insert("1.0", self.job_output)
        return text

    def set_text(self, widget: tk.Text, value: str) -> None:
        widget.configure(state="normal")
        widget.delete("1.0", "end")
        widget.insert("1.0", value)
        widget.configure(state="disabled")

    def open_terminal(self, args: list[str], title: str) -> None:
        try:
            subprocess.Popen(["xfce4-terminal", f"--title={title}", "--execute", *args])
        except OSError as exc:
            messagebox.showerror(title, str(exc), parent=self.root)

    def open_path(self, path: Path) -> None:
        if not path.exists():
            messagebox.showerror("TraceOS", f"Path not found:\n{path}", parent=self.root)
            return
        if shutil.which("xdg-open"):
            try:
                subprocess.Popen(["xdg-open", str(path)])
            except OSError as exc:
                messagebox.showerror("TraceOS", str(exc), parent=self.root)

    def quick_shade(self) -> None:
        try:
            subprocess.Popen(["/usr/local/bin/traceos-shade"])
        except OSError as exc:
            messagebox.showerror("TraceOS Quick Shade", str(exc), parent=self.root)

    def run_job(self, args: list[str], label: str = "TraceOS", *, kind: str | None = None, attempt: int | None = None) -> None:
        if self.active_process and self.active_process.poll() is None:
            messagebox.showinfo("TraceOS", "A task is already running. Stop it before starting another.", parent=self.root)
            return
        self.active_job_label = label
        self.active_job_kind = kind
        self.active_job_attempt = attempt
        self.job_output = f"[TraceOS] Starting: {label}\n$ {' '.join(shlex.quote(x) for x in args)}\n\n"
        if self.output_widget:
            self.set_text(self.output_widget, self.job_output)
        try:
            self.active_process = subprocess.Popen(
                args, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                text=True, bufsize=1
            )
            self._trace_diag(
                "TASK_STARTED",
                task=self.active_job_label or "unknown",
                kind=self.active_job_kind or "generic",
                pid=self.active_process.pid,
                attempt=self.active_job_attempt if self.active_job_attempt is not None else "none",
            )
            if self.active_job_kind == "image":
                self._trace_diag("IMAGE_CLI_STARTED", pid=self.active_process.pid, attempt=self.active_job_attempt or 0)
        except OSError as exc:
            self.job_output += f"[TraceOS] Unable to start task: {exc}\n"
            if self.output_widget:
                self.set_text(self.output_widget, self.job_output)
            return

        def reader() -> None:
            assert self.active_process is not None
            if self.active_process.stdout:
                for line in self.active_process.stdout:
                    self.output_queue.put(line)
            self.output_queue.put(None)

        threading.Thread(target=reader, daemon=True).start()
        self.root.after(80, self.poll_job)

    def poll_job(self) -> None:
        finished = False
        while True:
            try:
                item = self.output_queue.get_nowait()
            except queue.Empty:
                break
            if item is None:
                finished = True
                continue
            self.job_output += item
            if len(self.job_output) > 50000:
                self.job_output = self.job_output[-50000:]
            if self.output_widget and self.output_widget.winfo_exists():
                self.output_widget.configure(state="normal")
                self.output_widget.delete("1.0", "end")
                self.output_widget.insert("1.0", self.job_output)
                self.output_widget.see("end")
                self.output_widget.configure(state="disabled")
        if finished:
            code = self.active_process.poll() if self.active_process else 0
            self.job_output += f"\n[TraceOS] Task finished with exit code {code}.\n"
            if self.output_widget and self.output_widget.winfo_exists():
                self.output_widget.insert("end", f"\n[TraceOS] Task finished with exit code {code}.\n")
            finished_kind = self.active_job_kind
            finished_attempt = self.active_job_attempt
            self._trace_diag("TASK_COMPLETED", task=self.active_job_label or "unknown", exit_code=code, attempt=finished_attempt if finished_attempt is not None else "none")
            if finished_kind == "image":
                start = self.job_output.find("{\n")
                end_marker = "\n[TraceOS] Task finished with exit code"
                end = self.job_output.find(end_marker, start)
                payload = self.job_output[start:end] if start >= 0 and end > start else ""
                try:
                    parsed = json.loads(payload)
                except (TypeError, ValueError):
                    parsed = None
                if parsed is not None and self.output_widget and self.output_widget.winfo_exists():
                    self._trace_diag(
                        "IMAGE_RESULT_RENDERED",
                        attempt=finished_attempt if finished_attempt is not None else 0,
                        status=parsed.get("status", "unknown"),
                        sha256=parsed.get("sha256_after", parsed.get("sha256_before", "unknown")),
                        exit_code=code,
                    )
                self._trace_diag(
                    "IMAGE_CLI_COMPLETED",
                    attempt=finished_attempt if finished_attempt is not None else 0,
                    exit_code=code,
                )
            self.active_process = None
            self.active_job_label = None
            self.active_job_kind = None
            self.active_job_attempt = None
            return
        if self.active_process and self.active_process.poll() is None:
            self.root.after(80, self.poll_job)

    def stop_job(self) -> None:
        if self.active_process and self.active_process.poll() is None:
            self.active_process.terminate()
            self._trace_diag("TASK_STOPPED", task=self.active_job_label or "unknown", kind=self.active_job_kind or "generic", attempt=self.active_job_attempt if self.active_job_attempt is not None else "none")
            if self.active_job_kind == "image":
                self._trace_diag("IMAGE_CLI_STOPPED", attempt=self.active_job_attempt or 0)
            self.job_output += "\n[TraceOS] Task stopped by user.\n"
            if self.output_widget:
                self.set_text(self.output_widget, self.job_output)

    def dashboard(self) -> None:
        top = self.heading(
            "TraceOS", "Investigation cockpit",
            "One polished front door for cases, evidence, network, OSINT and reporting."
        )
        if self.welcome:
            banner = tk.Frame(top, bg="#0c2232", highlightthickness=1, highlightbackground="#1c6571")
            banner.pack(fill="x", pady=(14, 0))
            tk.Label(
                banner, text="WELCOME TO TRACEOS",
                bg="#0c2232", fg=ACCENT, font=("Sans", 9, "bold")
            ).pack(anchor="w", padx=16, pady=(10, 1))
            tk.Label(
                banner, text="Start with a new case or open Demo Lab to explore safely.",
                bg="#0c2232", fg=TEXT, font=("Sans", 10)
            ).pack(anchor="w", padx=16, pady=(0, 10))

        row = tk.Frame(self.content, bg=BG)
        row.pack(fill="x", padx=23, pady=(8, 8))
        try:
            current = CASE_STORE.current()
            entries = CASE_STORE.list_cases()
            current_label = (
                f"{current.title}  •  {current.case_id[:8]}"
                if current and current.case_id
                else current.title if current else "No active case"
            )
            if current and current.legacy:
                current_label = f"{current.title}  •  LEGACY"
            count = sum(1 for entry in entries if entry.record)
            case_error = None
        except CaseError as exc:
            current_label = "Case state error"
            count = 0
            case_error = str(exc)

        values = [
            ("CURRENT CASE", current_label, ACCENT if not case_error else DANGER),
            ("CASE WORKSPACES", str(count), ACCENT2),
            ("NETWORK", network_state(), GOOD),
            ("SESSION", session_state(), PURPLE),
        ]
        for title, value, color in values:
            tile = tk.Frame(row, bg=CARD, highlightthickness=1, highlightbackground=BORDER)
            tile.pack(side="left", fill="both", expand=True, padx=5)
            tk.Label(tile, text=title, bg=CARD, fg=MUTED, font=("Sans", 8, "bold")).pack(anchor="w", padx=14, pady=(12, 3))
            tk.Label(tile, text=value, bg=CARD, fg=color, font=("Sans", 12, "bold"), wraplength=220).pack(anchor="w", padx=14, pady=(0, 12))

        lower = tk.Frame(self.content, bg=BG)
        lower.pack(fill="both", expand=True, padx=28, pady=8)

        flow = self.card(lower, expand=True)
        flow.pack(side="left", fill="both", expand=True, padx=(0, 6), pady=0)
        flow.pack_propagate(False)
        launch = self.card(lower, expand=True)
        launch.pack(side="left", fill="both", expand=True, padx=(6, 0), pady=0)
        launch.pack_propagate(False)

        tk.Label(flow, text="INVESTIGATION FLOW", bg=CARD, fg=MUTED, font=("Sans", 9, "bold")).pack(anchor="w", padx=18, pady=(17, 9))
        if case_error:
            tk.Label(
                flow,
                text=f"CASE STATE ERROR: {case_error}",
                bg="#26131a",
                fg=DANGER,
                font=("Sans", 8, "bold"),
                wraplength=480,
                justify="left",
            ).pack(fill="x", padx=16, pady=(4, 8))

        steps = [
            ("01  Start / select case", "Create a case or choose an existing workspace.", self.select_case),
            ("02  Add evidence", "Vault a copy and record its SHA-256.", self.add_evidence),
            ("03  Analyse locally", "Inspect files without uploading them.", self.analyse_evidence),
            ("04  Generate report", "Write a readable Markdown case report.", self.generate_report),
        ]
        for title, desc, action in steps:
            item = tk.Frame(flow, bg=CARD2)
            item.pack(fill="x", padx=16, pady=4)
            tk.Button(item, text=title, command=action, bg=CARD2, fg=TEXT, activebackground=CARD3,
                      activeforeground=ACCENT, relief="flat", bd=0, anchor="w",
                      font=("Sans", 10, "bold")).pack(fill="x", padx=12, pady=(9, 0))
            tk.Label(item, text=desc, bg=CARD2, fg=MUTED, font=("Sans", 8)).pack(anchor="w", padx=12, pady=(0, 9))

        tk.Label(launch, text="QUICK LAUNCH", bg=CARD, fg=MUTED, font=("Sans", 9, "bold")).pack(anchor="w", padx=18, pady=(17, 9))
        for title, action in [
            ("→  Evidence Vault", self.evidence),
            ("→  Network Command Centre", self.network),
            ("→  OSINT Centre", self.osint),
            ("→  Reports", self.reports),
            ("→  Timeline", self.timeline),
            ("→  System Doctor", self.doctor_page),
        ]:
            tk.Button(launch, text=title, command=action, bg=CARD2, fg=TEXT,
                      activebackground=CARD3, activeforeground=ACCENT,
                      relief="flat", bd=0, anchor="w", font=("Sans", 10)).pack(
                fill="x", padx=16, pady=4, ipady=6
            )

    def new_case(self) -> None:
        if not self._new_case_attempt_pending:
            self._trace_attempt += 1
        self._new_case_attempt_pending = False
        dialog = tk.Toplevel(self.root)
        dialog.title("New TraceOS Case")
        dialog.configure(bg=BG)
        dialog.transient(self.root)
        dialog.grab_set()
        dialog.resizable(True, True)
        dialog.geometry("560x390")

        tk.Label(
            dialog,
            text="NEW CASE",
            bg=BG,
            fg=ACCENT,
            font=("Sans", 16, "bold"),
        ).pack(anchor="w", padx=24, pady=(22, 3))
        tk.Label(
            dialog,
            text="Create a private case workspace and make it the active case.",
            bg=BG,
            fg=MUTED,
            font=("Sans", 9),
        ).pack(anchor="w", padx=24, pady=(0, 14))

        form = self.card(dialog, padx=18, pady=10)
        form.pack(fill="both", expand=True, padx=20, pady=(0, 12))

        tk.Label(
            form,
            text="CASE TITLE",
            bg=CARD,
            fg=MUTED,
            font=("Sans", 8, "bold"),
        ).pack(anchor="w", padx=14, pady=(10, 4))
        title_entry = tk.Entry(
            form,
            bg="#08111d",
            fg=TEXT,
            insertbackground=ACCENT,
            relief="flat",
            font=("Sans", 10),
        )
        title_entry.pack(fill="x", padx=14, pady=(0, 12))

        tk.Label(
            form,
            text="DESCRIPTION",
            bg=CARD,
            fg=MUTED,
            font=("Sans", 8, "bold"),
        ).pack(anchor="w", padx=14, pady=(0, 4))
        description = tk.Text(
            form,
            height=6,
            bg="#08111d",
            fg=TEXT,
            insertbackground=ACCENT,
            relief="flat",
            font=("Sans", 9),
            wrap="word",
        )
        description.pack(fill="both", expand=True, padx=14, pady=(0, 10))

        tk.Label(
            form,
            text="Authoritative metadata is stored in case.json. "
                 "In an amnesic live session, ~/Cases does not survive reboot "
                 "unless deliberately saved to persistent storage.",
            bg=CARD,
            fg=MUTED,
            font=("Sans", 8),
            wraplength=490,
            justify="left",
        ).pack(anchor="w", padx=14, pady=(0, 10))

        buttons = tk.Frame(dialog, bg=BG)
        buttons.pack(fill="x", padx=20, pady=(0, 18))

        def create() -> None:
            title_value = title_entry.get()
            description_value = description.get("1.0", "end").strip()
            self._trace_diag(
                "NEW_CASE_CREATE_CALLBACK_ENTERED",
                title_len=len(title_value),
            )
            try:
                record = CASE_STORE.create(
                    title_value,
                    description_value,
                )
                self._trace_diag(
                    "NEW_CASE_CREATED",
                    case_id=record.case_id or "legacy",
                )
                verified = CaseStore().current()
                if verified is None or verified.case_id != record.case_id:
                    raise CaseError(
                        "Independent in-process current-case state did not match the created case."
                    )
                self._trace_diag(
                    "NEW_CASE_STATE_VERIFIED",
                    case_id=record.case_id or "legacy",
                )
            except CaseCreatedButNotSelected as exc:
                self._trace_diag(
                    "NEW_CASE_FAILED",
                    exception_class=type(exc).__name__,
                    outcome="created-but-not-selected",
                )
                dialog.destroy()
                self.refresh_case_context()
                messagebox.showwarning(
                    "TraceOS",
                    f"Case created but not selected.\n\n"
                    f"Path: {exc.record.path}\n"
                    f"Case ID: {exc.record.case_id}\n\n"
                    f"Reason: {exc.cause}",
                    parent=self.root,
                )
                return
            except CaseError as exc:
                self._trace_diag(
                    "NEW_CASE_FAILED",
                    exception_class=type(exc).__name__,
                )
                messagebox.showerror(
                    "TraceOS",
                    str(exc),
                    parent=dialog,
                )
                return
            except Exception as exc:
                self._trace_diag(
                    "NEW_CASE_FAILED",
                    exception_class=type(exc).__name__,
                )
                messagebox.showerror(
                    "TraceOS",
                    "Unable to create the case.",
                    parent=dialog,
                )
                return

            dialog.destroy()
            self.refresh_case_header()
            header_text = str(self.header_case.cget("text"))
            prefix = (record.case_id or "legacy")[:8]
            if not record.case_id or prefix not in header_text:
                self._trace_diag(
                    "NEW_CASE_FAILED",
                    exception_class="HeaderMismatch",
                )
                messagebox.showerror(
                    "TraceOS",
                    "The new case was created but the case header did not update correctly.",
                    parent=self.root,
                )
                return
            self.dashboard()
            self.root.update_idletasks()
            self._trace_diag(
                "NEW_CASE_HEADER_REFRESHED",
                case_id=record.case_id,
                id_prefix=prefix,
            )

        def submit_from_title(_event: tk.Event) -> str:
            create()
            return "break"

        title_entry.bind("<Return>", submit_from_title)

        self.action_button(
            buttons,
            "CANCEL",
            dialog.destroy,
        ).pack(side="left")
        self.action_button(
            buttons,
            "CREATE CASE",
            create,
            primary=True,
        ).pack(side="right")
        title_entry.focus_set()
        self.root.update_idletasks()
        self._trace_diag(
            "NEW_CASE_DIALOG_OPENED",
            title_focus="yes" if self.root.focus_get() is title_entry else "no",
        )

    def select_case(self) -> None:
        dialog = tk.Toplevel(self.root)
        dialog.title("Select TraceOS Case")
        dialog.configure(bg=BG)
        dialog.transient(self.root)
        dialog.grab_set()
        dialog.geometry("920x520")

        tk.Label(
            dialog,
            text="SELECT CASE",
            bg=BG,
            fg=ACCENT,
            font=("Sans", 16, "bold"),
        ).pack(anchor="w", padx=24, pady=(22, 3))
        tk.Label(
            dialog,
            text="Choose an existing workspace. Corrupt or unsafe entries stay visible but cannot be activated.",
            bg=BG,
            fg=MUTED,
            font=("Sans", 9),
        ).pack(anchor="w", padx=24, pady=(0, 8))

        panel = self.card(dialog, padx=18, pady=10, expand=True)
        panel.pack(fill="both", expand=True, padx=20, pady=10)

        columns = ("title", "status", "case_id", "path")
        tree = ttk.Treeview(
            panel,
            columns=columns,
            show="headings",
            style="Trace.Treeview",
        )
        tree.heading("title", text="CASE")
        tree.heading("status", text="STATUS")
        tree.heading("case_id", text="CASE ID")
        tree.heading("path", text="PATH")
        tree.column("title", width=230, anchor="w")
        tree.column("status", width=90, anchor="center")
        tree.column("case_id", width=180, anchor="w")
        tree.column("path", width=330, anchor="w")
        tree.pack(fill="both", expand=True, padx=10, pady=10)

        entries = CASE_STORE.list_cases()
        if not entries:
            tree["height"] = 4
            tree.insert(
                "",
                "end",
                values=(
                    "No cases yet",
                    "EMPTY",
                    "",
                    "Create a new case to begin.",
                ),
            )
        else:
            for index, entry in enumerate(entries):
                record = entry.record
                tree.insert(
                    "",
                    "end",
                    iid=str(index),
                    values=(
                        record.title if record else entry.path.name,
                        entry.status,
                        (
                            record.case_id
                            if record and record.case_id
                            else "LEGACY" if record else ""
                        ),
                        str(entry.path),
                    ),
                )

        footer = tk.Frame(dialog, bg=BG)
        footer.pack(fill="x", padx=20, pady=(0, 18))

        def activate() -> None:
            selected = tree.selection()
            if not selected or not entries:
                messagebox.showinfo(
                    "TraceOS",
                    "There is no selectable case here yet.",
                    parent=dialog,
                )
                return
            entry = entries[int(selected[0])]
            if entry.error:
                messagebox.showerror(
                    "TraceOS Case",
                    f"Cannot select {entry.path.name}:\\n\\n{entry.error}",
                    parent=dialog,
                )
                return
            try:
                record = CASE_STORE.select(entry.path)
            except CaseError as exc:
                messagebox.showerror(
                    "TraceOS Case",
                    str(exc),
                    parent=dialog,
                )
                return
            dialog.destroy()
            self.refresh_case_header()
            self.dashboard()
            self._trace_diag(
                "case-selected",
                case_id=record.case_id or "legacy",
            )

        tree.bind("<Double-1>", lambda _event: activate())
        self.action_button(
            footer,
            "CLOSE",
            dialog.destroy,
        ).pack(side="left")
        self.action_button(
            footer,
            "SELECT CASE",
            activate,
            primary=True,
        ).pack(side="right")
        if entries:
            tree.selection_set("0")
            tree.focus("0")

    def add_evidence(self) -> None:
        value = filedialog.askopenfilename(parent=self.root, title="Select evidence file")
        if not value:
            return
        result = capture([TRACE, "evidence", "add", value], timeout=90)
        if result and result.returncode == 0:
            self.evidence()
        else:
            messagebox.showerror(
                "Evidence Vault", (result.stdout or result.stderr or "Unable to add evidence.").strip(),
                parent=self.root
            )

    def analyse_evidence(self) -> None:
        value = filedialog.askopenfilename(parent=self.root, title="Select file for local analysis")
        if value:
            self.network_or_output_page("Local Analysis", "Forensic output stays on this machine.", [TRACE, "analyse", value])

    def network_or_output_page(self, title: str, subtitle: str, args: list[str]) -> None:
        self.heading("TraceOS task", title, subtitle)
        panel = self.card(self.content, padx=28, pady=10, expand=True)
        self.set_output(panel, height=25)
        bar = tk.Frame(self.content, bg=BG)
        bar.pack(fill="x", padx=28, pady=(0, 18))
        self.action_button(bar, "STOP TASK", self.stop_job).pack(side="left")
        self.action_button(bar, "RUN AGAIN", lambda: self.run_job(args, title), primary=True).pack(side="right")
        self.run_job(args, title)

    def evidence(self) -> None:
        self.heading(
            "Case tools", "Evidence Vault",
            "Separate copies, SHA-256 integrity records and a readable audit trail."
        )
        toolbar = tk.Frame(self.content, bg=BG)
        toolbar.pack(fill="x", padx=28, pady=(0, 8))
        self.action_button(toolbar, "ADD EVIDENCE", self.add_evidence, primary=True).pack(side="left")
        self.action_button(toolbar, "ANALYSE FILE", self.analyse_evidence).pack(side="left", padx=7)
        self.action_button(
            toolbar, "VERIFY INTEGRITY",
            lambda: self.network_or_output_page(
                "Evidence Integrity",
                "Recalculate SHA-256 for every vault copy and compare with the case ledger.",
                [TRACE, "evidence", "verify"],
            )
        ).pack(side="left", padx=7)
        current = case_path()
        self.action_button(toolbar, "OPEN CASE FOLDER", lambda: self.open_path(current) if current else None).pack(side="right")

        box = self.card(self.content, padx=28, pady=5, expand=True)
        columns = ("name", "time", "size", "hash")
        tree = ttk.Treeview(box, columns=columns, show="headings", style="Trace.Treeview")
        tree.heading("name", text="VAULT COPY")
        tree.heading("time", text="UTC")
        tree.heading("size", text="SIZE")
        tree.heading("hash", text="SHA-256")
        tree.column("name", width=310)
        tree.column("time", width=175)
        tree.column("size", width=100)
        tree.column("hash", width=420)
        tree.pack(fill="both", expand=True, padx=14, pady=14)

        if current:
            manifest = current / "hashes" / "evidence.tsv"
            if manifest.exists():
                rows = manifest.read_text(encoding="utf-8").splitlines()[1:]
                for row in rows:
                    parts = row.split("	")
                    if len(parts) == 6:
                        tree.insert("", "end", values=(Path(parts[2]).name, parts[0], f"{parts[4]} B", parts[3]))
        else:
            tree.insert("", "end", values=("No current case", "", "", ""))

        tk.Label(
            self.content, text="Original source files are not modified by the case helper.",
            bg=BG, fg=MUTED, font=("Sans", 8)
        ).pack(anchor="w", padx=30, pady=(0, 12))

    def network(self) -> None:
        self.heading(
            "Network", "Command Centre",
            "Live local status plus explicit, user-invoked Nmap scans."
        )
        top = self.card(self.content, padx=28, pady=8)
        tk.Label(top, text=f"NETWORK  {network_state()}", bg=CARD, fg=GOOD, font=("Sans", 10, "bold")).pack(
            side="left", padx=16, pady=14
        )
        self.action_button(top, "REFRESH", self.network).pack(side="right", padx=8, pady=6)
        self.action_button(top, "NETWORK SETTINGS", lambda: self.open_terminal(["nm-connection-editor"], "Network Settings")).pack(side="right", padx=8, pady=6)

        controls = self.card(self.content, padx=28, pady=8)
        tk.Label(controls, text="AUTHORIZED TARGET", bg=CARD, fg=MUTED, font=("Sans", 8, "bold")).grid(row=0, column=0, sticky="w", padx=15, pady=(14, 4))
        target = tk.Entry(controls, bg="#08111d", fg=TEXT, insertbackground=ACCENT, relief="flat", font=("Monospace", 10))
        target.grid(row=1, column=0, sticky="ew", padx=15, pady=(0, 14))
        target.focus_set()
        tk.Label(controls, text="SCAN PROFILE", bg=CARD, fg=MUTED, font=("Sans", 8, "bold")).grid(row=0, column=1, sticky="w", padx=8, pady=(14, 4))
        profile = ttk.Combobox(controls, state="readonly", values=("Quick", "Standard", "Services"), style="Trace.TCombobox")
        profile.current(0)
        profile.grid(row=1, column=1, sticky="ew", padx=8, pady=(0, 14))
        controls.grid_columnconfigure(0, weight=3)
        controls.grid_columnconfigure(1, weight=1)

        output_panel = self.card(self.content, padx=28, pady=8, expand=True)
        self.set_output(output_panel, height=18)

        bar = tk.Frame(self.content, bg=BG)
        bar.pack(fill="x", padx=28, pady=(0, 14))
        self.action_button(bar, "STOP", self.stop_job).pack(side="left")

        def start_scan() -> None:
            host = target.get().strip()
            if not host:
                messagebox.showwarning("Nmap", "Enter an authorized target first.", parent=self.root)
                return
            args = {"Quick": ["-F"], "Standard": ["-sV", "-T3"], "Services": ["-sV", "-sC", "-T3"]}[profile.get()]
            self.run_job([TRACE, "network", "nmap", *args, host], "Nmap scan")

        self.action_button(bar, "RUN NMAP", start_scan, primary=True).pack(side="right")

    def image_osint(self) -> None:
        image_attempt = 0
        self.heading(
            "INVESTIGATION / IMAGE", "Image OSINT",
            "Local-first image inspection. The selected source is analysed without uploading it."
        )
        warning = self.card(self.content, padx=28, pady=7)
        tk.Label(warning, text="LOCAL ANALYSIS ONLY", bg=CARD, fg=GOOD, font=("Sans", 9, "bold")).pack(anchor="w", padx=15, pady=(10, 1))
        tk.Label(
            warning,
            text="Image analysis stays on this machine. Reverse-image search is a separate, user-confirmed browser handoff.",
            bg=CARD, fg=MUTED, font=("Sans", 9)
        ).pack(anchor="w", padx=15, pady=(0, 10))

        mode_bar = tk.Frame(self.content, bg=BG)
        mode_bar.pack(fill="x", padx=28, pady=(0, 6))
        self.action_button(mode_bar, "CLI / WEB OSINT", self.osint).pack(side="left")
        self.action_button(mode_bar, "IMAGE OSINT", self.image_osint, primary=True).pack(side="left", padx=7)

        controls = self.card(self.content, padx=28, pady=7)
        tk.Label(controls, text="SELECTED SOURCE", bg=CARD, fg=MUTED, font=("Sans", 8, "bold")).grid(
            row=0, column=0, columnspan=3, sticky="w", padx=15, pady=(10, 4)
        )
        source_var = tk.StringVar(value="No image selected")
        tk.Label(
            controls, textvariable=source_var, bg="#08111d", fg=TEXT,
            anchor="w", justify="left", font=("Monospace", 9)
        ).grid(row=1, column=0, columnspan=3, sticky="ew", padx=15, pady=(0, 8))
        tk.Label(controls, text="FILE PATH / KEYBOARD ACCESS", bg=CARD, fg=MUTED, font=("Sans", 8, "bold")).grid(row=2, column=0, columnspan=3, sticky="w", padx=15, pady=(0, 4))
        source_entry = tk.Entry(controls, bg="#08111d", fg=TEXT, insertbackground=ACCENT, relief="flat", font=("Monospace", 9))
        source_entry.grid(row=3, column=0, columnspan=2, sticky="ew", padx=15, pady=(0, 12))

        output_panel = self.card(self.content, padx=28, pady=7, expand=True)
        self.set_output(output_panel, height=18)

        bar = tk.Frame(self.content, bg=BG)
        bar.pack(fill="x", padx=28, pady=(0, 14))

        def use_image_path() -> None:
            selected = source_entry.get().strip()
            if not selected:
                messagebox.showwarning("Image OSINT", "Enter an image path first.", parent=self.root)
                return
            path = Path(selected).expanduser()
            if path.is_symlink() or not path.is_file():
                messagebox.showwarning("Image OSINT", "Select an existing regular image file.", parent=self.root)
                return
            nonlocal image_attempt
            image_attempt += 1
            source_var.set(str(path))
            self._trace_diag("IMAGE_SOURCE_SELECTED", attempt=image_attempt, source_kind="path-entry")

        def choose_image() -> None:
            selected = filedialog.askopenfilename(
                parent=self.root,
                title="Select an image for local analysis",
                filetypes=[
                    ("Image files", "*.png *.jpg *.jpeg *.gif *.webp *.bmp *.tif *.tiff"),
                    ("All files", "*.*"),
                ],
            )
            if selected:
                nonlocal image_attempt
                image_attempt += 1
                source_var.set(selected)
                source_entry.delete(0, "end")
                source_entry.insert(0, selected)
                self._trace_diag("IMAGE_SOURCE_SELECTED", attempt=image_attempt, source_kind="file-selected")

        def handoff() -> None:
            selected = source_var.get()
            if selected == "No image selected":
                messagebox.showwarning("Image OSINT", "Choose an image first.", parent=self.root)
                return
            if not messagebox.askyesno(
                "External browser handoff",
                "Open an external reverse-image search site? TraceOS will not upload or submit this image.",
                parent=self.root,
            ):
                self._trace_diag("IMAGE_BROWSER_HANDOFF_CANCELLED")
                return
            try:
                webbrowser.open("https://lens.google.com/")
                self._trace_diag("IMAGE_BROWSER_HANDOFF_OPENED", attempt=image_attempt)
            except Exception as exc:
                self._trace_diag("IMAGE_BROWSER_HANDOFF_FAILED", exc_type=type(exc).__name__)
                messagebox.showerror("Image OSINT", f"Unable to open browser: {exc}", parent=self.root)

        def start_image() -> None:
            selected = source_var.get()
            if selected == "No image selected":
                messagebox.showwarning("Image OSINT", "Choose an image first.", parent=self.root)
                return
            path = Path(selected).expanduser()
            if path.is_symlink():
                messagebox.showwarning("Image OSINT", "For safety, select the actual image file rather than a symbolic link.", parent=self.root)
                return
            if not path.is_file():
                messagebox.showwarning("Image OSINT", "The selected file is no longer available.", parent=self.root)
                return
            self._trace_diag("IMAGE_ANALYSIS_START_CLICKED", attempt=image_attempt, source_kind="regular-file")
            self.run_job([TRACE, "image", str(path)], "Local image analysis", kind="image", attempt=image_attempt)

        self.action_button(bar, "CHOOSE IMAGE", choose_image).pack(side="left")
        self.action_button(controls, "USE PATH", use_image_path).grid(row=3, column=2, sticky="e", padx=15, pady=(0, 12))
        source_entry.bind("<Return>", lambda _event: use_image_path())
        self.action_button(bar, "REVERSE-IMAGE SITE", handoff).pack(side="left", padx=7)
        self.action_button(bar, "STOP", self.stop_job).pack(side="left", padx=7)
        self.action_button(bar, "START LOCAL ANALYSIS", start_image, primary=True).pack(side="right")

        self.root.update_idletasks()
        source_entry.focus_set()
        self._trace_diag("image-osint-page-rendered", page="image")
    def osint(self) -> None:
        self.heading(
            "INVESTIGATION", "Investigation Centre",
            "Local-first investigation tools. Nothing runs until you press Start."
        )
        warning = self.card(self.content, padx=28, pady=7)
        tk.Label(
            warning, text="EXTERNAL ACTIONS ARE USER-INVOKED",
            bg=CARD, fg=WARN, font=("Sans", 9, "bold")
        ).pack(anchor="w", padx=15, pady=(10, 1))
        tk.Label(
            warning,
            text="Some tools may contact third-party services when launched. TraceOS never runs them automatically.",
            bg=CARD, fg=MUTED, font=("Sans", 9)
        ).pack(anchor="w", padx=15, pady=(0, 10))

        controls = self.card(self.content, padx=28, pady=7)
        tk.Label(controls, text="TOOL", bg=CARD, fg=MUTED, font=("Sans", 8, "bold")).grid(row=0, column=0, sticky="w", padx=15, pady=(10, 4))
        tool = ttk.Combobox(controls, state="readonly", values=("Sherlock", "Maigret", "h8mail", "Blackbird", "WHOIS", "DNS"), style="Trace.TCombobox")
        tool.current(0)
        tool.grid(row=1, column=0, sticky="ew", padx=15, pady=(0, 12))
        tk.Label(controls, text="TARGET / ARGUMENTS", bg=CARD, fg=MUTED, font=("Sans", 8, "bold")).grid(row=0, column=1, sticky="w", padx=8, pady=(10, 4))
        target = tk.Entry(controls, bg="#08111d", fg=TEXT, insertbackground=ACCENT, relief="flat", font=("Monospace", 10))
        target.grid(row=1, column=1, sticky="ew", padx=8, pady=(0, 12))
        tk.Label(controls, text="EXTRA OPTIONS", bg=CARD, fg=MUTED, font=("Sans", 8, "bold")).grid(row=0, column=2, sticky="w", padx=8, pady=(10, 4))
        extra = tk.Entry(controls, bg="#08111d", fg=TEXT, insertbackground=ACCENT, relief="flat", font=("Monospace", 10))
        extra.grid(row=1, column=2, sticky="ew", padx=8, pady=(0, 12))
        controls.grid_columnconfigure(0, weight=1)
        controls.grid_columnconfigure(1, weight=3)
        controls.grid_columnconfigure(2, weight=2)

        mode_bar = tk.Frame(self.content, bg=BG)
        mode_bar.pack(fill="x", padx=28, pady=(0, 6))
        self.action_button(mode_bar, "IMAGE OSINT", self.image_osint, primary=True).pack(side="left")
        tk.Label(
            mode_bar,
            text="CURRENT MODE  •  PERSONAL / WEB CLI WORKBENCH",
            bg=BG, fg=MUTED, font=("Sans", 8, "bold")
        ).pack(side="left", padx=12)

        hint = tk.Label(
            self.content,
            text="Username: Sherlock/Maigret • Email: h8mail • WHOIS/DNS: domain or IP • Blackbird: its command arguments",
            bg=BG, fg=MUTED, font=("Sans", 8)
        )
        hint.pack(anchor="w", padx=30, pady=(0, 4))

        output_panel = self.card(self.content, padx=28, pady=7, expand=True)
        self.set_output(output_panel, height=17)

        bar = tk.Frame(self.content, bg=BG)
        bar.pack(fill="x", padx=28, pady=(0, 14))
        self.action_button(
            bar, "OPEN CLI WORKBENCH",
            lambda: self.open_terminal([TRACE, "osint"], "TraceOS Investigation Workbench")
        ).pack(side="left")
        self.action_button(bar, "STOP", self.stop_job).pack(side="left", padx=7)

        def start_osint() -> None:
            name = tool.get()
            value = target.get().strip()
            if not value:
                messagebox.showwarning("OSINT", "Enter a target or arguments first.", parent=self.root)
                return
            extras = shlex.split(extra.get()) if extra.get().strip() else []
            if name in {"Sherlock", "Maigret"}:
                args = [name.lower(), value, *extras]
            elif name == "h8mail":
                args = ["h8mail", "-t", value, *extras]
            elif name == "WHOIS":
                args = ["whois", value, *extras]
            elif name == "DNS":
                args = ["dig", value, *extras]
            else:
                args = ["blackbird", *shlex.split(value), *extras]
            self.run_job(args, f"{name} investigation")

        self.action_button(bar, "START LOOKUP", start_osint, primary=True).pack(side="right")
        self.root.update_idletasks()
        self._trace_diag("osint-page-rendered", page="osint")

    def save_investigation_output(self) -> None:
        current = case_path()
        if not current:
            messagebox.showwarning("Investigation Centre", "Create or select a case before saving output.", parent=self.root)
            return
        output = self.job_output.strip()
        if not output:
            messagebox.showinfo("Investigation Centre", "There is no investigation output to save yet.", parent=self.root)
            return
        stamp = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
        path = current / "working" / f"investigation-{stamp}-{uuid.uuid4().hex[:8]}.txt"
        try:
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(output + "\n", encoding="utf-8")
        except OSError as exc:
            messagebox.showerror("Investigation Centre", f"Unable to stage output:\n{exc}", parent=self.root)
            return
        result = capture([TRACE, "evidence", "add", str(path)], timeout=90)
        if result and result.returncode == 0:
            messagebox.showinfo("Investigation Centre", "Investigation output was copied into the Evidence Vault and hashed.", parent=self.root)
            self.evidence()
        else:
            messagebox.showerror(
                "Investigation Centre",
                (result.stdout or result.stderr or "Unable to add investigation output to evidence.").strip(),
                parent=self.root,
            )

    def reports(self) -> None:
        self.heading(
            "Case tools", "Reports",
            "Generated reports stay inside the current case workspace."
        )
        bar = tk.Frame(self.content, bg=BG)
        bar.pack(fill="x", padx=28, pady=(0, 8))
        self.action_button(bar, "GENERATE REPORT", self.generate_report, primary=True).pack(side="left")
        self.action_button(bar, "REFRESH", self.reports).pack(side="left", padx=7)

        box = self.card(self.content, padx=28, pady=7, expand=True)
        tree = ttk.Treeview(box, columns=("file", "size"), show="headings", style="Trace.Treeview")
        tree.heading("file", text="REPORT")
        tree.heading("size", text="SIZE")
        tree.column("file", width=700)
        tree.column("size", width=120)
        tree.pack(fill="both", expand=True, padx=14, pady=14)

        current = case_path()
        if current:
            for report in sorted((current / "reports").glob("*.md"), reverse=True):
                tree.insert("", "end", values=(report.name, f"{report.stat().st_size} B"), iid=str(report))

            def open_selected() -> None:
                selected = tree.selection()
                if selected:
                    self.open_path(Path(selected[0]))
                else:
                    messagebox.showinfo("Reports", "Select a report first.", parent=self.root)

            self.action_button(box, "OPEN SELECTED", open_selected).pack(anchor="e", padx=14, pady=(0, 14))
        else:
            tree.insert("", "end", values=("No current case", ""))

    def generate_report(self) -> None:
        result = capture([TRACE, "report"], timeout=30)
        if result and result.returncode == 0:
            self.reports()
        else:
            messagebox.showerror(
                "TraceOS Reports",
                (result.stdout or result.stderr or "No current case.").strip(),
                parent=self.root,
            )

    def timeline(self) -> None:
        self.heading(
            "Case tools", "Timeline",
            "Chronological events recorded by the TraceOS evidence ledger."
        )
        panel = self.card(self.content, padx=28, pady=8, expand=True)
        output = self.set_output(panel, height=24)
        result = capture([TRACE, "timeline"], timeout=15)
        self.set_text(output, (result.stdout if result else "Timeline unavailable.").strip())
        bar = tk.Frame(self.content, bg=BG)
        bar.pack(fill="x", padx=28, pady=(0, 14))
        self.action_button(bar, "REFRESH", self.timeline, primary=True).pack(side="right")

    def doctor_page(self) -> None:
        self.heading(
            "System", "System Doctor",
            "Check the TraceOS runtime, bundled tools and branding assets."
        )
        panel = self.card(self.content, padx=28, pady=10, expand=True)
        output = self.set_output(panel, height=24)
        result = capture([TRACE, "doctor"], timeout=15)
        self.set_text(output, (result.stdout if result else "System Doctor unavailable.").strip())
        bar = tk.Frame(self.content, bg=BG)
        bar.pack(fill="x", padx=28, pady=(0, 14))
        self.action_button(bar, "RUN AGAIN", self.doctor_page, primary=True).pack(side="right")


if __name__ == "__main__":
    start_page = "osint" if "--osint" in sys.argv else "dashboard"
    root = tk.Tk()
    TraceOSApp(root, welcome="--welcome" in sys.argv, start_page=start_page)
    root.mainloop()
