            "Nuclei, Dalfox, ffuf, NetExec and the Active Directory tools send traffic. Kerbrute, Hashcat and John open a console only. No password list, module, or exploit is selected for you.",
        )

    def credentials(self) -> None:
        self.activate_nav("Credentials")
        self._tool_catalogue_page(
            CREDENTIAL_TOOL_SPECS,
            "CREDENTIALS",
            "Exposed credentials",
            "Look for secrets in a folder on this machine, or read a dump you already have. Nothing is sent away to be verified.",
            "TruffleHog does not call vendor APIs. NoseyParker writes its datastore under /var/tmp on this machine, then Report reads that datastore. pypykatz only reads the minidump you select. DonPAPI opens a console and does not collect anything until you run that yourself.",
        )

    def defence(self) -> None:
        self.activate_nav("Defence")
        self._tool_catalogue_page(
            DEFENCE_TOOL_SPECS,
            "DEFENCE",
            "Defence",
