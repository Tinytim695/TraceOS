def capture(args: list[str], timeout: int = 8) -> subprocess.CompletedProcess[str] | None:
    try:
        return subprocess.run(args, capture_output=True, text=True, check=False, timeout=timeout)
    except (OSError, subprocess.SubprocessError):
        return None


CASE_STORE = CaseStore()

def terminate_process_group(
    process: subprocess.Popen,
    term_timeout: float = 0.75,
    kill_timeout: float = 5.0,
) -> bool:
    """Terminate the task's owned process group, including child processes."""
    group_available = True
    try:
        os.killpg(process.pid, signal.SIGTERM)
    except ProcessLookupError:
        group_available = False
    except OSError:
        group_available = False
        if process.poll() is None:
            try:
                process.terminate()
            except OSError:
                return False

    if process.poll() is None:
        try:
            process.wait(timeout=term_timeout)
        except subprocess.TimeoutExpired:
            pass

    if group_available:
        try:
            # The leader may have exited while a child remained in the group.
            os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        except OSError:
            if process.poll() is None:
                try:
                    process.kill()
                except OSError:
                    return False
    elif process.poll() is None:
        try:
            process.kill()
        except OSError:
            return False

    try:
        process.wait(timeout=kill_timeout)
    except subprocess.TimeoutExpired:
        return False
    return True


def case_path() -> Path | None:
    try:
        record = CASE_STORE.current()
    except CaseError:
        return None
    return record.path if record else None


def case_name(path: Path | None) -> str:
    if not path:
        return "No active case"
    try:
        return CASE_STORE.read(path).title
    except CaseError:
        return path.name


def network_state() -> str:
    result = capture(["nmcli", "-t", "-f", "STATE", "general"])
    if result and result.stdout.strip():
        return result.stdout.strip().splitlines()[0].upper()
    return "UNKNOWN"


def session_state() -> str:
    result = capture([SESSION, "mode"])
    if result and result.returncode == 0 and result.stdout.strip():
        return result.stdout.strip().upper()
    return "UNKNOWN"


OSINT_TOOL_COMMANDS = {
    "Sherlock": "sherlock",
    "Maigret": "maigret",
    "h8mail": "h8mail",
    "Holehe": "holehe",
    "PhoneInfoga": "phoneinfoga",
    "GHunt": "ghunt",
    "Blackbird": "blackbird",
    "theHarvester": "theHarvester",
    "Subfinder": "subfinder",
    "dnsrecon": "dnsrecon",
    "dnstwist": "dnstwist",
    "WHOIS": "whois",
    "DNS": "dig",
    "Cloud Enum": "cloud_enum",
}


def build_osint_command(name: str, target: str, extra: str = "") -> list[str]:
    if name not in OSINT_TOOL_COMMANDS:
        raise ValueError(f"Unknown Investigation Centre tool: {name}")
    value = target.strip()
    if not value:
        raise ValueError("Enter a target or arguments first.")
    try:
        extras = shlex.split(extra) if extra.strip() else []
        target_args = shlex.split(value) if name == "Blackbird" else [value]
    except ValueError as exc:
        raise ValueError(f"Invalid arguments: {exc}") from exc
    if name == "Blackbird":
        if not target_args:
            raise ValueError("Enter Blackbird arguments first.")
        if value.startswith("-"):
            return ["blackbird", *target_args, *extras]
        flag = "--email" if "@" in value else "--username"
        return ["blackbird", flag, value, *extras]
    command = OSINT_TOOL_COMMANDS[name]
    if name in {"Sherlock", "Maigret"}:
        return [command, value, *extras]
    if name == "h8mail":
        return [command, "-t", value, *extras]
    if name in {"Holehe", "GHunt", "PhoneInfoga", "theHarvester", "Subfinder", "dnsrecon", "dnstwist"}:
        if value.startswith("-") or any(ch.isspace() for ch in value):
            raise ValueError("Enter one target, without leading options.")
    if name == "Holehe":
        if "@" not in value:
            raise ValueError("Enter one email address.")
        return ["holehe", value, *extras]
    if name == "GHunt":
        if "@" not in value:
            raise ValueError("Enter one email address.")
        return ["ghunt", "email", value, *extras]
    if name == "PhoneInfoga":
        return ["phoneinfoga", "scan", "-n", value, *extras]
    if name == "theHarvester":
        return ["theHarvester", "-d", value, "-b", "crtsh,urlscan", *extras]
    if name == "Subfinder":
        return ["subfinder", "-d", value, "-silent", *extras]
    if name == "dnsrecon":
        return ["dnsrecon", "-d", value, *extras]
    if name == "dnstwist":
        return ["dnstwist", value, *extras]
    if name == "Cloud Enum":
        if value.startswith("-") or any(ch.isspace() for ch in value):
            raise ValueError("Enter one company or domain keyword, without leading options.")
        return ["cloud_enum", "-k", value, *extras]
    return [command, value, *extras]


def require_osint_tool(command: str) -> None:
    if shutil.which(command) is None:
        raise FileNotFoundError(
            f"{command} is not installed in this TraceOS image."
        )



