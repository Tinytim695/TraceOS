        cards = (
            ("⌘", "Web Testing", "Authorized web and network checks.", self.web_testing),
            ("⌖", "Assessment", "Identity, directory and service assessment.", self.assessment),
            ("✦", "Credentials", "Local secret scan, minidump reading, and a DonPAPI console.", self.credentials),
            ("◈", "Defence", "Local capture, disk, memory and detection.", self.defence),
            ("⚔", "Engagement", "Scoped red, blue and purple exercises.", self.engagement),
            ("▧", "Image OSINT", "Local image analysis and metadata.", self.image_osint),
            ("▤", "Reports", "Write the case report already stored on this machine.", self.reports),
            ("▥", "Timeline", "Read the evidence ledger timeline.", self.timeline),
