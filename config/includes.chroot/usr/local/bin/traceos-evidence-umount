#!/usr/bin/env bash
set -euo pipefail

mountpoint="${1:-}"
prefix="/mnt/traceos-evidence/"

if [[ -z "$mountpoint" || "$mountpoint" != "$prefix"* ]]; then
  echo "Usage: traceos-evidence-umount /mnt/traceos-evidence/<device>" >&2
  exit 2
fi

if ! mountpoint -q "$mountpoint"; then
  echo "[TraceOS] Not mounted: $mountpoint" >&2
  exit 1
fi

sudo umount -- "$mountpoint"
echo "[TraceOS] Evidence volume unmounted: $mountpoint"
