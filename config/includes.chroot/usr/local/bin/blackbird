#!/usr/bin/env bash
set -euo pipefail

APP_DIR="/opt/traceos-blackbird"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/traceos-blackbird"

mkdir -p "$STATE_DIR"
ln -sfn "$APP_DIR/assets" "$STATE_DIR/assets"
ln -sfn "$APP_DIR/src" "$STATE_DIR/src"

cd "$STATE_DIR"
exec "$APP_DIR/venv/bin/python" "$APP_DIR/blackbird.py" "$@"
