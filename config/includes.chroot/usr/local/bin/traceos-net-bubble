#!/usr/bin/env python3
"""XFCE genmon output for the TraceOS network pill. It never changes routes."""
import json
import os
import subprocess
import time
from pathlib import Path

LIB = "/usr/local/lib/traceos"
if not os.path.isdir(LIB):
    LIB = str(Path(__file__).resolve().parent.parent / "lib" / "traceos")
if LIB not in os.sys.path:
    os.sys.path.insert(0, LIB)
import tor_mode

STATUS_PATH = Path("/run/traceos/tor-status.json")
SEEN_PATH = Path.home() / ".cache" / "traceos" / "net-bubble-status"


def main() -> int:
    status = "unknown"
    detail = "Network status has not been checked yet."
    try:
        payload = json.loads(STATUS_PATH.read_text(encoding="utf-8"))
        age = time.time() - float(payload.get("checked_at"))
        status = tor_mode.fresh_status(str(payload.get("status")), age)
        detail = str(payload.get("detail") or detail)
        if payload.get("fail_closed") and status == "offline":
            detail = "No usable network. The fail-closed block is still active."
    except (OSError, ValueError, TypeError):
        status = "unknown"
    label, _colour = tor_mode.LABELS.get(status, tor_mode.LABELS["unknown"])
    tip = (
        detail
        + " An internet provider can still see a connection to Tor relays."
        + " Tor does not hide every identifier."
    )
    previous = ""
    try:
        previous = SEEN_PATH.read_text(encoding="utf-8").strip()
    except OSError:
        previous = ""
    if previous and previous != status and os.environ.get("DISPLAY"):
        subprocess.run(
            ["notify-send", "--urgency=normal", "--app-name=TraceOS", "TraceOS network", label],
            check=False,
        )
    try:
        SEEN_PATH.parent.mkdir(parents=True, exist_ok=True)
        SEEN_PATH.write_text(status + "\n", encoding="utf-8")
    except OSError:
        pass
    safe_tip = tip.replace("&", "&").replace("<", "<").replace(">", ">")
    click = "/usr/local/bin/traceos-control-launch --network"
    print(tor_mode.bubble_markup(status))
    print(f"<tool>{safe_tip}</tool>")
    print(f"<txtclick>{click}</txtclick>")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
