#!/bin/sh
set -eu

CMDLINE="$(cat /proc/cmdline 2>/dev/null || true)"
MODE="amnesic (no persistent storage)"

case " $CMDLINE " in
  *" nopersistence "*)
    MODE="amnesic (no persistent storage)"
    ;;
  *" persistence "*)
    if printf '%s' "$CMDLINE" | grep -q 'persistence-encryption=luks'; then
      MODE="persistent (LUKS)"
    else
      MODE="persistent"
    fi
    ;;
esac

case "${1:-status}" in
  status)
    printf 'TraceOS session: %s
' "$MODE"
    ;;
  mode)
    printf '%s
' "$MODE"
    ;;
  *)
    printf '%s
' 'Usage: traceos-session {status|mode}'
    exit 2
    ;;
esac
