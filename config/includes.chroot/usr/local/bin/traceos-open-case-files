#!/usr/bin/env python3
"""Open the active case folder in the file manager."""
from __future__ import annotations

import subprocess
import sys
from pathlib import Path

sys.path.insert(0, "/usr/local/bin")

from traceos_case import CaseError, CaseStore


def main() -> int:
    try:
        folder = CaseStore().current().path
    except CaseError:
        folder = Path.home() / "Cases"
        folder.mkdir(mode=0o700, exist_ok=True)
        subprocess.run(
            [
                "xmessage",
                "-center",
                "No case is open yet. Create one in Control Centre, then use Case Files again.",
            ],
            check=False,
        )
    subprocess.Popen(
        ["thunar", str(folder)],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
