#!/usr/bin/env bash
set -euo pipefail

TOOLS_FILE="/usr/share/traceos/osint-tools.txt"

usage() {
  cat <<'EOF'
TraceOS OSINT

User-invoked tools only. These applications may contact external services when
you run them. TraceOS itself does not automatically execute OSINT searches.

Usage:
  traceos-osint
  traceos-osint sherlock USERNAME [USERNAME...]
  traceos-osint maigret USERNAME [USERNAME...]
  traceos-osint h8mail OPTIONS
  traceos-osint blackbird [BLACKBIRD OPTIONS]
  traceos-osint whois DOMAIN_OR_IP
  traceos-osint dig NAME [DNS OPTIONS]

Interactive mode:
  Launches a simple menu for the bundled OSINT applications.
EOF
}

run_tool() {
  command="$1"
  shift
  if ! command -v "$command" >/dev/null 2>&1; then
    echo "[TraceOS] $command is not installed."
    return 1
  fi
  exec "$command" "$@"
}

show_inventory() {
  echo
  echo "TRACEOS OSINT WORKBENCH"
  echo "======================="
  echo
  if [ -r "$TOOLS_FILE" ]; then
    while IFS='|' read -r package command purpose; do
      [ -n "$command" ] || continue
      if command -v "$command" >/dev/null 2>&1; then
        printf '  [OK] %-11s %-48s %s
' "$command" "$package" "$purpose"
      else
        printf '  [--] %-11s %-48s %s
' "$command" "$package" "$purpose"
      fi
    done < "$TOOLS_FILE"
  fi
  echo
  echo "Choose a tool:"
  echo "  1) Sherlock     username discovery"
  echo "  2) Maigret      username investigation"
  echo "  3) h8mail       email OSINT"
  echo "  4) Blackbird    username/email search"
  echo "  5) WHOIS        domain/IP registration lookup"
  echo "  6) DNS          DNS record lookup"
  echo "  7) List tools"
  echo "  0) Exit"
  echo

  printf "Selection: "
  read -r choice
  case "$choice" in
    1) printf "Username(s): "; read -r -a args; run_tool sherlock "${args[@]}" ;;
    2) printf "Username(s): "; read -r -a args; run_tool maigret "${args[@]}" ;;
    3) echo "Enter h8mail arguments (see h8mail --help):"; read -r -a args; run_tool h8mail "${args[@]}" ;;
    4) echo "Enter Blackbird arguments (see blackbird --help):"; read -r -a args; run_tool blackbird "${args[@]}" ;;
    5) show_inventory ;;
    0) exit 0 ;;
    *) echo "Unknown selection."; exit 2 ;;
  esac
}

case "${1:-}" in
  "")
    show_inventory
    ;;
  sherlock|maigret|h8mail|blackbird|whois|dig)
    tool="$1"
    shift
    [ "$#" -gt 0 ] || { usage; exit 2; }
    run_tool "$tool" "$@"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage
    exit 2
    ;;
esac
