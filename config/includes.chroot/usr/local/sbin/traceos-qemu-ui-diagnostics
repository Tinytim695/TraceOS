#!/usr/bin/env python3
"""QEMU-only, read-only bridge for late TraceOS GUI diagnostics."""
from __future__ import annotations

import json
import os
import re
import stat
import time
from pathlib import Path

LOG = Path("/home/traceos/.cache/traceos/control-centre-ui.log")
SERIAL = "/dev/ttyS0"
EXPECTED_TITLE = "qemucase"
ALLOWED_STAGES = {
    "CONTROL_CENTRE_SESSION_READY",
    "NEW_CASE_INPUT_RECEIVED",
    "NEW_CASE_DIALOG_OPENED",
    "NEW_CASE_CREATE_CALLBACK_ENTERED",
    "NEW_CASE_CREATED",
    "NEW_CASE_STATE_VERIFIED",
    "NEW_CASE_HEADER_REFRESHED",
    "NEW_CASE_FAILED",
    "IMAGE_PAGE_SHORTCUT_RECEIVED",
    "image-osint-page-rendered",
    "IMAGE_SOURCE_SELECTED",
    "IMAGE_ANALYSIS_START_CLICKED",
    "IMAGE_CLI_STARTED",
    "IMAGE_CLI_COMPLETED",
    "IMAGE_RESULT_RENDERED",
    "IMAGE_CLI_STOPPED",
}

UUID_RE = re.compile(r"\bcase_id=([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})\b")
FIELD_RE = re.compile(r"\b([a-z_]+)=([^\s]+)")


def emit(line: str) -> None:
    text = line.rstrip("\n")
    try:
        with open("/run/traceos-qemu-ui-diagnostics.log", "a", encoding="utf-8") as handle:
            handle.write(text + "\n")
    except OSError:
        pass
    try:
        fd = os.open(SERIAL, os.O_WRONLY | os.O_NOCTTY | os.O_NONBLOCK)
        try:
            os.write(fd, (text + "\n").encode("utf-8"))
        finally:
            os.close(fd)
    except OSError:
        pass


def probe(case_id: str, nonce: str, pid: str, uid: str, attempt: str) -> None:
    result = "FAIL"
    state_regular = manifest_regular = path_safe = title_match = False
    state_id = "none"
    manifest_id = "none"
    state_path = Path("/home/traceos/.config/traceos/current_case")
    root = Path("/home/traceos/Cases")

    try:
        state_info = os.lstat(state_path)
        state_regular = stat.S_ISREG(state_info.st_mode)
        if not state_regular or stat.S_ISLNK(state_info.st_mode):
            raise RuntimeError("invalid state file")
        raw = state_path.read_text(encoding="utf-8").splitlines()
        if len(raw) != 1 or not raw[0].strip():
            raise RuntimeError("invalid state contents")

        selected = Path(raw[0].strip()).expanduser()
        selected_info = os.lstat(selected)
        if stat.S_ISLNK(selected_info.st_mode) or not stat.S_ISDIR(selected_info.st_mode):
            raise RuntimeError("invalid selected case")
        resolved = selected.resolve(strict=True)
        root_resolved = root.resolve(strict=True)
        resolved.relative_to(root_resolved)
        path_safe = True

        manifest = resolved / "case.json"
        manifest_info = os.lstat(manifest)
        manifest_regular = (
            not stat.S_ISLNK(manifest_info.st_mode)
            and stat.S_ISREG(manifest_info.st_mode)
        )
        if not manifest_regular:
            raise RuntimeError("invalid manifest")
        data = json.loads(manifest.read_text(encoding="utf-8"))
        manifest_id = str(data.get("case_id", ""))
        state_id = manifest_id

        title_match = data.get("title") == EXPECTED_TITLE
        if manifest_id != case_id:
            raise RuntimeError("case id mismatch")
        if not title_match:
            raise RuntimeError("synthetic title mismatch")
        result = "PASS"
    except Exception:
        result = "FAIL"

    emit(
        "[TraceOS] QEMU_UI_DIAG "
        f"stage=NEW_CASE_STATE_PROBE nonce={nonce} pid={pid} uid={uid} "
        f"attempt={attempt} case_id={case_id} state_id={state_id} "
        f"manifest_id={manifest_id} state_regular={'yes' if state_regular else 'no'} "
        f"manifest_regular={'yes' if manifest_regular else 'no'} "
        f"path_safe={'yes' if path_safe else 'no'} "
        f"title_match={'yes' if title_match else 'no'} result={result}"
    )


def fields_from(line: str) -> dict[str, str]:
    return {key: value for key, value in FIELD_RE.findall(line)}


def main() -> int:
    emit("[TraceOS] QEMU_UI_DIAG_READY")
    offset = 0
    while True:
        try:
            if LOG.exists():
                with LOG.open("r", encoding="utf-8", errors="replace") as handle:
                    handle.seek(offset)
                    while True:
                        line = handle.readline()
                        if not line:
                            offset = handle.tell()
                            break
                        offset = handle.tell()
                        fields = fields_from(line)
                        stage = fields.get("stage")
                        if stage not in ALLOWED_STAGES:
                            continue
                        safe = (
                            "[TraceOS] QEMU_UI_DIAG "
                            + line[line.find("UI_DIAG"):]
                        ).rstrip("\n")
                        emit(safe)
                        if stage == "NEW_CASE_CREATED":
                            match = UUID_RE.search(line)
                            if match:
                                probe(
                                    match.group(1),
                                    fields.get("nonce", "unknown"),
                                    fields.get("pid", "unknown"),
                                    fields.get("uid", "unknown"),
                                    fields.get("attempt", "unknown"),
                                )
        except OSError:
            pass
        time.sleep(0.25)


if __name__ == "__main__":
    raise SystemExit(main())
