Window.SetBackgroundTopColor(0.020, 0.032, 0.055);
Window.SetBackgroundBottomColor(0.010, 0.015, 0.026);

logo.image = Image("traceos-logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - 45);

brand.image = Image.Text("TRACEOS", 0.45, 0.95, 0.91);
brand.sprite = Sprite(brand.image);
brand.sprite.SetX(Window.GetWidth() / 2 - brand.image.GetWidth() / 2);
brand.sprite.SetY(Window.GetHeight() / 2 + logo.image.GetHeight() / 2 + 18);

sub.image = Image.Text("DIGITAL INVESTIGATION WORKSTATION", 0.48, 0.62, 0.82);
sub.sprite = Sprite(sub.image);
sub.sprite.SetX(Window.GetWidth() / 2 - sub.image.GetWidth() / 2);
sub.sprite.SetY(Window.GetHeight() / 2 + logo.image.GetHeight() / 2 + 48);
