#!/bin/sh
set -eu

export PIPX_GLOBAL_HOME="/opt/pipx"
export PIPX_GLOBAL_BIN_DIR="/usr/local/bin"
export PIPX_GLOBAL_MAN_DIR="/usr/local/share/man"

mkdir -p "$PIPX_GLOBAL_HOME" "$PIPX_GLOBAL_BIN_DIR" "$PIPX_GLOBAL_MAN_DIR"

install_pipx_git_tool() {
    label="$1"
    source="$2"
    echo "[TraceOS] Installing AD assessment tool: $label from $source"
    pipx install --global "$source"
}

BH_COMMIT="fd3f322e066d66314bfb31d4ae6f497df5872177"
BH_VERSION="1.9.0"
echo "[TraceOS] Installing BloodHound.py $BH_VERSION @ $BH_COMMIT"
install_pipx_git_tool "BloodHound.py $BH_VERSION" "git+https://github.com/dirkjanm/BloodHound.py@${BH_COMMIT}"
bloodhound-python -h >/dev/null 2>&1

KERBRUTE_COMMIT="9dad6e171abdc7491f587c793aa05411264a3393"
KERBRUTE_VERSION="1.0.3"
KERBRUTE_DIR="/tmp/traceos-kerbrute"

echo "[TraceOS] Building Kerbrute $KERBRUTE_VERSION @ $KERBRUTE_COMMIT"
rm -rf "$KERBRUTE_DIR"
git clone --filter=blob:none --no-checkout https://github.com/ropnop/kerbrute.git "$KERBRUTE_DIR"
cd "$KERBRUTE_DIR"
git checkout --detach "$KERBRUTE_COMMIT"
test "$(git rev-parse HEAD)" = "$KERBRUTE_COMMIT"
GOTOOLCHAIN=local CGO_ENABLED=0 go build -trimpath \
    -ldflags "-X github.com/ropnop/kerbrute/util.Version=${KERBRUTE_VERSION} -X github.com/ropnop/kerbrute/util.GitCommit=${KERBRUTE_COMMIT}" \
    -o /usr/local/bin/kerbrute .
test -x /usr/local/bin/kerbrute
/usr/local/bin/kerbrute version | grep -F "Version: $KERBRUTE_VERSION" >/dev/null
/usr/local/bin/kerbrute version | grep -F "Commit: $KERBRUTE_COMMIT" >/dev/null
rm -rf "$KERBRUTE_DIR"
cd /

cat > /usr/share/traceos/ad-assessment-tools.txt <<'EOF'
# TraceOS Block 6B: Windows / Active Directory / Authentication Assessment
# project|version|command|purpose|license|mode|provenance
dirkjanm/BloodHound.py|1.9.0|bloodhound-python|BloodHound-compatible Active Directory collection and graph-data ingestion|MIT|authorized|Git commit fd3f322e066d66314bfb31d4ae6f497df5872177
ropnop/kerbrute|1.0.3|kerbrute|Kerberos user-enumeration and authentication-assessment utility|MIT|authorized|Git commit 9dad6e171abdc7491f587c793aa05411264a3393, built from source with Debian Go
debian/hashcat|6.2.6+ds2-1|hashcat|offline password and hash recovery assessment|MIT|authorized|Debian Trixie package
debian/john|1.9.0-2|john|offline password and hash recovery assessment|GPL-2.0-or-later|authorized|Debian Trixie package
EOF

echo "[TraceOS] Block 6B AD/authentication assessment installation complete."
