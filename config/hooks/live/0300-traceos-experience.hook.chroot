#!/bin/sh
set -eu
mkdir -p /usr/share/traceos /usr/share/backgrounds/traceos /usr/share/icons/hicolor/scalable/apps \
  /usr/share/icons/hicolor/32x32/apps /usr/share/icons/hicolor/48x48/apps /usr/share/icons/hicolor/64x64/apps \
  /usr/share/icons/hicolor/128x128/apps /usr/share/icons/hicolor/256x256/apps /usr/share/plymouth/themes/traceos \
  /etc/skel/.config/xfce4/terminal /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml /etc/xdg/autostart

if command -v convert >/dev/null 2>&1; then
  convert -background none /usr/share/traceos/traceos-logo.svg -resize 512x512 /usr/share/traceos/traceos-logo.png
  convert /usr/share/backgrounds/traceos/traceos-wallpaper.svg -resize 1920x1080 /usr/share/backgrounds/traceos/traceos-wallpaper.png
  for size in 32 48 64 128 256; do
    convert -background none /usr/share/traceos/traceos-logo.svg -resize "${size}x${size}" "/usr/share/icons/hicolor/${size}x${size}/apps/traceos.png"
  done
fi

cp /usr/share/traceos/traceos-logo.png /usr/share/plymouth/themes/traceos/traceos-logo.png 2>/dev/null || true
chmod 0755 /usr/local/bin/traceos /usr/local/bin/traceos-control /usr/local/bin/traceos-welcome /usr/local/bin/traceos-shade
chmod +x /usr/share/plymouth/themes/traceos/traceos.script
if command -v plymouth-set-default-theme >/dev/null 2>&1; then
  plymouth-set-default-theme -R traceos
fi
