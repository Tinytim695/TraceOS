#!/bin/sh
set -eu

MSF_COMMIT="c6e99d08265b081d2f180086790b12811642c278"
MSF_VERSION="6.5.6"
MSF_DIR="/opt/traceos-metasploit"
MSF_BUNDLER="2.6.7"

echo "[TraceOS] Installing Metasploit Framework $MSF_VERSION @ $MSF_COMMIT"
rm -rf "$MSF_DIR"
git clone --filter=blob:none --no-checkout https://github.com/rapid7/metasploit-framework.git "$MSF_DIR"
cd "$MSF_DIR"
git checkout --detach "$MSF_COMMIT"
test "$(git rev-parse HEAD)" = "$MSF_COMMIT"
# The repository is intentionally root-owned in the live image; trust only this pinned path.
git config --system --add safe.directory "$MSF_DIR"
grep -Fx "3.3.8" .ruby-version
MSF_BUNDLER_VERSION=$(bundle "_${MSF_BUNDLER}_" --version)
test "$MSF_BUNDLER_VERSION" = "Bundler version $MSF_BUNDLER"
bundle "_${MSF_BUNDLER}_" config set --local deployment true
bundle "_${MSF_BUNDLER}_" config set --local without "development test coverage"
bundle "_${MSF_BUNDLER}_" install --jobs 4 --retry 3

# msfconsole rebuilds its Bootsnap load-path and bytecode cache in the live
# user's home. That home is empty on every boot, so startup walks thousands of
# gem files on squashfs and takes about 30 seconds under QEMU. Point Bootsnap
# at a cache built once in this hook, and do not let a live user rewrite it.
python3 - <<'PY'
from pathlib import Path
path = Path("/opt/traceos-metasploit/config/boot.rb")
text = path.read_text(encoding="utf-8")
replacements = [
(
"""  cache_metadata_path = File.join(bootsnap_config[:cache_dir], "metadata.yaml")
  if File.exist?(cache_metadata_path)
    cache_metadata = YAML.safe_load(File.binread(cache_metadata_path))
    if cache_metadata != expected_cache_metadata
      FileUtils.rm_rf(bootsnap_config[:cache_dir], secure: true)
    end
  end

  FileUtils.mkdir_p(bootsnap_config[:cache_dir])
  File.binwrite(cache_metadata_path, expected_cache_metadata.to_yaml)
""",
"""  cache_metadata_path = File.join(bootsnap_config[:cache_dir], "metadata.yaml")
  if File.exist?(cache_metadata_path)
    cache_metadata = YAML.safe_load(File.binread(cache_metadata_path))
    if cache_metadata == expected_cache_metadata && bootsnap_config[:readonly]
      return nil
    end
    if cache_metadata != expected_cache_metadata
      if bootsnap_config[:readonly]
        raise "TraceOS prebuilt bootsnap cache does not match this framework"
      end
      FileUtils.rm_rf(bootsnap_config[:cache_dir], secure: true)
    end
  elsif bootsnap_config[:readonly]
    raise "TraceOS prebuilt bootsnap cache is missing metadata"
  end

  FileUtils.mkdir_p(bootsnap_config[:cache_dir])
  File.binwrite(cache_metadata_path, expected_cache_metadata.to_yaml)
"""
),
(
"""  cache_dir = ::File.join(Msf::Config.config_directory, "bootsnap_cache")
  bootsnap_config = {
    cache_dir: cache_dir,
    ignore_directories: [],
    development_mode: development_mode,
    load_path_cache: true, # Optimize the LOAD_PATH with a cache
    compile_cache_iseq: true, # If coverage reports are inaccurate, disable this (ISeq caching bypasses Coverage tracing).
    compile_cache_yaml: false, # Don't compile YAML into a cache
    readonly: false, # Update caches - https://github.com/Shopify/bootsnap/commit/b51397f96c33aa421fd5c29484fb9574df9eb451
  }
""",
"""  cache_dir = ENV["TRACEOS_MSF_BOOTSNAP_DIR"]
  cache_dir = ::File.join(Msf::Config.config_directory, "bootsnap_cache") if cache_dir.nil? || cache_dir.empty?
  readonly = ENV["TRACEOS_MSF_BOOTSNAP_READONLY"] == "1"
  bootsnap_config = {
    cache_dir: cache_dir,
    ignore_directories: [],
    development_mode: development_mode,
    load_path_cache: true, # Optimize the LOAD_PATH with a cache
    compile_cache_iseq: true, # If coverage reports are inaccurate, disable this (ISeq caching bypasses Coverage tracing).
    compile_cache_yaml: false, # Don't compile YAML into a cache
    readonly: readonly,
  }
"""
),
(
"""rescue => e
  $stderr.puts "Warning: Failed bootsnap cache setup - #{e.class} #{e} #{e.backtrace}"
  begin
    FileUtils.rm_rf(cache_dir, secure: true)
  rescue
    $stderr.puts 'Warning: Failed deleting bootsnap cache'
  end
end
""",
"""rescue => e
  $stderr.puts "Warning: Failed bootsnap cache setup - #{e.class} #{e} #{e.backtrace}"
  unless ENV["TRACEOS_MSF_BOOTSNAP_READONLY"] == "1"
    begin
      FileUtils.rm_rf(cache_dir, secure: true)
    rescue
      $stderr.puts 'Warning: Failed deleting bootsnap cache'
    end
  end
end
"""
),
]
for old, new in replacements:
    if old not in text:
        raise SystemExit("TraceOS could not patch Metasploit config/boot.rb")
    text = text.replace(old, new, 1)
path.write_text(text, encoding="utf-8")
PY

cat > /usr/local/bin/msfconsole <<'EOF'
#!/bin/sh
set -eu
export MSF_BUNDLER="2.6.7"
export BUNDLE_GEMFILE=/opt/traceos-metasploit/Gemfile
export TRACEOS_MSF_BOOTSNAP_DIR=/var/lib/traceos/msf-bootsnap
export TRACEOS_MSF_BOOTSNAP_READONLY=1
exec /usr/bin/ruby -e 'gem "bundler", ENV.fetch("MSF_BUNDLER"); require "bundler/setup"; load ARGV.shift' -- /opt/traceos-metasploit/msfconsole "$@"
EOF
cat > /usr/local/bin/msfvenom <<'EOF'
#!/bin/sh
set -eu
export MSF_BUNDLER="2.6.7"
export BUNDLE_GEMFILE=/opt/traceos-metasploit/Gemfile
export TRACEOS_MSF_BOOTSNAP_DIR=/var/lib/traceos/msf-bootsnap
export TRACEOS_MSF_BOOTSNAP_READONLY=1
exec /usr/bin/ruby -e 'gem "bundler", ENV.fetch("MSF_BUNDLER"); require "bundler/setup"; load ARGV.shift' -- /opt/traceos-metasploit/msfvenom "$@"
EOF
cat > /usr/local/bin/msfdb <<'EOF'
#!/bin/sh
set -eu
export MSF_BUNDLER="2.6.7"
export BUNDLE_GEMFILE=/opt/traceos-metasploit/Gemfile
export TRACEOS_MSF_BOOTSNAP_DIR=/var/lib/traceos/msf-bootsnap
export TRACEOS_MSF_BOOTSNAP_READONLY=1
exec /usr/bin/ruby -e 'gem "bundler", ENV.fetch("MSF_BUNDLER"); require "bundler/setup"; load ARGV.shift' -- /opt/traceos-metasploit/msfdb "$@"
EOF
chmod 0755 /usr/local/bin/msfconsole /usr/local/bin/msfvenom /usr/local/bin/msfdb

echo "[TraceOS] Building the Metasploit Bootsnap cache"
bootsnap_dir=/var/lib/traceos/msf-bootsnap
warm_home=/var/lib/traceos/msf-warm-home
warm_log=$(mktemp /tmp/traceos-msf-warm-log.XXXXXX)
rm -rf "$bootsnap_dir" "$warm_home"
mkdir -p "$bootsnap_dir" "$warm_home"
if ! id traceos-msf-warm >/dev/null 2>&1; then
    useradd --system --home-dir "$warm_home" --shell /bin/sh traceos-msf-warm
fi
chown -R traceos-msf-warm:traceos-msf-warm "$bootsnap_dir" "$warm_home"
# timeout(1) cannot call a shell function. msfdb also aborts before --help when uid is 0.
warm_cmd=$(mktemp /tmp/traceos-msf-run-warm.XXXXXX)
cat > "$warm_cmd" <<EOF
#!/bin/sh
set -eu
cd "$MSF_DIR"
exec bundle "_${MSF_BUNDLER}_" exec ruby "\$@"
EOF
chmod 0755 "$warm_cmd"
timeout 180 runuser -u traceos-msf-warm -- env HOME="$warm_home" BUNDLE_GEMFILE="$MSF_DIR/Gemfile" TRACEOS_MSF_BOOTSNAP_DIR="$bootsnap_dir" TRACEOS_MSF_BOOTSNAP_READONLY= "$warm_cmd" "$MSF_DIR/msfconsole" --version
timeout 180 runuser -u traceos-msf-warm -- env HOME="$warm_home" BUNDLE_GEMFILE="$MSF_DIR/Gemfile" TRACEOS_MSF_BOOTSNAP_DIR="$bootsnap_dir" TRACEOS_MSF_BOOTSNAP_READONLY= "$warm_cmd" "$MSF_DIR/msfdb" --help
set +e
timeout 180 runuser -u traceos-msf-warm -- env HOME="$warm_home" BUNDLE_GEMFILE="$MSF_DIR/Gemfile" TRACEOS_MSF_BOOTSNAP_DIR="$bootsnap_dir" TRACEOS_MSF_BOOTSNAP_READONLY= "$warm_cmd" "$MSF_DIR/msfvenom" --help >"$warm_log" 2>&1
venom_status=$?
set -e
if [ "$venom_status" -ne 1 ]; then
    echo "[TraceOS] msfvenom --help warm-up failed: ${venom_status}" >&2
    cat "$warm_log" >&2
    exit 1
fi
started=$(date +%s)
set +e
timeout 45 runuser -u traceos-msf-warm -- env HOME="$warm_home" BUNDLE_GEMFILE="$MSF_DIR/Gemfile" TRACEOS_MSF_BOOTSNAP_DIR="$bootsnap_dir" TRACEOS_MSF_BOOTSNAP_READONLY=1 "$warm_cmd" "$MSF_DIR/msfconsole" --version >"$warm_log" 2>&1
proof_status=$?
set -e
finished=$(date +%s)
echo "[TraceOS] cached msfconsole --version took $((finished - started))s"
if [ "$proof_status" -ne 0 ] || grep -q "Failed bootsnap cache setup" "$warm_log" || ! grep -q "Framework Version:" "$warm_log"; then
    echo "[TraceOS] prebuilt Bootsnap cache did not serve msfconsole --version (status ${proof_status})" >&2
    cat "$warm_log" >&2
    exit 1
fi
rm -f "$warm_cmd"
test -s "$bootsnap_dir/metadata.yaml"
chown -R root:root "$bootsnap_dir"
chmod -R a+rX "$bootsnap_dir"
userdel traceos-msf-warm
if id traceos-msf-warm >/dev/null 2>&1; then
    echo "[TraceOS] Metasploit warm-up user was left in the image" >&2
    exit 1
fi
rm -rf "$warm_home" "$warm_log"

E4L_COMMIT="f34e7bb"
E4L_VERSION="1.3.10"
E4L_DIR="/opt/traceos-enum4linux-ng"
echo "[TraceOS] Installing enum4linux-ng $E4L_VERSION"
rm -rf "$E4L_DIR"
git clone --filter=blob:none --no-checkout https://github.com/cddmp/enum4linux-ng.git "$E4L_DIR"
cd "$E4L_DIR"
git checkout --detach "$E4L_COMMIT"
test "$(git rev-parse --short=7 HEAD)" = "$E4L_COMMIT"
python3 -m venv "$E4L_DIR/venv"
"$E4L_DIR/venv/bin/pip" install --no-cache-dir --disable-pip-version-check -r requirements.txt
"$E4L_DIR/venv/bin/pip" check

cat > /usr/local/bin/enum4linux-ng <<'EOF'
#!/bin/sh
set -eu
exec /opt/traceos-enum4linux-ng/venv/bin/python /opt/traceos-enum4linux-ng/enum4linux-ng.py "$@"
EOF
chmod 0755 /usr/local/bin/enum4linux-ng

cat > /usr/share/traceos/offensive-operations-tools.txt <<'EOF'
# TraceOS Block 6A: Offensive Operations Foundation
# project|version|command|purpose|license|mode|provenance
rapid7/metasploit-framework|6.5.6|msfconsole,msfvenom,msfdb|authorized exploitation framework, payload generation and assessment workspace|BSD-3-Clause core plus component licenses|authorized|Git commit c6e99d08265b081d2f180086790b12811642c278
cddmp/enum4linux-ng|1.3.10|enum4linux-ng|Windows/Samba SMB and RPC enumeration with structured YAML/JSON output|GPL-3.0|authorized|Git commit f34e7bb (v1.3.10)
EOF

cd /
echo "[TraceOS] Block 6A offensive operations installation complete."
