#!/bin/sh
set -eu

src=/usr/share/backgrounds/traceos/traceos-wallpaper.svg
dst=/usr/share/backgrounds/traceos/traceos-wallpaper.png

test -s "$src"
# ImageMagick's own SVG renderer paints this file black. The Gaussian glow
# becomes an empty transparent PNG, and XFCE then shows a black desktop.
# librsvg keeps the luminous landscape. Do not fall back to convert.
if ! command -v rsvg-convert >/dev/null 2>&1; then
  echo "[TraceOS] rsvg-convert is required to render the wallpaper." >&2
  exit 1
fi
rsvg-convert --width=1920 --height=1080 --output "$dst" "$src"
chmod 0644 "$dst"
test -s "$dst"
wallpaper_dimensions="$(identify -format '%w %h' "$dst")"
test "$wallpaper_dimensions" = "1920 1080"
# Mean is 0..1. The landscape measures about 0.40. The broken render measured 0.
wallpaper_mean="$(convert "$dst" -format '%[fx:mean]' info:)"
if ! awk -v mean="$wallpaper_mean" 'BEGIN { exit !(mean+0 > 0.25) }'; then
  echo "[TraceOS] Wallpaper render is too dark (mean=$wallpaper_mean)." >&2
  exit 1
fi
echo "[TraceOS] Wallpaper rendered at ${wallpaper_dimensions}, mean luminance ${wallpaper_mean}."
chmod 0755 /usr/local/bin/traceos-launcher /usr/local/bin/traceos-desktop-setup
test -x /usr/local/bin/traceos-launcher
test -x /usr/local/bin/traceos-desktop-setup
test -s /usr/share/desktop-directories/traceos.directory

# Register a first-class TraceOS category in the existing XFCE applications menu.
# Preserve the other Debian categories and validate the menu XML before writing it.
python3 - <<'PY'
from pathlib import Path
import re
import xml.etree.ElementTree as ET

menu_file = Path("/etc/xdg/menus/xfce-applications.menu")
if not menu_file.is_file():
    raise SystemExit("[TraceOS] Required XFCE applications menu is missing.")
text = menu_file.read_text(encoding="utf-8")
marker = "TRACEOS-CUSTOM-MENU-BEGIN"
if marker not in text and "<Name>TraceOS</Name>" not in text:
    token_re = re.compile(r"<(/?)([A-Za-z][A-Za-z0-9:_-]*)(?:\s[^<>]*?)?(/?)>")
    depth = 0
    layout_end = None
    for match in token_re.finditer(text):
        closing, name, self_closing = match.group(1), match.group(2), match.group(3)
        if closing:
            depth -= 1
        else:
            if name == "Layout" and depth == 1 and layout_end is None:
                layout_end = match.end()
            if not self_closing:
                depth += 1
    if layout_end is None:
        raise SystemExit("[TraceOS] Could not locate the root XFCE menu layout.")
    text = text[:layout_end] + "\n    <Menuname>TraceOS</Menuname>" + text[layout_end:]
    root_close = text.rfind("</Menu>")
    if root_close < 0:
        raise SystemExit("[TraceOS] Could not locate root XFCE menu closing tag.")
    block = (
        "\n  <!-- TRACEOS-CUSTOM-MENU-BEGIN -->\n"
        "  <Menu>\n"
        "    <Name>TraceOS</Name>\n"
        "    <Directory>traceos.directory</Directory>\n"
        "    <Include><Category>TraceOS</Category></Include>\n"
        "  </Menu>\n"
        "  <!-- TRACEOS-CUSTOM-MENU-END -->\n"
    )
    text = text[:root_close] + block + text[root_close:]
ET.fromstring(text)
if "<Menuname>TraceOS</Menuname>" not in text or "<Category>TraceOS</Category>" not in text:
    raise SystemExit("[TraceOS] XFCE menu is missing the TraceOS category.")
menu_file.write_text(text, encoding="utf-8")
print("[TraceOS] Added and validated TraceOS category in XFCE menu.")
PY
if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database /usr/share/applications >/dev/null 2>&1 || true
fi
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -f -t /usr/share/icons/hicolor >/dev/null 2>&1 || true
fi
