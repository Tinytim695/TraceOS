#!/bin/sh
set -eu

export PIPX_GLOBAL_HOME="/opt/pipx"
export PIPX_GLOBAL_BIN_DIR="/usr/local/bin"
export PIPX_GLOBAL_MAN_DIR="/usr/local/share/man"
export DEBIAN_FRONTEND=noninteractive

mkdir -p "$PIPX_GLOBAL_HOME" "$PIPX_GLOBAL_BIN_DIR" "$PIPX_GLOBAL_MAN_DIR"

require_surface() {
    binary="$1"
    needle="$2"
    shift 2
    cd /tmp
    if output="$("$binary" "$@" 2>&1)"; then
        status=0
    else
        status=$?
    fi
    printf '%s\n' "$output"
    test "$status" -eq 0
    printf '%s\n' "$output" | grep -F "$needle" >/dev/null
    cd /
}

install_verified_file() {
    dest="$1"
    digest="$2"
    url="$3"
    filename="$4"
    tmp="/tmp/traceos-cred-$dest"

    echo "[TraceOS] Installing pinned binary $dest"
    rm -rf "$tmp"
    mkdir -p "$tmp"
    curl -fsSL --retry 5 --retry-delay 2 --max-time 900 "$url" -o "$tmp/$filename"
    printf '%s  %s\n' "$digest" "$tmp/$filename" | sha256sum -c -
    install -m 0755 "$tmp/$filename" "/usr/local/bin/$dest"
    rm -rf "$tmp"
}

install_verified_tarball_bin() {
    dest="$1"
    inner="$2"
    digest="$3"
    url="$4"
    filename="$5"
    tmp="/tmp/traceos-cred-$dest"

    echo "[TraceOS] Installing pinned release $dest"
    rm -rf "$tmp"
    mkdir -p "$tmp/extract"
    curl -fsSL --retry 5 --retry-delay 2 --max-time 900 "$url" -o "$tmp/$filename"
    printf '%s  %s\n' "$digest" "$tmp/$filename" | sha256sum -c -
    tar --no-same-owner -xzf "$tmp/$filename" -C "$tmp/extract"
    test -f "$tmp/extract/$inner"
    install -m 0755 "$tmp/extract/$inner" "/usr/local/bin/$dest"
    rm -rf "$tmp"
}

echo "[TraceOS] Installing ExifTool"
apt-get update
apt-get install -y --no-install-recommends libimage-exiftool-perl
# -h selects HTML formatting, not help. With no file the Debian package
# prints a short syntax line that does not contain "ExifTool", so the
# surface check failed the ISO build. -ver -v exits 0 and names itself.
require_surface /usr/bin/exiftool "ExifTool version" -ver -v

install_verified_tarball_bin trufflehog trufflehog \
    029b182e0ed35fd5b02cd1eadc2a94bd457ab14ad22a9380b6e5d9652261d28d \
    https://github.com/trufflesecurity/trufflehog/releases/download/v3.99.3/trufflehog_3.99.3_linux_amd64.tar.gz \
    trufflehog_3.99.3_linux_amd64.tar.gz
require_surface /usr/local/bin/trufflehog 3.99.3 --version

install_verified_tarball_bin noseyparker bin/noseyparker \
    013b06f1f29271150585cb35d2a150929871126f51715744714ad5843179f57c \
    https://github.com/praetorian-inc/noseyparker/releases/download/v0.24.0/noseyparker-v0.24.0-x86_64-unknown-linux-musl.tar.gz \
    noseyparker-v0.24.0-x86_64-unknown-linux-musl.tar.gz
require_surface /usr/local/bin/noseyparker 0.24.0 --version

echo "[TraceOS] Installing Chainsaw 2.17.1 and pinned Sigma Windows rules"
tmp="/tmp/traceos-cred-chainsaw"
rm -rf "$tmp" /opt/traceos-chainsaw
mkdir -p "$tmp"
curl -fsSL --retry 5 --retry-delay 2 --max-time 900 \
    https://github.com/WithSecureLabs/chainsaw/releases/download/v2.17.1/chainsaw_x86_64-unknown-linux-gnu.tar.gz \
    -o "$tmp/chainsaw.tar.gz"
printf '%s  %s\n' fc25f1eafbbff3e858d8dfba508d5e227bb56ef4dccc4d5cd0bbd6e49798cb4f "$tmp/chainsaw.tar.gz" | sha256sum -c -
tar --no-same-owner -xzf "$tmp/chainsaw.tar.gz" -C /opt
mv /opt/chainsaw /opt/traceos-chainsaw
chmod 0755 /opt/traceos-chainsaw/chainsaw
ln -sfn /opt/traceos-chainsaw/chainsaw /usr/local/bin/chainsaw
rm -rf "$tmp"
require_surface /usr/local/bin/chainsaw 2.17.1 --version

SIGMA_COMMIT="05d1031f537e830b76da53bae2400c5814c89165"
rm -rf /opt/traceos-sigma
git clone --filter=blob:none --sparse https://github.com/SigmaHQ/sigma.git /opt/traceos-sigma
git -C /opt/traceos-sigma sparse-checkout set rules/windows
git -C /opt/traceos-sigma checkout --detach "$SIGMA_COMMIT"
test "$(git -C /opt/traceos-sigma rev-parse HEAD)" = "$SIGMA_COMMIT"
test -d /opt/traceos-sigma/rules/windows
test -f /opt/traceos-chainsaw/mappings/sigma-event-logs-all.yml

echo "[TraceOS] Installing capa 10.0.0"
tmp="/tmp/traceos-cred-capa"
rm -rf "$tmp"
mkdir -p "$tmp"
curl -fsSL --retry 5 --retry-delay 2 --max-time 900 \
    https://github.com/mandiant/capa/releases/download/v10.0.0/capa-v10.0.0-linux.zip \
    -o "$tmp/capa.zip"
printf '%s  %s\n' 96cb5115f495024a478b0e9f9f77f9027058155589235fbd4c50e7382055fcca "$tmp/capa.zip" | sha256sum -c -
unzip -q -o "$tmp/capa.zip" -d "$tmp"
install -m 0755 "$tmp/capa" /usr/local/bin/capa
rm -rf "$tmp"
require_surface /usr/local/bin/capa capa -h

echo "[TraceOS] Installing osquery 5.24.0"
tmp="/tmp/traceos-cred-osquery"
rm -rf "$tmp"
mkdir -p "$tmp"
curl -fsSL --retry 5 --retry-delay 2 --max-time 900 \
    https://github.com/osquery/osquery/releases/download/5.24.0/osquery_5.24.0-1.linux_amd64.deb \
    -o "$tmp/osquery.deb"
printf '%s  %s\n' 8ae0416d85336a1aea6883920ae9c2751a98538fe0bb624822e92934d3be5592 "$tmp/osquery.deb" | sha256sum -c -
dpkg -i "$tmp/osquery.deb"
rm -rf "$tmp"
# The package ships a unit and an init script. Leave both disabled.
rm -f /etc/systemd/system/multi-user.target.wants/osqueryd.service
rm -f /etc/systemd/system/osqueryd.service
rm -f /etc/init.d/osqueryd
require_surface /usr/bin/osqueryi 5.24.0 --version

echo "[TraceOS] Installing Velociraptor 0.77.3 musl build"
tmp="/tmp/traceos-cred-velociraptor"
rm -rf "$tmp"
mkdir -p "$tmp"
curl -fsSL --retry 5 --retry-delay 2 --max-time 900 \
    https://github.com/Velocidex/velociraptor/releases/download/v0.77.3/velociraptor-v0.77.3-linux-amd64-musl.gz \
    -o "$tmp/velociraptor.gz"
printf '%s  %s\n' b4699d7ecfd5c0d656d86379e41f0eb34b0f12c3cb45398f1e747f10844d7930 "$tmp/velociraptor.gz" | sha256sum -c -
gzip -dc "$tmp/velociraptor.gz" > /usr/local/bin/velociraptor
chmod 0755 /usr/local/bin/velociraptor
rm -rf "$tmp"
require_surface /usr/local/bin/velociraptor 0.77.3 version

echo "[TraceOS] Installing pypykatz 0.6.13"
pipx install --global pypykatz==0.6.13
require_surface /usr/local/bin/pypykatz pypykatz lsa minidump -h

echo "[TraceOS] Installing DonPAPI 2.0.1"
pipx install --global donpapi==2.0.1
require_surface /usr/local/bin/donpapi donpapi -h

echo "[TraceOS] Installing cloud_enum @ 21af4f9b0899bebb8f0b6dd4c0839eec33d2bb19"
pipx install --global "git+https://github.com/initstring/cloud_enum.git@21af4f9b0899bebb8f0b6dd4c0839eec33d2bb19"
require_surface /usr/local/bin/cloud_enum cloud_enum -h

cat > /usr/share/traceos/credential-defence-tools.txt <<'EOF'
# TraceOS credential, defence and OSINT additions
# project|version|command|purpose|license|mode|provenance
trufflesecurity/trufflehog|3.99.3|trufflehog|Local filesystem secret scan, verification disabled|AGPL-3.0|authorized|GitHub release v3.99.3 linux amd64 sha256 029b182e0ed35fd5b02cd1eadc2a94bd457ab14ad22a9380b6e5d9652261d28d
praetorian-inc/noseyparker|0.24.0|noseyparker|Local secret scan into a datastore on this machine|Apache-2.0|authorized|GitHub release v0.24.0 musl sha256 013b06f1f29271150585cb35d2a150929871126f51715744714ad5843179f57c
skelsec/pypykatz|0.6.13|pypykatz|Offline minidump credential parsing|Apache-2.0|local|PyPI pypykatz 0.6.13
login-securite/DonPAPI|2.0.1|donpapi|DPAPI collection console, not started by the dashboard|GPL-3.0|authorized|PyPI donpapi 2.0.1
WithSecureLabs/chainsaw|2.17.1|chainsaw|Windows event-log hunt with pinned Sigma rules|GPL-3.0|local|GitHub release v2.17.1 sha256 fc25f1eafbbff3e858d8dfba508d5e227bb56ef4dccc4d5cd0bbd6e49798cb4f
SigmaHQ/sigma|05d1031f537e830b76da53bae2400c5814c89165|rules/windows|Sigma Windows rules used only by Chainsaw|LGPL-2.1|local|Git commit 05d1031f537e830b76da53bae2400c5814c89165 sparse rules/windows
mandiant/capa|10.0.0|capa|Binary capability report|Apache-2.0|local|GitHub release v10.0.0 linux zip sha256 96cb5115f495024a478b0e9f9f77f9027058155589235fbd4c50e7382055fcca
osquery/osquery|5.24.0|osqueryi|Local endpoint query, daemon not enabled|Apache-2.0 or GPL-2.0|local|GitHub deb 5.24.0 sha256 8ae0416d85336a1aea6883920ae9c2751a98538fe0bb624822e92934d3be5592
Velocidex/velociraptor|0.77.3|velociraptor|Local VQL query, server not started|AGPL-3.0|local|GitHub musl build v0.77.3 sha256 b4699d7ecfd5c0d656d86379e41f0eb34b0f12c3cb45398f1e747f10844d7930
PhilHarvey/exiftool|debian|exiftool|Local file metadata|GPL-1.0-or-later or Artistic|local|Debian package libimage-exiftool-perl
initstring/cloud_enum|0.9|cloud_enum|Public cloud resource name enumeration|MIT|authorized|Git commit 21af4f9b0899bebb8f0b6dd4c0839eec33d2bb19
EOF

echo "[TraceOS] Credential, defence and OSINT tool installation complete."
