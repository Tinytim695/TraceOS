#!/bin/sh
set -eu

# ProjectDiscovery Block 1: infrastructure recon.
# Each amd64 release is pinned by version and verified against the SHA-256
# digest published in the corresponding GitHub release metadata before the
# binary is copied into the final image.
install_pd_tool() {
    name="$1"
    version="$2"
    archive="$3"
    digest="$4"
    url="$5"
    tmp="/tmp/traceos-pd-$name"

    echo "[TraceOS] Installing ProjectDiscovery $name $version"
    cd /
    rm -rf "$tmp"
    mkdir -p "$tmp"
    cd "$tmp"

    curl -fsSL --retry 5 --retry-delay 2 --max-time 180 "$url" -o "$archive"
    printf '%s  %s\n' "${digest#sha256:}" "$archive" | sha256sum -c -

    binary="$tmp/$name"
    entry="$(unzip -Z1 "$archive" | awk -v wanted="$name" '
        $0 == wanted { print; exit }
        $0 ~ ("/" wanted "$") { print; exit }
    ')"
    test -n "$entry"
    unzip -p "$archive" "$entry" > "$binary"
    chmod 0755 "$binary"
    test -x "$binary"

    if version_output="$("$binary" -version 2>&1)"; then
        version_status=0
    else
        version_status=$?
    fi
    printf '%s\n' "$version_output"
    test "$version_status" -eq 0
    printf '%s\n' "$version_output" | grep -F "$version" >/dev/null

    install -m 0755 "$binary" "/usr/local/bin/$name"

    rm -rf "$tmp"
    cd /
}

install_pd_tool   subfinder   2.16.0   subfinder_2.16.0_linux_amd64.zip   sha256:1b7f9c608e9a5bd59e609a5e09710d63c5485e92d3d49dc2c16eb4fdbe10cb60   https://github.com/projectdiscovery/subfinder/releases/download/v2.16.0/subfinder_2.16.0_linux_amd64.zip

install_pd_tool   dnsx   1.3.1   dnsx_1.3.1_linux_amd64.zip   sha256:438b964653056dd51dcfe614b1a16f8bced3cc48a1d27bc07cc6fdf2ef2a9533   https://github.com/projectdiscovery/dnsx/releases/download/v1.3.1/dnsx_1.3.1_linux_amd64.zip

install_pd_tool   httpx   1.12.0   httpx_1.12.0_linux_amd64.zip   sha256:9d8439e8b6c9aa7d1e2314817a392e00d5178da3af5652f7475f88868f418f76   https://github.com/projectdiscovery/httpx/releases/download/v1.12.0/httpx_1.12.0_linux_amd64.zip

install_pd_tool   naabu   2.6.1   naabu_2.6.1_linux_amd64.zip   sha256:018c4c9884dea971eda860435ede3021d1150732f34cfd245498c6726d8cab90   https://github.com/projectdiscovery/naabu/releases/download/v2.6.1/naabu_2.6.1_linux_amd64.zip

install_pd_tool   katana   1.8.0   katana_1.8.0_linux_amd64.zip   sha256:cb027ae99d0757061b70c07a15c7a80f62c5a535ab52c4a329f80c4b0a7309d2   https://github.com/projectdiscovery/katana/releases/download/v1.8.0/katana_1.8.0_linux_amd64.zip

install_pd_tool   urlfinder   0.0.3   urlfinder_0.0.3_linux_amd64.zip   sha256:655ea7378a0555149831dcc4c3f6aef34f3ce27eda0ce2f2721e2ca5526015d4   https://github.com/projectdiscovery/urlfinder/releases/download/v0.0.3/urlfinder_0.0.3_linux_amd64.zip

echo "[TraceOS] Installing OWASP Amass 5.1.1"
amass_tmp="/tmp/traceos-amass"
rm -rf "$amass_tmp"
mkdir -p "$amass_tmp" /usr/libexec/traceos /usr/share/traceos/amass
cd "$amass_tmp"
curl -fsSL --retry 5 --retry-delay 2 --max-time 180 \
    -o amass_linux_amd64.tar.gz \
    https://github.com/owasp-amass/amass/releases/download/v5.1.1/amass_linux_amd64.tar.gz
printf '%s  %s\n' "5e22b5f0239e7eb79439d60d43d3cd20dca2478588bc2242e91ab0c4f8fa40dd" amass_linux_amd64.tar.gz | sha256sum -c -
tar --no-same-owner -xzf amass_linux_amd64.tar.gz
test -x amass_linux_amd64/amass
install -m 0755 amass_linux_amd64/amass /usr/libexec/traceos/amass
cp -a amass_linux_amd64/resources/. /usr/share/traceos/amass/
check_amass_version() {
    amass_binary="$1"
    expected_version="$2"

    # Amass may emit its version on stderr. Capture both streams before checking.
    if ! amass_version_output="$("$amass_binary" -version 2>&1)"; then
        printf '[TraceOS] Amass version probe failed for %s.\n' "$amass_binary" >&2
        printf '%s\n' "$amass_version_output" >&2
        return 1
    fi

    printf '%s\n' "$amass_version_output"
    if ! printf '%s\n' "$amass_version_output" | grep -F "$expected_version" >/dev/null; then
        printf '[TraceOS] Amass version output did not contain expected version %s.\n' "$expected_version" >&2
        return 1
    fi
}

check_amass_version /usr/libexec/traceos/amass 5.1.1
cat > /usr/local/bin/amass <<'EOF'
#!/bin/sh
set -eu
cfg="${XDG_CONFIG_HOME:-$HOME/.config}/amass"
mkdir -p "$cfg"
if [ ! -f "$cfg/config.yaml" ]; then
    cp -a /usr/share/traceos/amass/. "$cfg/"
fi
exec /usr/libexec/traceos/amass "$@"
EOF
chmod 0755 /usr/local/bin/amass
rm -rf "$amass_tmp"
cd /

# projectdiscovery-tools.txt under config/includes.chroot is the authoritative
# inventory. This hook installs the pinned binaries only and does not rewrite
# the checked-in manifest.
echo "[TraceOS] ProjectDiscovery Block 1 installation complete."
