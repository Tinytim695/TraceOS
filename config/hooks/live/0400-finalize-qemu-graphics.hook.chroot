#!/bin/sh
set -eu

# Keep the live image's desktop target and display manager explicitly enabled.
# The QEMU bootstrap symlink is created by 0110-enable-qemu-graphics.hook.chroot.
# Re-running "systemctl enable" here is redundant and can fail in the live-build
# chroot even though the unit is already enabled.
systemctl enable lightdm.service
systemctl set-default graphical.target

test -L /etc/systemd/system/graphical.target.wants/lightdm.service
test -L /etc/systemd/system/multi-user.target.wants/traceos-qemu-graphics.service
