#!/bin/sh
set -eu

# LightDM owns the graphical login through the display-manager.service alias.
# Keep graphical.target as the default and validate that the TraceOS QEMU
# bootstrap is ordered with the graphical session rather than multi-user.target.
systemctl enable lightdm.service
systemctl set-default graphical.target

test -L /etc/systemd/system/default.target
test -L /etc/systemd/system/display-manager.service
test -L /etc/systemd/system/graphical.target.wants/traceos-qemu-graphics.service
test -f /usr/local/sbin/traceos-qemu-ui-diagnostics
test -L /etc/systemd/system/graphical.target.wants/traceos-qemu-ui-diagnostics.service
