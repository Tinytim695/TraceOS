#!/bin/sh
set -eu

# LightDM's native systemd unit uses the display-manager.service alias.
# The QEMU bootstrap is deliberately ordered after LightDM and live-config so
# the live user/autologin environment exists before the VM-only restart.
systemctl enable lightdm.service
systemctl set-default graphical.target

test -L /etc/systemd/system/default.target
test -L /etc/systemd/system/display-manager.service
test -L /etc/systemd/system/graphical.target.wants/traceos-qemu-graphics.service
