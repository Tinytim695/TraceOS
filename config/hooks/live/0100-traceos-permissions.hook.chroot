#!/bin/sh
set -e

chmod 0755 /usr/local/bin/traceos
chmod 0755 /usr/local/bin/traceos-control
chmod 0755 /usr/local/bin/traceos-session
chmod 0755 /usr/local/bin/traceos-osint
chmod 0755 /usr/local/bin/traceos-update
chmod 0755 /usr/local/bin/traceos-session-hardening
chmod 0755 /usr/local/bin/traceos-evidence-mount
chmod 0755 /usr/local/bin/traceos-evidence-umount
chmod 0755 /usr/local/bin/blackbird
mkdir -p /usr/share/traceos
mkdir -p /etc/skel/Cases

# Keep the live image usable without making the build assume a real password.
if id traceos >/dev/null 2>&1; then
    usermod -aG sudo,netdev,plugdev traceos || true
fi
