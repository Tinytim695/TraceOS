-----END PGP PUBLIC KEY BLOCK-----
TRACEOS_METASPLOIT_KEY
gpg --batch --show-keys --with-colons /tmp/metasploit-framework.asc > /tmp/metasploit-key-info.txt
key_id="$(awk -F: '$1 == "pub" { print toupper($5); exit }' /tmp/metasploit-key-info.txt)"
test "$key_id" = "C048F0B49DEEC457"
gpg --batch --dearmor --output /usr/share/keyrings/metasploit-framework.gpg /tmp/metasploit-framework.asc
chmod 0644 /usr/share/keyrings/metasploit-framework.gpg
printf '%s\n' 'deb [arch=amd64 signed-by=/usr/share/keyrings/metasploit-framework.gpg] https://downloads.metasploit.com/data/releases/metasploit-framework/apt lucid main' > /etc/apt/sources.list.d/metasploit-framework.list
printf '%s\n' 'Package: metasploit-framework' 'Pin: version *' 'Pin-Priority: -1' '' 'Package: metasploit-framework' 'Pin: origin downloads.metasploit.com' 'Pin-Priority: 1001' > /etc/apt/preferences.d/traceos-metasploit
apt-get -o Acquire::Retries=5 update
apt-get install -y --no-install-recommends "metasploit-framework=${METASPLOIT_VERSION}"
msfconsole --version
zap.sh -cmd -silent -version
rm -f /etc/apt/sources.list.d/metasploit-framework.list /usr/share/keyrings/metasploit-framework.gpg /etc/apt/preferences.d/traceos-metasploit
rm -f /tmp/metasploit-key-info.txt /tmp/metasploit-framework.asc

echo "[TraceOS] Web assessment tools installed."
