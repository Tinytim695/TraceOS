#!/bin/sh
set -eu

ZAP_VERSION="2.17.0"
ZAP_SHA256="efe799aaa3627db683b43f00c9c210aea0b75c00cc8f0a0f0434d12bb3ddde5a"
METASPLOIT_VERSION="6.5.3~20260818061200~1rapid7-1"

echo "[TraceOS] Installing pinned OWASP ZAP ${ZAP_VERSION}."
tmp_tar="$(mktemp)"
trap 'rm -f "$tmp_tar" /tmp/metasploit-framework.asc /tmp/metasploit-key-info.txt' EXIT
curl -fsSL --retry 5 --retry-delay 2 --max-time 300 \
  "https://github.com/zaproxy/zaproxy/releases/download/v${ZAP_VERSION}/ZAP_2.17.0_Linux.tar.gz" \
  -o "$tmp_tar"
printf '%s  %s\n' "$ZAP_SHA256" "$tmp_tar" | sha256sum -c -
install -d -m 0755 /opt/traceos-zap
tar -xzf "$tmp_tar" -C /opt/traceos-zap --strip-components=1
test -f /opt/traceos-zap/zap.sh
chmod 0755 /opt/traceos-zap/zap.sh
ln -sfn /opt/traceos-zap/zap.sh /usr/local/bin/zap.sh

echo "[TraceOS] Installing pinned Metasploit Framework ${METASPLOIT_VERSION}."
