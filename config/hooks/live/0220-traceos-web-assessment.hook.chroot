#!/bin/sh
set -eu

install_zip_tool() {
    name="$1"
    version="$2"
    archive="$3"
    digest="$4"
    url="$5"
    tmp="/tmp/traceos-web-$name"

    echo "[TraceOS] Installing web assessment tool $name $version"
    rm -rf "$tmp"
    mkdir -p "$tmp"
    cd "$tmp"

    curl -fsSL --retry 5 --retry-delay 2 --max-time 300 "$url" -o "$archive"
    printf '%s  %s\n' "${digest#sha256:}" "$archive" | sha256sum -c -

    entry="$(unzip -Z1 "$archive" | awk -v wanted="$name" '
        $0 == wanted { print; exit }
        $0 ~ ("/" wanted "$") { print; exit }
    ')"
    test -n "$entry"
    unzip -p "$archive" "$entry" > "$tmp/$name"
    chmod 0755 "$tmp/$name"
    test -x "$tmp/$name"

    version_output="$("$tmp/$name" -version 2>&1)"
    printf '%s\n' "$version_output"
    printf '%s\n' "$version_output" | grep -F "$version" >/dev/null

    install -m 0755 "$tmp/$name" "/usr/local/bin/$name"
    rm -rf "$tmp"
    cd /
}

install_tar_tool() {
    name="$1"
    version="$2"
    archive="$3"
    digest="$4"
    url="$5"

    tmp="/tmp/traceos-web-$name"
    rm -rf "$tmp"
    mkdir -p "$tmp"
    cd "$tmp"

    echo "[TraceOS] Installing web assessment tool $name $version"
    curl -fsSL --retry 5 --retry-delay 2 --max-time 300 "$url" -o "$archive"
    printf '%s  %s\n' "${digest#sha256:}" "$archive" | sha256sum -c -

    mkdir -p extract
    tar -xzf "$archive" -C extract
    binary="$(find extract -type f -name "$name" -print -quit)"
    test -n "$binary"
    chmod 0755 "$binary"
    test -x "$binary"

    version_output="$("$binary" --version 2>&1)"
    printf '%s\n' "$version_output"
    printf '%s\n' "$version_output" | grep -F "$version" >/dev/null

    install -m 0755 "$binary" "/usr/local/bin/$name"
    rm -rf "$tmp"
    cd /
}

install_zip_tool nuclei 3.11.1 \
    nuclei_3.11.1_linux_amd64.zip \
    sha256:ea63d4ae232808cd7c6bc00d0142428e231fab59dae01042246097d195835ab6 \
    https://github.com/projectdiscovery/nuclei/releases/download/v3.11.1/nuclei_3.11.1_linux_amd64.zip

install_tar_tool dalfox 3.2.3 \
    dalfox-v3.2.3-linux-x86_64.tar.gz \
    sha256:3b059b6bb55e686b5f240852ea6a6750aa5e35a3b404e4027ffe505e2b60a470 \
    https://github.com/hahwul/dalfox/releases/download/v3.2.3/dalfox-v3.2.3-linux-x86_64.tar.gz

ZAP_VERSION=2.17.0
ZAP_ARCHIVE="ZAP_${ZAP_VERSION}_Linux.tar.gz"
ZAP_SHA256="sha256:efe799aaa3627db683b43f00c9c210aea0b75c00cc8f0a0f0434d12bb3ddde5a"
ZAP_URL="https://github.com/zaproxy/zaproxy/releases/download/v${ZAP_VERSION}/${ZAP_ARCHIVE}"
ZAP_TMP="/tmp/traceos-web-zap"

echo "[TraceOS] Installing OWASP ZAP $ZAP_VERSION"
rm -rf "$ZAP_TMP" /opt/traceos-zap
mkdir -p "$ZAP_TMP" /opt/traceos-zap
cd "$ZAP_TMP"
curl -fsSL --retry 5 --retry-delay 2 --max-time 600 "$ZAP_URL" -o "$ZAP_ARCHIVE"
printf '%s  %s\n' "${ZAP_SHA256#sha256:}" "$ZAP_ARCHIVE" | sha256sum -c -
tar -xzf "$ZAP_ARCHIVE" -C /opt/traceos-zap --strip-components=1
test -x /opt/traceos-zap/zap.sh
cat > /usr/local/bin/zap <<'EOF'
#!/bin/sh
exec /opt/traceos-zap/zap.sh "$@"
EOF
chmod 0755 /usr/local/bin/zap
/usr/local/bin/zap -version 2>&1 | grep -F "$ZAP_VERSION" >/dev/null
rm -rf "$ZAP_TMP"
cd /

cat > /usr/share/traceos/web-assessment-tools.txt <<'EOF'
# TraceOS Block 2: Web Application Assessment
# project|version|command|purpose|license|asset_sha256|mode
projectdiscovery/nuclei|3.11.1|nuclei|template-driven vulnerability and misconfiguration detection|MIT|ea63d4ae232808cd7c6bc00d0142428e231fab59dae01042246097d195835ab6|authorized
hahwul/dalfox|3.2.3|dalfox|XSS-focused parameter and web assessment|MIT|3b059b6bb55e686b5f240852ea6a6750aa5e35a3b404e4027ffe505e2b60a470|authorized
zaproxy/zaproxy|2.17.0|zap|web application security proxy, passive analysis and authorized active testing|Apache-2.0|efe799aaa3627db683b43f00c9c210aea0b75c00cc8f0a0f0434d12bb3ddde5a|authorized
debian/nikto|1:2.1.5-3.1|nikto|web server and CGI security checks|GPL-3.0-only|debian-package|authorized
EOF

echo "[TraceOS] Block 2 web assessment installation complete."
