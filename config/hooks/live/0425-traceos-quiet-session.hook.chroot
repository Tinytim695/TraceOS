#!/bin/sh
set -eu

# A live image should not nag about Debian package updates.
install -d -m 0755 /etc/xdg/autostart /etc/apt/apt.conf.d /etc/systemd/system
for name in gpk-update-icon package-update-indicator update-notifier pk-update-icon; do
    cat > "/etc/xdg/autostart/${name}.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=${name}
Hidden=true
X-GNOME-Autostart-enabled=false
NoDisplay=true
EOF
done
cat > /etc/apt/apt.conf.d/99traceos-no-update <<'EOF'
APT::Periodic::Enable "0";
APT::Periodic::Update-Package-Lists "0";
APT::Periodic::Unattended-Upgrade "0";
EOF
ln -sfn /dev/null /etc/systemd/system/packagekit.service
ln -sfn /dev/null /etc/systemd/system/packagekit-offline-update.service
echo "[TraceOS] live session will not offer Debian software updates."
