#!/bin/sh
set -eu

export PIPX_GLOBAL_HOME=/opt/pipx
export PIPX_GLOBAL_BIN_DIR=/usr/local/bin
export PIPX_GLOBAL_MAN_DIR=/usr/local/share/man

mkdir -p "$PIPX_GLOBAL_HOME" "$PIPX_GLOBAL_BIN_DIR" "$PIPX_GLOBAL_MAN_DIR"

install_tool() {
    package="$1"
    version="$2"
    echo "[TraceOS] Installing OSINT tool: $package==$version"
    pipx install --global "$package==$version"
}

install_tool sherlock-project 0.16.2
install_tool maigret 0.6.6
install_tool h8mail 2.5.6
install_tool holehe 1.61

# PhoneInfoga is distributed as a signed release archive. Pin the release and
# keep the checksum manifest verification in the build for provenance.
# verify the upstream SHA-256 manifest before installing the amd64 binary.
PHONEINFOGA_VERSION="2.11.0"
PHONEINFOGA_ARCHIVE="phoneinfoga_Linux_x86_64.tar.gz"
PHONEINFOGA_BASE="https://github.com/sundowndev/phoneinfoga/releases/download/v${PHONEINFOGA_VERSION}"
PHONEINFOGA_TMP="/tmp/traceos-phoneinfoga"

rm -rf "$PHONEINFOGA_TMP"
mkdir -p "$PHONEINFOGA_TMP"
cd "$PHONEINFOGA_TMP"
curl -fsSL "$PHONEINFOGA_BASE/$PHONEINFOGA_ARCHIVE" -o "$PHONEINFOGA_ARCHIVE"
curl -fsSL "$PHONEINFOGA_BASE/phoneinfoga_checksums.txt" -o phoneinfoga_checksums.txt
grep -F "  $PHONEINFOGA_ARCHIVE" phoneinfoga_checksums.txt > expected.sha256
sha256sum -c expected.sha256

tar -xzf "$PHONEINFOGA_ARCHIVE"
test -x phoneinfoga
install -m 0755 phoneinfoga /usr/local/bin/phoneinfoga
/usr/local/bin/phoneinfoga version
rm -rf "$PHONEINFOGA_TMP"
cd /

# Blackbird is actively maintained but distributed from source rather than
# a released PyPI package. Pin an exact upstream commit and locked deps.
BLACKBIRD_COMMIT="b45505080ef51bb3ef52dc29879ee6bef31e5b94"
BLACKBIRD_DIR="/opt/traceos-blackbird"

echo "[TraceOS] Installing Blackbird at $BLACKBIRD_COMMIT"
rm -rf "$BLACKBIRD_DIR"
git clone https://github.com/antoniaci/blackbird.git "$BLACKBIRD_DIR"
cd "$BLACKBIRD_DIR"
git checkout --detach "$BLACKBIRD_COMMIT"
python3 -m venv "$BLACKBIRD_DIR/venv"
"$BLACKBIRD_DIR/venv/bin/pip" install --no-cache-dir --disable-pip-version-check \
  -r /usr/share/traceos/blackbird-requirements.txt
"$BLACKBIRD_DIR/venv/bin/pip" check

cat > /usr/local/bin/blackbird <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

APP_DIR="/opt/traceos-blackbird"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/traceos-blackbird"

mkdir -p "$STATE_DIR"
ln -sfn "$APP_DIR/assets" "$STATE_DIR/assets"
ln -sfn "$APP_DIR/src" "$STATE_DIR/src"

cd "$STATE_DIR"
exec "$APP_DIR/venv/bin/python" "$APP_DIR/blackbird.py" "$@"
EOF
chmod 0755 /usr/local/bin/blackbird

cat > /usr/share/traceos/osint-tools.txt <<'EOF'
sherlock-project==0.16.2|sherlock|OSINT username discovery
maigret==0.6.6|maigret|OSINT username investigation across thousands of sites
h8mail==2.5.6|h8mail|OSINT email and breach-oriented lookups
holehe==1.61|holehe|OSINT email-account existence checks
phoneinfoga==2.11.0|phoneinfoga|OSINT phone-number reconnaissance and metadata lookup
blackbird@b45505080ef51bb3ef52dc29879ee6bef31e5b94|blackbird|OSINT username/email search across hundreds of platforms
whois|whois|WHOIS registration lookup for domains and IPs
dnsutils|dig|DNS record lookup
EOF

echo "[TraceOS] OSINT tool installation complete."
