#!/bin/sh
set -eu
export PIPX_GLOBAL_HOME=/opt/pipx
export PIPX_GLOBAL_BIN_DIR=/usr/local/bin
export PIPX_GLOBAL_MAN_DIR=/usr/local/share/man
mkdir -p "$PIPX_GLOBAL_HOME" "$PIPX_GLOBAL_BIN_DIR" "$PIPX_GLOBAL_MAN_DIR"
install_pipx_tool() {
    package="$1"; version="$2"
    echo "[TraceOS] Installing DFIR tool: $package==$version"
    pipx install --global "$package==$version"
}
install_pipx_tool volatility3 2.28.2
install_pipx_tool sigma-cli 3.1.0
cat > /usr/share/traceos/dfir-tools.txt <<'EOF'
# TraceOS Block 3: DFIR / Incident Response
# project|version|command|purpose|license|mode|provenance
volatilityfoundation/volatility3|2.28.2|vol|memory forensics and volatile artifact analysis|VSL|local|PyPI volatility3-2.28.2
SigmaHQ/sigma-cli|3.1.0|sigma|Sigma rule validation and conversion|LGPL-2.1-or-later|local|PyPI sigma-cli-3.1.0
debian/suricata|7.0.10-1+deb13u4|suricata|network IDS/IPS and packet inspection|GPL|local|Debian Trixie package
debian/suricata-update|1.3.4-1|suricata-update|Suricata rule-set management|GPL|local|Debian Trixie package
debian/plaso|installed|plaso-log2timeline|forensic super-timeline generation|Apache-2.0|local|Debian Trixie package
EOF
echo "[TraceOS] DFIR / Incident Response installation complete."
