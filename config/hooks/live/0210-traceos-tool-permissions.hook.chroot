#!/bin/sh
set -eu
chmod 0755 /usr/local/bin/traceos-purple
chmod 0755 /usr/local/bin/traceos-osint
chmod 0755 /usr/local/bin/traceos-control
chmod 0755 /usr/local/bin/subfinder
