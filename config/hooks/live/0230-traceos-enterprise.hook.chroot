#!/bin/sh
set -eu

export PIPX_GLOBAL_HOME=/opt/pipx
export PIPX_GLOBAL_BIN_DIR=/usr/local/bin
export PIPX_GLOBAL_MAN_DIR=/usr/local/share/man

mkdir -p "$PIPX_GLOBAL_HOME" "$PIPX_GLOBAL_BIN_DIR" "$PIPX_GLOBAL_MAN_DIR"

install_pipx_tool() {
    package="$1"
    version="$2"
    echo "[TraceOS] Installing enterprise assessment tool: $package==$version"
    pipx install --global "$package==$version"
}

install_netexec_release() {
    commit="c7dc286ba65daf10402cdc470e531b84e6d3d911"
    source_dir="$(mktemp -d /tmp/traceos-netexec.XXXXXX)"
    trap 'rm -rf "$source_dir"' EXIT HUP INT TERM

    echo "[TraceOS] Preparing NetExec v1.5.1 from pinned upstream commit $commit"
    git clone --quiet --depth 1 --branch v1.5.1 \
        https://github.com/Pennyw0rth/NetExec "$source_dir"

    actual_commit="$(git -C "$source_dir" rev-parse HEAD)"
    if [ "$actual_commit" != "$commit" ]; then
        echo "[TraceOS] ERROR: NetExec tag resolved to unexpected commit $actual_commit" >&2
        exit 1
    fi

    # NetExec v1.5.1 declares Certipy as an unpinned Git URL. pip fails to
    # resolve that requirement in this build (certipy-ad is reported as
    # "(unavailable)") even though the compatible pinned PyPI release exists.
    # Substitute only that dependency source, retaining NetExec's security fix
    # and all its other upstream dependency declarations.
    certipy_git_requirement='"certipy-ad @ git+https://github.com/Pennyw0rth/Certipy"'
    if ! grep -Fq "$certipy_git_requirement" "$source_dir/pyproject.toml"; then
        echo "[TraceOS] ERROR: expected NetExec Certipy dependency was not found" >&2
        exit 1
    fi

    sed -i 's|"certipy-ad @ git+https://github.com/Pennyw0rth/Certipy"|"certipy-ad==5.1.0"|' \
        "$source_dir/pyproject.toml"
    if grep -Fq "$certipy_git_requirement" "$source_dir/pyproject.toml"; then
        echo "[TraceOS] ERROR: failed to replace NetExec's Certipy Git dependency" >&2
        exit 1
    fi

    echo "[TraceOS] Using certipy-ad==5.1.0 from PyPI in NetExec's local build metadata"
    pipx install --global "$source_dir"
}

install_pipx_tool impacket 0.13.1
install_netexec_release
install_pipx_tool certipy-ad 5.1.0

cat > /usr/share/traceos/enterprise-assessment-tools.txt <<'EOF'
# TraceOS Block 4: Enterprise / Active Directory / Internal Assessment
# project|version|command|purpose|license|mode|provenance
fortra/impacket|0.13.1|impacket-*|SMB/RPC/LDAP/Kerberos protocol assessment and enumeration|Impacket modified Apache 1.1|authorized|PyPI impacket-0.13.1
Pennyw0rth/NetExec|1.5.1|nxc|authorized SMB/LDAP/WinRM/MSSQL/SSH enumeration and assessment|BSD-3-Clause|authorized|GitHub commit c7dc286ba65daf10402cdc470e531b84e6d3d911 (v1.5.1)
ly4k/Certipy|5.1.0|certipy|AD CS discovery and certificate-service assessment|MIT|authorized|PyPI certipy-ad-5.1.0
debian/openldap|installed|ldapsearch|LDAP directory querying and inspection|OpenLDAP license|authorized|Debian Trixie package
debian/samba-client|installed|smbclient|SMB share and protocol inspection|GPL|authorized|Debian Trixie package
debian/samba-common-bin|installed|rpcclient|MS-RPC enumeration|GPL|authorized|Debian Trixie package
debian/krb5-user|installed|kinit|Kerberos authentication diagnostics|MIT|authorized|Debian Trixie package
debian/krb5-user|installed|kvno|Kerberos service-ticket diagnostics|MIT|authorized|Debian Trixie package
EOF

echo "[TraceOS] Enterprise / Active Directory assessment installation complete."
