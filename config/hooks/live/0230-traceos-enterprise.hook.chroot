#!/bin/sh
set -eu

export PIPX_GLOBAL_HOME=/opt/pipx
export PIPX_GLOBAL_BIN_DIR=/usr/local/bin
export PIPX_GLOBAL_MAN_DIR=/usr/local/share/man

mkdir -p "$PIPX_GLOBAL_HOME" "$PIPX_GLOBAL_BIN_DIR" "$PIPX_GLOBAL_MAN_DIR"

install_pipx_tool() {
    package="$1"
    version="$2"
    echo "[TraceOS] Installing enterprise assessment tool: $package==$version"
    pipx install --global "$package==$version"
}

install_netexec_release() {
    # This upstream commit replaces the renamed Certipy Git dependency with
    # certipy-nxc==5.1.0.post1, whose metadata is compatible with Python 3.13.
    # Pin the full commit SHA so the build does not depend on a moving tag.
    commit="0602ef43676bff614369037d966c42dcaeace5b1"
    source_dir="$(mktemp -d /tmp/traceos-netexec.XXXXXX)"
    trap 'rm -rf "$source_dir"' EXIT HUP INT TERM

    echo "[TraceOS] Preparing NetExec from pinned upstream commit $commit"
    git clone --quiet https://github.com/Pennyw0rth/NetExec "$source_dir"
    git -C "$source_dir" checkout --quiet --detach "$commit"

    actual_commit="$(git -C "$source_dir" rev-parse HEAD)"
    if [ "$actual_commit" != "$commit" ]; then
        echo "[TraceOS] ERROR: NetExec checkout resolved to unexpected commit $actual_commit" >&2
        exit 1
    fi

    if ! grep -Fq '"certipy-nxc>=5.1.0.post1"' "$source_dir/pyproject.toml"; then
        echo "[TraceOS] ERROR: pinned NetExec metadata does not declare certipy-nxc>=5.1.0.post1" >&2
        exit 1
    fi
    if grep -Fq 'certipy-ad @ git+https://github.com/Pennyw0rth/Certipy' "$source_dir/pyproject.toml"; then
        echo "[TraceOS] ERROR: pinned NetExec metadata still declares the obsolete Certipy Git dependency" >&2
        exit 1
    fi

    echo "[TraceOS] Installing NetExec with its upstream certipy-nxc dependency metadata"
    pipx install --global "$source_dir"
}

install_pipx_tool impacket 0.13.1
install_netexec_release
# certipy-nxc is a library dependency and intentionally has no pipx app entry point.
# NetExec's pinned environment already contains it; expose its upstream CLI entry
# point through a small wrapper instead of asking pipx to install a library as an app.
NETEXEC_PYTHON="$PIPX_GLOBAL_HOME/venvs/netexec/bin/python"
if [ ! -x "$NETEXEC_PYTHON" ]; then
    echo "[TraceOS] ERROR: NetExec virtualenv Python not found at $NETEXEC_PYTHON" >&2
    exit 1
fi

cat > "$PIPX_GLOBAL_BIN_DIR/certipy" <<EOF
#!/bin/sh
set -eu
python="$NETEXEC_PYTHON"
if [ ! -x "\$python" ]; then
    echo "[TraceOS] ERROR: Certipy runtime is missing: \$python" >&2
    exit 127
fi
exec "\$python" -c 'import sys; sys.argv[0] = "certipy"; from certipy.entry import main; main()' "\$@"
EOF
chmod 0755 "$PIPX_GLOBAL_BIN_DIR/certipy"

echo "[TraceOS] Validating Certipy CLI from NetExec's dependency environment"
"$PIPX_GLOBAL_BIN_DIR/certipy" --version

cat > /usr/share/traceos/enterprise-assessment-tools.txt <<'EOF'
# TraceOS Block 4: Enterprise / Active Directory / Internal Assessment
# project|version|command|purpose|license|mode|provenance
fortra/impacket|0.13.1|impacket-*|SMB/RPC/LDAP/Kerberos protocol assessment and enumeration|Impacket modified Apache 1.1|authorized|PyPI impacket-0.13.1
Pennyw0rth/NetExec|1.5.1+0602ef43676b|nxc|authorized SMB/LDAP/WinRM/MSSQL/SSH enumeration and assessment|BSD-2-Clause|authorized|GitHub commit 0602ef43676bff614369037d966c42dcaeace5b1
Pennyw0rth/Certipy|5.1.0.post1|certipy|AD CS discovery and certificate-service assessment|MIT|authorized|PyPI certipy-nxc-5.1.0.post1 in pinned NetExec venv; TraceOS certipy CLI wrapper uses certipy.entry
debian/openldap|installed|ldapsearch|LDAP directory querying and inspection|OpenLDAP license|authorized|Debian Trixie package
debian/samba-client|installed|smbclient|SMB share and protocol inspection|GPL|authorized|Debian Trixie package
debian/samba-common-bin|installed|rpcclient|MS-RPC enumeration|GPL|authorized|Debian Trixie package
debian/krb5-user|installed|kinit|Kerberos authentication diagnostics|MIT|authorized|Debian Trixie package
debian/krb5-user|installed|kvno|Kerberos service-ticket diagnostics|MIT|authorized|Debian Trixie package
EOF

echo "[TraceOS] Enterprise / Active Directory assessment installation complete."
